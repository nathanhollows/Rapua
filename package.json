{
  "name": "Rapua",
  "version": "1.0.0",
  "description": " A simple to use QR code based navigation utility built for educators ",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:site && npm run build:admin",
    "build:site": "npx @tailwindcss/cli -i ./static/css/src/site.css -o static/css/tailwind.css --minify",
    "build:admin": "npx @tailwindcss/cli -i ./static/css/src/admin.css -o static/css/admin.css --minify",
    "watch": "sh -c 'trap \"kill 0\" EXIT; npm run watch:site & npm run watch:admin & wait'",
    "watch:site": "npx @tailwindcss/cli -i ./static/css/src/site.css -o static/css/tailwind.css --watch",
    "watch:admin": "npx @tailwindcss/cli -i ./static/css/src/admin.css -o static/css/admin.css --watch"
  },
  "github": "nathanhollows/Rapua",
  "author": "Nathan Hollows",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "commitizen": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.20",
    "daisyui": "^5.8.2",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^4.3.3"
  }
}
