package blocks

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ alertPlayer(_ models.QuestSettings, block blocks.AlertBlock) {
	if block.Content != "" {
		<div
			role="alert"
			class={ fmt.Sprintf("alert alert-%s", block.Style) }
		>
			<span class="qb-ai">
				@icon(alertIconName(block.Style), templ.Attributes{})
			</span>
			<span>
				@templ.Raw(stringToMarkdown(block.Content))
			</span>
		</div>
	}
}

// alertIconName is the icon that goes with a callout's tone.
func alertIconName(style string) string {
	switch style {
	case "success":
		return "circle-check"
	case "warning":
		return "triangle-alert"
	case "error":
		return "circle-x"
	}
	return "info"
}

var alertTextarea = TextareaParams{
	Name:        "content",
	Title:       "Alert content",
	Placeholder: "**Alert title!** Alert content.",
	Markdown:    true,
	Required:    true,
	MinLines:    2,
}

templ alertAdmin(_ models.QuestSettings, block blocks.AlertBlock) {
	<form
		id={ fmt.Sprintf("form-%s", block.ID) }
		hx-put={ fmt.Sprint("/admin/blocks/", block.ID) }
		hx-trigger={ fmt.Sprintf("keyup from:#form-%s delay:500ms, change from:#form-%s delay:100ms", block.ID, block.ID) }
		hx-swap="none"
	>
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Style</legend>
			<select
				id={ fmt.Sprintf("style-%s", block.ID) }
				name="style"
				class="select w-full max-w-xs"
			>
				for variant, label := range block.GetStyles() {
					<option
						value={ variant }
						if block.Style == variant {
							selected
						}
					>{ label }</option>
				}
			</select>
		</fieldset>
		@TextareaField(alertTextarea.SetValue(block.Content))
	</form>
}
