package blocks

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ pincodePlayer(settings models.QuestSettings, block blocks.PincodeBlock, data blocks.PlayerState) {
	@pincodeCard(settings, block, data, false)
}

// pincodePlayerUpdate answers a guess: the card is replaced, and a wrong one shakes.
templ pincodePlayerUpdate(settings models.QuestSettings, block blocks.PincodeBlock, data blocks.PlayerState) {
	@pincodeCard(settings, block, data, true)
}

// pincodePerRow is how many boxes share a row. Past six they wrap to two rows, so
// each stays big enough to tap.
func pincodePerRow(digits int) int {
	const oneRow = 6
	if digits <= oneRow {
		return digits
	}
	return (digits + 1) / 2
}

templ pincodeCard(settings models.QuestSettings, block blocks.PincodeBlock, data blocks.PlayerState, update bool) {
	{{ answered := update && !data.IsComplete() }}
	<div
		id={ fmt.Sprintf("player-block-%s", block.ID) }
		class={ "qb-card", templ.KV("is-fresh", update), templ.KV("is-wrong", answered) }
		if update {
			hx-swap-oob="true"
		}
	>
		@qbTop("grip", "Pincode", settings, block.GetPoints(), data)
		<div class="qb-q">
			@templ.Raw(stringToMarkdown(block.Prompt))
		</div>
		if data.IsComplete() {
			<div class="qb-digits ok" style={ templ.SafeCSS(fmt.Sprintf("--per:%d", pincodePerRow(len(block.Pincode)))) }>
				for i := range block.Pincode {
					<input
						type="text"
						class="qb-digit"
						aria-label={ fmt.Sprintf("Digit %d", i+1) }
						value={ string(block.Pincode[i]) }
						disabled
					/>
				}
			</div>
			if block.UnlockedContent != "" {
				<div class="q-unlocked prose" role="status">
					@templ.Raw(stringToMarkdown(block.UnlockedContent))
				</div>
			}
		} else {
			<form class="qb-form" hx-post="/blocks/validate" hx-swap="none">
				<input type="hidden" name="block" value={ block.ID }/>
				<p class="qb-hint">Numbers only.</p>
				if answered {
					<p class="qb-msg no" role="status">
						@icon("circle-x", templ.Attributes{"aria-hidden": "true"})
						<span>That is not the right code. Check the digits and try again.</span>
					</p>
				}
				<div class="qb-digits" style={ templ.SafeCSS(fmt.Sprintf("--per:%d", pincodePerRow(len(block.Pincode)))) }>
					for i := range block.Pincode {
						<input
							type="text"
							name="pincode"
							class="qb-digit"
							inputmode="numeric"
							pattern="[0-9]"
							maxlength="1"
							autocomplete="off"
							aria-label={ fmt.Sprintf("Digit %d", i+1) }
							required
						/>
					}
				</div>
				<button type="submit" class="btn btn-primary qb-go" disabled>
					<span class="qb-idle">Enter all { fmt.Sprint(len(block.Pincode)) } digits</span>
					<span class="qb-ready">
						Check
						@icon("check", templ.Attributes{"aria-hidden": "true"})
					</span>
				</button>
			</form>
		}
	</div>
	<script>
	(function () {
		if (window.__qbPins) return;
		window.__qbPins = true;
		function boxes(el) { return Array.prototype.slice.call(el.closest('form').querySelectorAll('input.qb-digit')); }
		function sync(el) {
			var form = el.closest('form'), go = form.querySelector('button[type=submit]');
			if (go) go.disabled = boxes(el).some(function (b) { return b.value === ''; });
		}
		document.addEventListener('input', function (e) {
			var box = e.target;
			if (!box.classList || !box.classList.contains('qb-digit')) return;
			box.value = box.value.replace(/\D/g, '').slice(-1);
			var all = boxes(box), i = all.indexOf(box);
			if (box.value && all[i + 1]) all[i + 1].focus();
			sync(box);
		});
		document.addEventListener('keydown', function (e) {
			var box = e.target;
			if (!box.classList || !box.classList.contains('qb-digit')) return;
			var all = boxes(box), i = all.indexOf(box);
			if (e.key === 'Backspace' && box.value === '' && all[i - 1]) { all[i - 1].value = ''; all[i - 1].focus(); sync(box); e.preventDefault(); }
			if (e.key === 'ArrowLeft' && all[i - 1]) { all[i - 1].focus(); e.preventDefault(); }
			if (e.key === 'ArrowRight' && all[i + 1]) { all[i + 1].focus(); e.preventDefault(); }
		});
		document.addEventListener('paste', function (e) {
			var box = e.target;
			if (!box.classList || !box.classList.contains('qb-digit')) return;
			var text = ((e.clipboardData || window.clipboardData).getData('text') || '').replace(/\D/g, '');
			if (!text) return;
			e.preventDefault();
			var all = boxes(box);
			all.forEach(function (b, j) { b.value = text.charAt(j); });
			all[Math.min(text.length, all.length - 1)].focus();
			sync(box);
		});
	})();
	</script>
}

var pincodeTextarea = TextareaParams{
	Name:        "prompt",
	Title:       "Prompt",
	Placeholder: "How many chickens are there in the world?",
	Markdown:    true,
}

var pincodeUnlockedContentTextarea = TextareaParams{
	Name:        "unlocked_content",
	Title:       "Unlocked Content",
	Placeholder: "Aye, you got it! Here's your next clue: ...",
	Markdown:    true,
	Required:    false,
	MinLines: 2,
	HelpText:    "This content will be shown to the player when they answer correctly.",
}

templ pincodeAdmin(settings models.QuestSettings, block blocks.PincodeBlock) {
	<form
		id={ fmt.Sprintf("form-%s", block.ID) }
		hx-put={ fmt.Sprint("/admin/blocks/", block.ID) }
		hx-trigger={ fmt.Sprintf("keyup from:#form-%s delay:500ms, change from:#form-%s delay:100ms", block.ID, block.ID) }
		hx-swap="none"
	>
		@TextareaField(pincodeTextarea.SetValue(block.Prompt))
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Pincode</legend>
			<input
				id={ fmt.Sprintf("admin-pincode-name-%s", block.ID) }
				name="pincode"
				type="number"
				class="input font-mono tracking-widest max-w-sm validator"
				placeholder="12345"
				value={ block.Pincode }
				required
			/>
		</fieldset>
		@TextareaField(pincodeUnlockedContentTextarea.SetValue(block.UnlockedContent))
	</form>
}
