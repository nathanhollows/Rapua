package blocks

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)

// checklistTicked is how many items the player has ticked.
func checklistTicked(block blocks.ChecklistBlock, data blocks.PlayerState) int {
	n := 0
	for _, item := range block.List {
		if item.IsChecked(data.GetPlayerData()) {
			n++
		}
	}
	return n
}

templ checklistPlayer(settings models.QuestSettings, block blocks.ChecklistBlock, data blocks.PlayerState) {
	@checklistCard(settings, block, data, false)
}

// checklistPlayerUpdate answers a tick. The card pops only when the last one
// completes it.
templ checklistPlayerUpdate(settings models.QuestSettings, block blocks.ChecklistBlock, data blocks.PlayerState) {
	@checklistCard(settings, block, data, true)
}

templ checklistCard(settings models.QuestSettings, block blocks.ChecklistBlock, data blocks.PlayerState, fresh bool) {
	{{ done := data.IsComplete() }}
	<div
		id={ fmt.Sprintf("player-block-%s", block.ID) }
		class={ "qb-card", templ.KV("is-fresh", fresh) }
	>
		@qbTop("list-checks", "To do", settings, block.GetPoints(), data)
		if block.Content != "" {
			<div class="qb-q">
				@templ.Raw(stringToMarkdown(block.Content))
			</div>
		}
		<p class="qb-hint">
			if done {
				All done.
			} else {
				{ fmt.Sprint(checklistTicked(block, data)) } of { fmt.Sprint(len(block.List)) } done. Tick each one as you go.
			}
		</p>
		<form
			class="qb-form"
			hx-post="/blocks/validate"
			hx-target={ fmt.Sprintf("#player-block-%s", block.ID) }
			hx-swap="outerHTML"
			hx-trigger="change"
		>
			<input type="hidden" name="block" value={ block.ID }/>
			<div class="qb-opts checklist">
				for _, item := range block.List {
					<label class={ "qb-opt", "box", "is-done", templ.KV("locked", done) }>
						<span class="qb-mark">
							<input
								id={ fmt.Sprintf("checklist-%s-%s", block.ID, item.ID) }
								name="checklist-item-ids"
								type="checkbox"
								value={ item.ID }
								autoComplete="off"
								disabled?={ done }
								checked?={ done || item.IsChecked(data.GetPlayerData()) }
							/>
							@icon("check", templ.Attributes{"aria-hidden": "true"})
						</span>
						<div class="qb-t">
							@templ.Raw(stringToMarkdown(item.Description))
						</div>
					</label>
				}
			</div>
		</form>
	</div>
}

var checklistInstructionsTextarea = TextareaParams{
	Name:        "content",
	Title:       "Instructions",
	Placeholder: "Brief instructions for the checklist.",
	Markdown:    true,
	Required:    true,
}

func checklistRows(blockID string) RowsParams {
	return RowsParams{
		ID:       "checklist-items-" + blockID,
		Cols:     textRowCols,
		Heads:    []string{"Items"},
		Min:      2,
		AddLabel: "Add an item",
	}
}

templ checklistAdmin(settings models.QuestSettings, block blocks.ChecklistBlock) {
	<form
		id={ fmt.Sprintf("form-%s", block.ID) }
		hx-put={ fmt.Sprint("/admin/blocks/", block.ID) }
		hx-trigger={ fmt.Sprintf("keyup from:#form-%s delay:500ms, change from:#form-%s delay:100ms", block.ID, block.ID) }
		hx-swap="none"
	>
		@TextareaField(checklistInstructionsTextarea.SetValue(block.Content))
		<fieldset class="fieldset">
			<legend class="fieldset-legend">
				@markdownBadge()
				Checklist items
			</legend>
			@adminRows(checklistRows(block.ID), nil) {
				for _, item := range block.List {
					@checklistItem(item)
				}
				for i := 0; i < (2 - len(block.List)); i++ {
					@checklistItem(blocks.ChecklistItem{})
				}
			}
		</fieldset>
	</form>
	<template id={ checklistRows(block.ID).TemplateID() }>
		@checklistItem(blocks.ChecklistItem{})
	</template>
}

templ checklistItem(item blocks.ChecklistItem) {
	@rowText("checklist-items", "checklist-item-ids", item.ID, item.Description, "Checklist item description...", "item")
}
