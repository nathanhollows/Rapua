package blocks

import (
	"encoding/json"
	"fmt"
	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ ratingPlayer(settings models.QuestSettings, block blocks.RatingBlock, data blocks.PlayerState) {
	@ratingCard(settings, block, data, false)
}

templ ratingPlayerUpdate(settings models.QuestSettings, block blocks.RatingBlock, data blocks.PlayerState) {
	@ratingCard(settings, block, data, true)
}

// ratingStarsGiven is the rating a finished player left, or zero.
func ratingStarsGiven(data blocks.PlayerState) int {
	var saved struct {
		Rating int `json:"rating"`
	}
	if raw := data.GetPlayerData(); raw != nil {
		_ = json.Unmarshal(raw, &saved)
	}
	return saved.Rating
}

// ratingCard is big stars, and a button that names what is missing until one is chosen.
templ ratingCard(settings models.QuestSettings, block blocks.RatingBlock, data blocks.PlayerState, update bool) {
	<div
		id={ fmt.Sprintf("player-block-%s", block.ID) }
		class={ "qb-card", templ.KV("is-fresh", update) }
		if update {
			hx-swap-oob="true"
		}
	>
		@qbTop("star", "Rating", settings, block.GetPoints(), data)
		<div class="qb-q">
			@templ.Raw(stringToMarkdown(block.Prompt))
		</div>
		if data.IsComplete() {
			<div class="qb-stars locked" role="img" aria-label={ fmt.Sprintf("You gave %d out of %d stars", ratingStarsGiven(data), blocks.RatingStars) }>
				for i := 1; i <= blocks.RatingStars; i++ {
					<span class={ "qb-star", templ.KV("on", i <= ratingStarsGiven(data)) }>
						@icon("star", templ.Attributes{"aria-hidden": "true"})
					</span>
				}
			</div>
			<p class="qb-hint">Thanks for rating.</p>
		} else {
			<form
				class="qb-form"
				hx-post="/blocks/validate"
				hx-target={ fmt.Sprintf("#player-block-%s", block.ID) }
			>
				<input type="hidden" name="block" value={ block.ID }/>
				<div class="qb-stars" role="radiogroup" aria-label="Rating">
					for i := 1; i <= blocks.RatingStars; i++ {
						<span class="qb-star">
							<input type="radio" name="rating" value={ fmt.Sprint(i) } aria-label={ fmt.Sprintf("%d star", i) }/>
							@icon("star", templ.Attributes{"aria-hidden": "true"})
						</span>
					}
				</div>
				<button
					type="submit"
					class="btn btn-primary qb-go"
					disabled
					_="
						on change from (closest <form />).querySelectorAll('input[name=rating]')
							set my.disabled to ((closest <form />).querySelector('input[name=rating]:checked') is null)
						end
					"
				>
					<span class="qb-idle">Pick a star rating</span>
					<span class="qb-ready">
						Send rating
						@icon("send-horizontal", templ.Attributes{"aria-hidden": "true"})
					</span>
				</button>
			</form>
		}
	</div>
}


var ratingPromptTextarea = TextareaParams{
	Name:        "prompt",
	Title:       "Prompt",
	Placeholder: "How would you rate this experience?",
	Markdown:    true,
	Required:    true,
	HelpText:    "The question or prompt for the rating.",
}

templ ratingAdmin(settings models.QuestSettings, block blocks.RatingBlock) {
	<form
		id={ fmt.Sprintf("form-%s", block.ID) }
		hx-put={ fmt.Sprint("/admin/blocks/", block.ID) }
		hx-trigger={ fmt.Sprintf("keyup from:(#form-%s textarea, #form-%s input) delay:1000ms", block.ID, block.ID) }
		hx-swap="none"
	>
		@TextareaField(ratingPromptTextarea.SetValue(block.Prompt))
	</form>
}
