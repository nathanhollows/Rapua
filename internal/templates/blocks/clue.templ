package blocks

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ cluePlayer(settings models.QuestSettings, block blocks.ClueBlock, data blocks.PlayerState) {
	@clueCard(settings, block, data, false)
}

templ cluePlayerUpdate(settings models.QuestSettings, block blocks.ClueBlock, data blocks.PlayerState) {
	@clueCard(settings, block, data, true)
}

// clueCard asks twice before it spends anything, and lights its bulb once the clue is out.
templ clueCard(settings models.QuestSettings, block blocks.ClueBlock, data blocks.PlayerState, update bool) {
	<div
		id={ fmt.Sprintf("player-block-%s", block.ID) }
		class={ "qb-card", templ.KV("is-fresh", update), templ.KV("is-lit", data.IsComplete()) }
		if update {
			hx-swap-oob="true"
		}
	>
		@qbTop("lightbulb", "Clue", settings, block.GetPoints(), data)
		if data.IsComplete() {
			<div class="q-unlocked prose" role="status">
				@templ.Raw(stringToMarkdown(block.ClueText))
			</div>
		} else {
			if block.DescriptionText != "" {
				<div class="qb-q">
					@templ.Raw(stringToMarkdown(block.DescriptionText))
				</div>
			}
			if settings.EnablePoints && block.GetPoints() < 0 {
				<p class="qb-hint">Revealing it takes { fmt.Sprint(-block.GetPoints()) } points.</p>
			}
			<form hx-post="/blocks/validate" hx-target={ fmt.Sprintf("#player-block-%s", block.ID) }>
				<input type="hidden" name="block" value={ block.ID }/>
				<input type="hidden" name="reveal_clue" value="true"/>
				<button
					type="button"
					class="btn btn-warning qb-go"
					_="on click
						if my @type == 'button' then
							halt the event
							set :text to my innerHTML
							set my innerHTML to 'Are you sure? Tap again'
							add .qb-confirm to me
							set my @type to 'submit'
							wait 3000ms
							then set my innerHTML to :text
							then remove .qb-confirm from me
							then set my @type to 'button'
						end
					end"
				>
					@icon("lightbulb", templ.Attributes{"aria-hidden": "true"})
					if block.ButtonLabel != "" {
						{ block.ButtonLabel }
					} else {
						Reveal the clue
					}
				</button>
			</form>
		}
	</div>
}

var clueTextarea = TextareaParams{
	Name:        "description",
	Title:       "Description Text",
	Placeholder: "Text shown before the clue is revealed",
	Markdown:    true,
	Required:    true,
}

var clueRevealTextarea = TextareaParams{
	Name:        "clue",
	Title:       "Revealed Clue Text",
	Placeholder: "The actual clue content that will be revealed",
	Markdown:    true,
	Required:    true,
	MinLines:    5,
}

var clueButtonTextInput = TextInputParams{
	Name:         "button_label",
	Title:        "Button Label",
	Placeholder:  "Label for the button to reveal the clue",
	ExtraClasses: "w-full",
	Required:     false,
	HyperScript:  "",
}

templ clueAdmin(settings models.QuestSettings, block blocks.ClueBlock) {
	<form
		id={ fmt.Sprintf("form-%s", block.ID) }
		hx-put={ fmt.Sprint("/admin/blocks/", block.ID) }
		hx-trigger={ fmt.Sprintf("keyup from:(#form-%s textarea) delay:500ms, keyup from:(#form-%s input) delay:500ms", block.ID, block.ID) }
		hx-swap="none"
	>
		@TextareaField(clueTextarea.SetValue(block.DescriptionText))
		@TextareaField(clueRevealTextarea.SetValue(block.ClueText))
		@TextInputField(clueButtonTextInput.SetValue(block.ButtonLabel))
	</form>
}
