package blocks

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ toggleTextPlayer(_ models.QuestSettings, block blocks.ToggleTextBlock) {
	if block.Title != "" || block.Content != "" {
		<details class="qb-reveal">
			<summary>
				<span class="qb-chev">
					@icon("chevron-down", templ.Attributes{})
				</span>
				<span class="qb-reveal-t">
					if block.Title != "" {
						{ block.Title }
						<small>Tap to read</small>
					} else {
						Tap to read
					}
				</span>
			</summary>
			<div class="qb-reveal-body prose">
				@templ.Raw(stringToMarkdown(block.Content))
			</div>
		</details>
	}
}

var toggleTextContentTextarea = TextareaParams{
	Name:         "content",
	Title:        "Content",
	Placeholder:  "Markdown content here",
	Markdown:     true,
	ExtraClasses: "w-full min-h-40",
	Required:     true,
}

templ toggleTextAdmin(_ models.QuestSettings, block blocks.ToggleTextBlock) {
	<form
		id={ fmt.Sprintf("form-%s", block.ID) }
		hx-put={ fmt.Sprint("/admin/blocks/", block.ID) }
		hx-trigger={ fmt.Sprintf("keyup from:#form-%s delay:500ms, change from:#form-%s delay:100ms", block.ID, block.ID) }
		hx-swap="none"
	>
		<div class="flex flex-col sm:flex-row sm:items-end gap-x-2">
			<fieldset class="fieldset flex-1">
				<legend class="fieldset-legend">Title</legend>
				<input
					type="text"
					name="title"
					class="input w-full"
					placeholder="e.g. References, Hint, Background"
					value={ block.Title }
					required
				/>
			</fieldset>
		</div>
		@TextareaField(toggleTextContentTextarea.SetValue(block.Content))
	</form>
}
