func RenderAdminEdit(settings models.QuestSettings, block blocks.Block) templ.Component {
	switch block.GetType() {
	case "text":
		b := block.(*blocks.MarkdownBlock)
		return markdownAdmin(settings, *b)
	case "divider":
		b := block.(*blocks.DividerBlock)
		return dividerAdmin(settings, *b)
	case "image":
		b := block.(*blocks.ImageBlock)
		return imageAdmin(settings, *b)
	case "password":
		b := block.(*blocks.PasswordBlock)
		return passwordAdmin(settings, *b)
	case "scan":
		b := block.(*blocks.ScanBlock)
		return scanAdmin(settings, *b)
	case "geofence":
		b := block.(*blocks.GeofenceBlock)
		return geofenceAdmin(settings, *b)
	case "pincode":
		b := block.(*blocks.PincodeBlock)
		return pincodeAdmin(settings, *b)
	case "checklist":
		b := block.(*blocks.ChecklistBlock)
		return checklistAdmin(settings, *b)
	case "youtube":
		b := block.(*blocks.YoutubeBlock)
		return youtubeAdmin(settings, *b)
	case "alert":
		b := block.(*blocks.AlertBlock)
		return alertAdmin(settings, *b)
	case "sorting":
		b := block.(*blocks.SortingBlock)
		return sortingAdmin(settings, *b)
	case "quiz":
		b := block.(*blocks.QuizBlock)
		return quizAdmin(settings, *b)
	case "clue":
		b := block.(*blocks.ClueBlock)
		return clueAdmin(settings, *b)
	case "free_text":
		b := block.(*blocks.FreeTextBlock)
		return freeTextAdmin(settings, *b)
	case "photo":
		b := block.(*blocks.PhotoBlock)
		return photoAdmin(settings, *b)
	case "button":
		b := block.(*blocks.ButtonBlock)
		return buttonAdmin(settings, *b)
	case "random_text":
		b := block.(*blocks.RandomTextBlock)
		return randomTextAdmin(settings, *b)
	case "header":
		b := block.(*blocks.HeaderBlock)
		return headerAdmin(settings, *b)
	case "team_name":
		b := block.(*blocks.TeamNameChangerBlock)
		return teamNameChangerAdmin(settings, *b)
	case "game_status":
		b := block.(*blocks.GameStatusAlertBlock)
		return gameStatusAlertAdmin(settings, *b)
	case "start_button":
		b := block.(*blocks.StartGameButtonBlock)
		return startGameButtonAdmin(settings, *b)
	case "rating":
		b := block.(*blocks.RatingBlock)
		return ratingAdmin(settings, *b)
	case "toggle_text":
		b := block.(*blocks.ToggleTextBlock)
		return toggleTextAdmin(settings, *b)
	case "map":
		b := block.(*blocks.MapBlock)
		return mapAdmin(settings, *b)
	case "choice":
		b := block.(*blocks.ChoiceBlock)
		return choiceAdmin(settings, *b)
	}
	return nil
}

