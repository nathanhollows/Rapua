package blocks

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v7/blocks"
	"github.com/nathanhollows/Rapua/v7/models"
)

templ choicePlayer(settings models.InstanceSettings, block blocks.ChoiceBlock, state blocks.PlayerState) {
	<div
		id={ fmt.Sprintf("player-block-%s", block.ID) }
		class="indicator w-full"
	>
		@pointsBadge(settings.EnablePoints, block.GetPoints())
		@completionBadge(state)
		<div class="card prose p-5 bg-base-200 shadow-lg w-full">
			if block.Prompt != "" {
				@templ.Raw(stringToMarkdown(block.Prompt))
			}
			if state.IsComplete() {
				<div class="not-prose flex flex-col gap-1 mt-2">
					for _, label := range block.GetChosenLabels(state) {
						<div class="flex items-center gap-2">
							@icon("check-circle", templ.Attributes{"class": "w-5 h-5 text-success shrink-0"})
							<span class="font-medium">{ label }</span>
						</div>
					}
				</div>
			} else {
				<form
					hx-post="/blocks/validate"
					hx-target={ fmt.Sprintf("#player-block-%s", block.ID) }
					class="not-prose"
				>
					<input type="hidden" name="block" value={ block.ID }/>
					<div class="flex flex-col gap-2 mt-2">
						for _, opt := range block.Options {
							<label class="flex items-center gap-3 cursor-pointer p-3 rounded-lg border border-base-300 hover:bg-base-300 transition-colors has-checked:border-primary has-checked:bg-primary/10">
								if block.MultiSelect {
									<input
										type="checkbox"
										name="choice"
										value={ opt.Sets }
										class="checkbox checkbox-primary checkbox-sm"
									/>
								} else {
									<input
										type="radio"
										name="choice"
										value={ opt.Sets }
										class="radio radio-primary radio-sm"
										required
									/>
								}
								<span>{ opt.Label }</span>
							</label>
						}
					</div>
					<div class="w-full flex justify-center mt-4">
						<button type="submit" class="btn btn-primary">
							{ block.GetButtonText() }
							@icon("check", templ.Attributes{"class": "w-5 h-5"})
						</button>
					</div>
				</form>
			}
		</div>
	</div>
}

templ choicePlayerUpdate(settings models.InstanceSettings, block blocks.ChoiceBlock, state blocks.PlayerState) {
	<div
		id={ fmt.Sprintf("player-block-%s", block.ID) }
		class="indicator w-full"
		hx-swap-oob="true"
	>
		@pointsBadge(settings.EnablePoints, block.GetPoints())
		@completionBadge(state)
		<div class="card prose p-5 bg-base-200 shadow-lg w-full">
			if block.Prompt != "" {
				@templ.Raw(stringToMarkdown(block.Prompt))
			}
			<div class="not-prose flex flex-col gap-1 mt-2">
				for _, label := range block.GetChosenLabels(state) {
					<div class="flex items-center gap-2">
						@icon("check-circle", templ.Attributes{"class": "w-5 h-5 text-success shrink-0"})
						<span class="font-medium">{ label }</span>
					</div>
				}
			</div>
		</div>
	</div>
}

templ choiceAdmin(settings models.InstanceSettings, block blocks.ChoiceBlock) {
	<form
		id={ fmt.Sprintf("form-%s", block.ID) }
		hx-put={ fmt.Sprint("/admin/blocks/", block.ID) }
		hx-trigger={ fmt.Sprintf("keyup from:#form-%s delay:500ms, change from:#form-%s delay:100ms", block.ID, block.ID) }
		hx-swap="none"
	>
		if settings.EnablePoints {
			@adminPointsField(block.GetPoints())
		}
		@TextareaField(TextareaParams{
			Name:        "prompt",
			Title:       "Prompt",
			Placeholder: "Which path will you take?",
			HelpText:    "Question or instruction shown above the choices.",
			Markdown:    true,
		}.SetValue(block.Prompt))
		@TextInputField(TextInputParams{
			Name:         "button_text",
			Title:        "Button Text",
			Placeholder:  "Confirm choice",
			HelpText:     "Label shown on the submit button.",
			ExtraClasses: "w-full",
		}.SetValue(block.ButtonText))
		<fieldset class="fieldset">
			<div class="w-full">
				<div class="grid grid-cols-[1fr_9rem_5.5rem] bg-base-200/60 border-b border-base-300 font-semibold text-base-content">
					<span class="px-4 py-2">Label</span>
					<span class="px-4 py-2">Variable</span>
					<span class="px-4 py-2"></span>
				</div>
				<div
					id={ fmt.Sprintf("choice-options-%s", block.ID) }
					class="divide-y divide-base-300 [&>div:first-child>input:first-of-type]:rounded-tl-lg [&>div:first-child>input:last-of-type]:rounded-tr-lg [&>div:last-child>input:first-of-type]:rounded-bl-lg [&>div:last-child>input:last-of-type]:rounded-br-lg"
				>
					for _, opt := range block.Options {
						@choiceOptionItem(opt)
					}
					for i := 0; i < (2 - len(block.Options)); i++ {
						@choiceOptionItem(blocks.ChoiceOption{})
					}
				</div>
			</div>
			<p class="fieldset-label">Each option sets a variable when chosen. Variable names must be lowercase with underscores.</p>
			<div class="flex">
				<fieldset class="fieldset flex-1 content-center">
					<label
						class="label text-base-content"
						for="multiselect"
					>
						<input
							id="multiselect"
							type="checkbox"
							name="multi_select"
							class="toggle"
							checked?={ block.MultiSelect }
						/>
						Allow multiple selections
					</label>
				</fieldset>
				<button class="btn btn-outline btn-xs" type="button" data-target={ fmt.Sprintf("choice-options-%s", block.ID) } onclick="addChoiceOption(event)">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus w-4 h-4"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
					Add Option
				</button>
			</div>
		</fieldset>
	</form>
	<script>
		function addChoiceOption(event) {
			event.preventDefault();
			const btn = event.target.closest('button');
			const container = document.getElementById(btn.dataset.target);
			const item = document.createElement('div');
			item.classList.add('choice-option-item', 'grid', 'grid-cols-[1fr_9rem_5.5rem]', 'hover:bg-base-200/30', 'transition-colors');
			item.innerHTML =
				'<input type="text" name="option_label" placeholder="Option label" class="input input-sm rounded-none h-10 w-full" autocomplete="off" />' +
				'<input type="text" name="option_sets" placeholder="var_name" pattern="[a-z_]+" class="input input-sm font-mono rounded-none h-10 w-full validator" autocomplete="off" />' +
				'<div class="flex items-center justify-center gap-1 h-10 bg-base-100">' +
					'<button type="button" class="btn btn-xs btn-circle tooltip" data-tip="Move up" onclick="moveChoiceOptionUp(event)">' +
						'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M8 6L12 2L16 6"/><path d="M12 2V22"/></svg>' +
					'</button>' +
					'<button type="button" class="btn btn-xs btn-circle tooltip" data-tip="Move down" onclick="moveChoiceOptionDown(event)">' +
						'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M8 18L12 22L16 18"/><path d="M12 2V22"/></svg>' +
					'</button>' +
					'<button type="button" class="btn btn-xs btn-circle hover:btn-error tooltip" data-tip="Delete" onclick="removeChoiceOption(event)">' +
						'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>' +
					'</button>' +
				'</div>';
			container.appendChild(item);
		}
		function removeChoiceOption(event) {
			event.preventDefault();
			const form = event.target.closest('form');
			event.target.closest('.choice-option-item').remove();
			form.dispatchEvent(new Event('change'));
		}
		function moveChoiceOptionUp(event) {
			event.preventDefault();
			const item = event.target.closest('.choice-option-item');
			const prev = item.previousElementSibling;
			if (prev && prev.classList.contains('choice-option-item')) {
				item.parentNode.insertBefore(item, prev);
			}
		}
		function moveChoiceOptionDown(event) {
			event.preventDefault();
			const item = event.target.closest('.choice-option-item');
			const next = item.nextElementSibling;
			if (next && next.classList.contains('choice-option-item')) {
				item.parentNode.insertBefore(next, item);
			}
		}
	</script>
}

templ choiceOptionItem(opt blocks.ChoiceOption) {
	<div class="choice-option-item grid grid-cols-[1fr_9rem_5.5rem] hover:bg-base-200/30 transition-colors">
		<input
			type="text"
			name="option_label"
			value={ opt.Label }
			placeholder="Option label"
			class="input input-sm rounded-none h-10 w-full"
			autocomplete="off"
		/>
		<input
			type="text"
			name="option_sets"
			value={ opt.Sets }
			placeholder="var_name"
			pattern="[a-z_]+"
			class="input input-sm font-mono rounded-none h-10 w-full validator"
			autocomplete="off"
		/>
		<div class="flex items-center justify-center gap-1 h-10">
			<button type="button" class="btn btn-xs btn-circle tooltip" data-tip="Move up" onclick="moveChoiceOptionUp(event)">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-move-up w-3 h-3"><path d="M8 6L12 2L16 6"></path><path d="M12 2V22"></path></svg>
			</button>
			<button type="button" class="btn btn-xs btn-circle tooltip" data-tip="Move down" onclick="moveChoiceOptionDown(event)">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-move-down w-3 h-3"><path d="M8 18L12 22L16 18"></path><path d="M12 2V22"></path></svg>
			</button>
			<button type="button" class="btn btn-xs btn-circle hover:btn-error tooltip" data-tip="Delete" onclick="removeChoiceOption(event)">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2 w-3 h-3"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg>
			</button>
		</div>
	</div>
}
