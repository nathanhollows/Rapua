package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/game"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
	"github.com/nathanhollows/Rapua/v8/navigation"
)

type ObjectivesParams struct {
	Run  models.Run
	View *services.PlayerObjectiveView
}

// Objectives groups the frontier by section: it is flat, so three parts of one
// task would otherwise read as three tasks.
templ Objectives(data ObjectivesParams) {
	{{ view := BuildQuestView(data.View) }}
	if len(view.Places) == 0 {
		<div role="alert" class="alert alert-info alert-soft">
			@icon("hourglass", templ.Attributes{"class": "w-5 h-5 shrink-0"})
			<span>Nothing to do right now. Check back once your team finishes something.</span>
		</div>
	} else {
		<div class="flex flex-col gap-9">
			for _, group := range view.Groups() {
				@questGroup(group)
			}
		</div>
	}
}

// A class, not an inline style, so each hue is contrast-checked once.
func hueClass(hue int) string {
	return fmt.Sprintf("q-h%d", hue)
}

templ questGroup(group QuestGroup) {
	<div class="flex flex-col gap-6">
		if group.Title != "" {
			<h2 class="q-group">{ group.Title }</h2>
		}
		for _, place := range group.Places {
			@questPlace(place, group.Title != "")
		}
	</div>
}

// A heading, not a card: a bordered box looks tappable, and only the tasks
// should.
templ questPlace(place QuestPlace, grouped bool) {
	<section class={ "q-sec flex flex-col gap-4", templ.KV(hueClass(place.Hue), place.IsSection) }>
		if place.IsSection {
			if len(place.Path) > 0 {
				<!-- Ancestors are history, so the smallest type and no indent. -->
				<p class="flex flex-wrap items-center gap-1.5 text-sm q-soft">
					for i, ancestor := range place.Path {
						if i > 0 {
							@icon("chevron-right", templ.Attributes{"class": "w-3 h-3 shrink-0"})
						}
						<span>{ ancestor }</span>
					}
				</p>
			}
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				if !place.NamedByGroup {
					<h3 class={ "q-head", templ.KV("q-head-sub", grouped) }>{ place.Title }</h3>
				}
				if place.Pill != "" {
					<span class="q-pill">{ place.Pill }</span>
				}
			</div>
		}
		<div class="flex flex-col gap-4">
			for i, row := range place.Rows {
				@questRow(row, place.Ordered && i == 0)
			}
		</div>
		@questPlaceFooter(place)
	</section>
}

// It asks first because finishing skips whatever is left.
templ questPlaceFooter(place QuestPlace) {
	for _, finish := range place.Finishes {
		{{ dialogID := "finish-" + finish.Slug }}
		<div class="q-or" aria-hidden="true">or</div>
		<button
			type="button"
			class="q-fin"
			_={ "on click call #" + dialogID + ".showModal()" }
		>
			{ finish.Label }
		</button>
		<dialog id={ dialogID } class="modal modal-bottom sm:modal-middle">
			<div class="modal-box">
				<h3 class="text-xl font-bold text-pretty">
					if finish.WholeQuest {
						Finish the quest?
					} else {
						Finish { finish.Title }?
					}
				</h3>
				<p class="py-3 text-pretty">
					if finish.WholeQuest {
						This ends the run: anything unfinished is left behind.
					} else {
						This closes the section and skips what is left.
					}
				</p>
				<div class="modal-action">
					<form method="dialog">
						<button class="btn btn-ghost">Keep going</button>
					</form>
					<!-- Boosted so the list swaps in: an Hx-Redirect reloads the document. -->
					<form method="post" action={ templ.URL("/objective/" + finish.Slug + "/finish") } hx-boost="true">
						<button type="submit" class="btn btn-success">
							{ finish.Label }
						</button>
					</form>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button aria-label="Close">close</button>
			</form>
		</dialog>
	}
}

// hero is the single next step of an ordered section, where nothing competes
// with it.
templ questRow(row QuestRow, hero bool) {
	<a
		href={ templ.URL("/objective/" + row.Slug) }
		hx-boost="true"
		class={ "q-tile", templ.KV("q-hero", hero) }
	>
		<span class="q-top">
			<!-- From the proof's first block, so the row shows what it will ask for. -->
			<span class="q-ico">
				if row.IconSVG != "" {
					@templ.Raw(row.IconSVG)
				} else if row.IsDoor {
					@icon("book-open", templ.Attributes{})
				} else {
					@icon("circle-dot", templ.Attributes{})
				}
			</span>
			if hero {
				<span class="q-over">Next up</span>
			}
		</span>
		<span class="grow min-w-0 flex flex-col gap-1">
			<span class="q-title">{ row.Title }</span>
			if row.Description != "" {
				<span class="q-desc q-soft">{ row.Description }</span>
			}
		</span>
		if hero {
			<span class="q-go">
				Open
				@icon("chevron-right", templ.Attributes{"class": "w-6 h-6 ml-auto"})
			</span>
		} else {
			@icon("chevron-right", templ.Attributes{"class": "w-5 h-5 shrink-0 opacity-60"})
		}
	</a>
}

func QuestChrome(run models.Run) AppChrome {
	return AppChrome{Run: run, Active: "quest"}
}

// headerMetric is decided in Go so a test can reach the choice.
type headerMetric struct {
	Show     bool
	Done     int
	Total    int
	HasTotal bool
	Label    string
}

// metricFor divides by what the run still owes, not the authored tree: bands and
// seeded windows make an authored total end short or overshoot.
func metricFor(settings models.QuestSettings, progress navigation.Progress) headerMetric {
	switch settings.ProgressFeedback.Normalised() {
	case game.ProgressFeedbackNone:
		return headerMetric{}
	case game.ProgressFeedbackCount:
		return headerMetric{Show: true, Done: progress.Found, Label: "found"}
	default:
		if progress.Total() == 0 {
			return headerMetric{}
		}
		return headerMetric{Show: true, Done: progress.Done, Total: progress.Total(), HasTotal: true, Label: "done"}
	}
}

// The header is not part of Objectives: the editor previews that in its own
// frame, where a count and team name would be invented.
templ QuestPage(data ObjectivesParams) {
	<div class="flex flex-col gap-5">
		@questHeader(data)
		@Objectives(data)
		if data.View.CanDiscover {
			@questScan()
			<!-- Scrolled to the end, the last card clears the floating button. -->
			<div class="h-14" aria-hidden="true"></div>
		}
	</div>
}

// questScan proves an objective by being there, from anywhere in the quest,
// and is the only way to find a secret. Its ids follow the scan block's, so
// scan.js drives both. The button opens the camera straight away; closing the
// sheet releases it, and the sheet closes on any answer so the toast is not
// left behind the modal.
//
// Quieter than a card: opening an objective is the main way to play, and a
// quest of quizzes should not read as a scavenger hunt.
templ questScan() {
	<button
		type="button"
		class="fixed z-40 bottom-[calc(5.75rem+env(safe-area-inset-bottom))] right-[max(1rem,calc((100%-28rem)/2+1rem))] flex items-center justify-center w-14 h-14 rounded-full bg-base-100 text-base-content border border-base-300 shadow-md active:scale-95 transition-transform cursor-pointer"
		aria-label="Scan a code"
		data-scan-open="anywhere"
		_="on click call #scan-sheet.showModal()"
	>
		@icon("scan-qr-code", templ.Attributes{"class": "w-7 h-7 shrink-0"})
	</button>
	<dialog
		id="scan-sheet"
		class="modal modal-bottom sm:modal-middle"
		_={ "on close call #scan-stop-anywhere.click() then " + scanToCamera }
	>
		<div class="modal-box flex flex-col gap-4">
			<h3 class="text-xl font-bold">Scan a code</h3>
			@questScanForm()
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>Close</button>
		</form>
	</dialog>
}

// The camera and the typed code take turns: the sheet opens on the camera, and
// typing replaces it rather than sitting beside it.
const (
	scanToTyping = "on click add .hidden to #scan-type-switch-anywhere then add .hidden to #scan-status-anywhere then " +
		"remove .hidden from #scan-type-anywhere then call #code-anywhere.focus()"
	scanToCamera = "add .hidden to #scan-type-anywhere then " +
		"remove .hidden from #scan-type-switch-anywhere"
)

templ questScanForm() {
	<form
		id="scan-form-anywhere"
		hx-post="/s/"
		hx-swap="none"
		class="flex flex-col gap-3"
		_="on htmx:afterRequest call #scan-sheet.close()"
	>
		<input type="hidden" name="scanned" value=""/>
		<!-- scan.js hides this row while the camera runs. Visibility toggles sit on
		wrapper divs because q-alt sets its own display, which .hidden loses to. -->
		<div id="scan-controls-anywhere" class="flex gap-2 not-prose">
			<div class="grow">
				<button type="button" class="q-alt w-full" data-scan-open="anywhere" _={ "on click " + scanToCamera }>
					@icon("scan-qr-code", templ.Attributes{"class": "w-6 h-6"})
					Use the camera
				</button>
			</div>
			<!-- Shown only when the camera failed to open and nothing is typed yet. -->
			<div id="scan-type-switch-anywhere" class="grow">
				<button type="button" class="q-alt w-full" _={ scanToTyping }>
					@icon("keyboard", templ.Attributes{"class": "w-6 h-6"})
					Type it instead
				</button>
			</div>
		</div>
		<div id="scan-type-anywhere" class="hidden">
			<div class="flex gap-2">
				<input
					id="code-anywhere"
					name="code"
					type="text"
					placeholder="Code"
					class="q-input grow min-w-0"
					autocomplete="off"
					required
				/>
				<button type="submit" class="q-act q-act-fit">Check</button>
			</div>
		</div>
		<div id="scan-viewport-anywhere" class="hidden not-prose">
			<div class="flex flex-col gap-3">
				<div class="relative rounded-2xl overflow-hidden bg-base-300">
					<video id="scan-video-anywhere" class="w-full" muted autoplay playsinline></video>
				</div>
				<div class="flex gap-2">
					<button
						type="button"
						class="q-alt grow"
						data-scan-close="anywhere"
						_={ scanToTyping }
					>
						@icon("keyboard", templ.Attributes{"class": "w-6 h-6"})
						Type it instead
					</button>
					<button
						type="button"
						id="scan-stop-anywhere"
						class="q-alt q-act-fit"
						data-scan-close="anywhere"
						_="on click call #scan-sheet.close()"
					>Close</button>
				</div>
			</div>
		</div>
		<p id="scan-status-anywhere" class="text-base text-center q-soft hidden"></p>
	</form>
}

// It scrolls away, as a sticky bar costs room on the screen read most. Rank lives
// on the You tab: here it would put standing ahead of place.
templ questHeader(data ObjectivesParams) {
	{{ metric := metricFor(data.Run.Quest.Settings, data.View.Progress) }}
	<header class="flex items-start gap-4">
		<div class="min-w-0 grow flex flex-col gap-1">
			<h1 class="font-bold text-lg leading-snug text-pretty">{ data.Run.Quest.Name }</h1>
			<p class="text-sm opacity-70 truncate">
				if data.Run.Name != "" {
					{ data.Run.Name }
				} else {
					No name yet
				}
			</p>
			if data.Run.Quest.Settings.EnablePoints {
				<span class="badge badge-ghost font-semibold tabular-nums self-start">{ fmt.Sprint(data.Run.Points) } pts</span>
			}
		</div>
		if metric.Show {
			<div
				class="shrink-0 text-right leading-none"
				role="img"
				if metric.HasTotal {
					aria-label={ fmt.Sprintf("%d of %d done", metric.Done, metric.Total) }
				} else {
					aria-label={ fmt.Sprintf("%d found", metric.Done) }
				}
			>
				<span class="text-5xl font-extrabold tabular-nums tracking-tight">{ fmt.Sprint(metric.Done) }</span>
				if metric.HasTotal {
					<span class="text-2xl font-bold opacity-50 tabular-nums">/{ fmt.Sprint(metric.Total) }</span>
				}
				<span class="block mt-1 text-sm font-semibold opacity-60">{ metric.Label }</span>
			</div>
		}
	</header>
}
