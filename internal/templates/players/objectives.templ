package templates

import (
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
	"github.com/nathanhollows/Rapua/v8/navigation"
)

type ObjectivesParams struct {
	Run  models.Run
	View *services.PlayerObjectiveView
}

// Objectives is the quest screen: what the run can work on now, grouped under
// the section each row came out of. The frontier is flat, so without grouping
// three parts of one task read as three unrelated tasks.
templ Objectives(data ObjectivesParams) {
	{{ view := BuildQuestView(data.View) }}
	if len(view.Places) == 0 {
		<div role="alert" class="alert alert-info alert-soft">
			@icon("hourglass", templ.Attributes{"class": "w-5 h-5 shrink-0"})
			<span>Nothing to do right now. Check back once your team finishes something.</span>
		</div>
	} else {
		<div class="flex flex-col gap-6">
			for _, place := range view.Places {
				@questPlace(place)
			}
			if data.View.Offers("scan") {
				@questScanAction()
			}
		</div>
	}
}

// questScanAction lets a player scan a code without first finding its card.
// It sits in the flow rather than floating, since a pinned bar would hide the
// last row. /scan checks one code against every objective on offer.
templ questScanAction() {
	<a href="/scan" hx-boost="true" class="btn btn-outline btn-primary btn-block">
		@icon("scan-qr-code", templ.Attributes{"class": "w-5 h-5"})
		Scan a code
	</a>
}


// questPlace is one section the run is standing in, and what it is offering.
//
// A heading rather than a card. A container is not something a player can do,
// and giving it a border makes it look like the thing they can tap: the screen
// then has two kinds of object and only one is real. The weight runs the other
// way instead, so the deeper a thing is the heavier it reads, and the only
// cards on the screen are the tasks.
templ questPlace(place QuestPlace) {
	if !place.IsSection {
		<div class="flex flex-col gap-2">
			for _, row := range place.Rows {
				@questRow(row)
			}
		</div>
	} else {
		<section class="flex flex-col gap-2">
			if len(place.Path) > 0 {
				<!-- Where you came from, in the smallest type on the screen.
				This is what replaces the nesting: an ancestor is history, and
				history costs no indent. -->
				<p class="flex flex-wrap items-center gap-1.5 text-xs opacity-45 px-0.5">
					for i, ancestor := range place.Path {
						if i > 0 {
							@icon("chevron-right", templ.Attributes{"class": "w-3 h-3 shrink-0"})
						}
						<span>{ ancestor }</span>
					}
				</p>
			}
			<div class="flex flex-wrap items-baseline gap-2 px-0.5">
				<h2 class="font-bold text-base leading-snug text-pretty">{ place.Title }</h2>
				if place.Rule != "" {
					<span class="text-xs opacity-50">{ place.Rule }</span>
				}
			</div>
			<!-- One rail, at any depth: the path carries how deep this is, so
			the layout never has to spend width on it. -->
			<div class="flex flex-col gap-2 border-l-2 border-base-300 ml-1 pl-3">
				for _, row := range place.Rows {
					@questRow(row)
				}
			</div>
		</section>
	}
}

// PreviewSection is a place with something else inside it, for the objective
// editor showing one row in the container it belongs to. The same heading, rule
// and rail as the game, so the context an author is shown is the context a
// player meets.
templ PreviewSection(title, rule string) {
	<section class="flex flex-col gap-2">
		<div class="flex flex-wrap items-baseline gap-2 px-0.5">
			<h2 class="font-bold text-base leading-snug text-pretty">{ title }</h2>
			if rule != "" {
				<span class="text-xs opacity-50">{ rule }</span>
			}
		</div>
		<div class="flex flex-col gap-2 border-l-2 border-base-300 ml-1 pl-3">
			{ children... }
		</div>
	</section>
}

// questRow is one objective on offer.
templ questRow(row QuestRow) {
	if row.CanFinish {
		<div class="flex items-center gap-3 rounded-box border border-success/40 bg-success/5 p-3">
			@icon("flag", templ.Attributes{"class": "w-5 h-5 shrink-0 text-success"})
			<span class="grow text-sm font-medium text-pretty">{ row.Title }</span>
			<button
				type="button"
				hx-post={ "/objective/" + row.Slug + "/finish" }
				hx-swap="none"
				class="btn btn-sm btn-success shrink-0"
			>
				{ row.FinishLabel }
			</button>
		</div>
	} else {
		<a
			href={ templ.URL("/objective/" + row.Slug) }
			hx-boost="true"
			class="flex items-start gap-3 rounded-box border border-base-300 bg-base-100 p-3 hover:bg-base-200 transition-colors"
		>
			<!-- Derived from the proof's first block, so the row shows what it will
			ask for rather than an author-chosen marker. -->
			if row.IconSVG != "" {
				<span class="shrink-0 mt-0.5 text-primary [&>svg]:w-5 [&>svg]:h-5">
					@templ.Raw(row.IconSVG)
				</span>
			} else if row.IsDoor {
				@icon("book-open", templ.Attributes{"class": "w-5 h-5 shrink-0 mt-0.5 opacity-50"})
			} else {
				@icon("circle-dot", templ.Attributes{"class": "w-5 h-5 shrink-0 mt-0.5 text-primary"})
			}
			<span class="grow min-w-0 flex flex-col gap-0.5">
				<span class="text-sm font-medium text-pretty">{ row.Title }</span>
				if row.Description != "" {
					<span class="text-xs opacity-60 text-pretty">{ row.Description }</span>
				}
			</span>
			@icon("chevron-right", templ.Attributes{"class": "w-4 h-4 shrink-0 mt-0.5 opacity-30"})
		</a>
	}
}

// QuestChrome counts what the run has finished, not what it can see, so the bar
// measures the quest and not the frontier.
func QuestChrome(run models.Run, view *services.PlayerObjectiveView) AppChrome {
	done, total := 0, 0
	for _, objective := range view.Objectives {
		// The root is never complete, so counting it would cap the bar short.
		if objective.ParentID == "" {
			continue
		}
		total++
		if view.Frontier.StatusOf(objective.ID) == navigation.StatusComplete {
			done++
		}
	}
	return AppChrome{Run: run, Active: "quest", Done: done, Total: total}
}
