package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/game"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
	"github.com/nathanhollows/Rapua/v8/navigation"
)

type ObjectivesParams struct {
	Run  models.Run
	View *services.PlayerObjectiveView
}

// Objectives is the quest screen: what the run can work on now, grouped under
// the section each row came out of. The frontier is flat, so without grouping
// three parts of one task read as three unrelated tasks.
//
// Three levels and no more: group heading, section, tasks. Locked and finished
// sections are not drawn: neither can be acted on.
templ Objectives(data ObjectivesParams) {
	{{ view := BuildQuestView(data.View) }}
	if len(view.Places) == 0 {
		<div role="alert" class="alert alert-info alert-soft">
			@icon("hourglass", templ.Attributes{"class": "w-5 h-5 shrink-0"})
			<span>Nothing to do right now. Check back once your team finishes something.</span>
		</div>
	} else {
		<div class="flex flex-col gap-9">
			for _, group := range view.Groups() {
				@questGroup(group)
			}
		</div>
	}
}

// hueClass names the palette class that sets a section's --h. A class, not an
// inline style: every hue is contrast-checked once, and a style attribute would
// carry a value templ cannot be told is safe.
func hueClass(hue int) string {
	return fmt.Sprintf("q-h%d", hue)
}

// questGroup is places under one outermost section, and the heading over them.
templ questGroup(group QuestGroup) {
	<div class="flex flex-col gap-6">
		if group.Title != "" {
			<h2 class="q-group">{ group.Title }</h2>
		}
		for _, place := range group.Places {
			@questPlace(place, group.Title != "")
		}
	</div>
}

// questPlace is one section the run is standing in, and what it is offering.
//
// A heading, not a card: a bordered container looks tappable, and the only
// raised things on the page should be the tasks. Colour is carried by the tasks
// and a dot, never by a box.
templ questPlace(place QuestPlace, grouped bool) {
	<section class={ "q-sec flex flex-col gap-4", templ.KV(hueClass(place.Hue), place.IsSection) }>
		if place.IsSection {
			if len(place.Path) > 0 {
				<!-- Anything deeper than the group, in the smallest type on the
				screen: an ancestor is history, and history costs no indent. -->
				<p class="flex flex-wrap items-center gap-1.5 text-sm q-soft">
					for i, ancestor := range place.Path {
						if i > 0 {
							@icon("chevron-right", templ.Attributes{"class": "w-3 h-3 shrink-0"})
						}
						<span>{ ancestor }</span>
					}
				</p>
			}
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<h3 class={ "q-head", templ.KV("q-head-sub", grouped) }>{ place.Title }</h3>
				if place.Pill != "" {
					<span class="q-pill">{ place.Pill }</span>
				}
			</div>
		}
		<div class="flex flex-col gap-4">
			for i, row := range place.Rows {
				@questRow(row, place.Ordered && i == 0)
			}
		</div>
		@questPlaceFooter(place)
	</section>
}

// questPlaceFooter is the section's way out once its band is met with room to
// spare.
//
// The remaining tasks stay and the press follows under an "or". It asks first
// because it closes the section and skips the rest.
templ questPlaceFooter(place QuestPlace) {
	if place.CanFinish {
		{{ dialogID := "finish-" + place.FinishSlug }}
		<div class="q-or" aria-hidden="true">or</div>
		<button
			type="button"
			class="q-fin"
			_={ "on click call #" + dialogID + ".showModal()" }
		>
			{ place.FinishLabel }
		</button>
		<dialog id={ dialogID } class="modal modal-bottom sm:modal-middle">
			<div class="modal-box">
				<h3 class="text-xl font-bold text-pretty">
					if place.IsSection {
						Finish { place.Title }?
					} else {
						Finish the quest?
					}
				</h3>
				<p class="py-3 text-pretty">
					if place.IsSection {
						This closes the section and skips what is left.
					} else {
						This ends the run: anything unfinished is left behind.
					}
				</p>
				<div class="modal-action">
					<form method="dialog">
						<button class="btn btn-ghost">Keep going</button>
					</form>
					<!-- Boosted, so the quest list is swapped in: an Hx-Redirect would
					reload the whole document. -->
					<form method="post" action={ templ.URL("/objective/" + place.FinishSlug + "/finish") } hx-boost="true">
						<button type="submit" class="btn btn-success">
							{ place.FinishLabel }
						</button>
					</form>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button aria-label="Close">close</button>
			</form>
		</dialog>
	}
}

// PreviewSection is a place with something inside it, for the editor showing one
// row in its container. It uses the game's heading and pill so authors see what
// players meet.
templ PreviewSection(title, rule string) {
	<section class="q-sec flex flex-col gap-4">
		<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
			<h3 class="q-head">{ title }</h3>
			if rule != "" {
				<span class="q-pill">{ rule }</span>
			}
		</div>
		<div class="flex flex-col gap-4">
			{ children... }
		</div>
	</section>
}

// questRow is one objective on offer. hero draws it as the single next step of a
// guided section, where nothing competes for the biggest thing on screen.
templ questRow(row QuestRow, hero bool) {
	<a
		href={ templ.URL("/objective/" + row.Slug) }
		hx-boost="true"
		class={ "q-tile", templ.KV("q-hero", hero) }
	>
		<span class="q-top">
			<!-- From the proof's first block, so the row shows what it will ask for. -->
			<span class="q-ico">
				if row.IconSVG != "" {
					@templ.Raw(row.IconSVG)
				} else if row.IsDoor {
					@icon("book-open", templ.Attributes{})
				} else {
					@icon("circle-dot", templ.Attributes{})
				}
			</span>
			if hero {
				<span class="q-over">Next up</span>
			}
		</span>
		<span class="grow min-w-0 flex flex-col gap-1">
			<span class="q-title">{ row.Title }</span>
			if row.Description != "" {
				<span class="q-desc q-soft">{ row.Description }</span>
			}
		</span>
		if hero {
			<span class="q-go">
				Open
				@icon("chevron-right", templ.Attributes{"class": "w-6 h-6 ml-auto"})
			</span>
		} else {
			@icon("chevron-right", templ.Attributes{"class": "w-5 h-5 shrink-0 opacity-60"})
		}
	</a>
}

func QuestChrome(run models.Run) AppChrome {
	return AppChrome{Run: run, Active: "quest"}
}

// headerMetric is the header's progress display, decided in Go so a test can
// reach the choice.
type headerMetric struct {
	// Show is false when the header says nothing: the author chose that, or
	// there is no total to count against.
	Show  bool
	Done  int
	Total int
	// HasTotal is false for count, which has no target.
	HasTotal bool
	Label    string
}

// metricFor reads the quest's choice off the run's own account.
//
// Fraction divides by what the run still owes, not the authored tree: bands and
// seeded windows make an authored total end short or overshoot. Count has no
// total to be wrong about.
func metricFor(settings models.QuestSettings, progress navigation.Progress) headerMetric {
	switch settings.ProgressFeedback.Normalised() {
	case game.ProgressFeedbackNone:
		return headerMetric{}
	case game.ProgressFeedbackCount:
		return headerMetric{Show: true, Done: progress.Done, Label: "found"}
	default:
		if progress.Total() == 0 {
			return headerMetric{}
		}
		return headerMetric{Show: true, Done: progress.Done, Total: progress.Total(), HasTotal: true, Label: "done"}
	}
}

// QuestPage is the quest as a run sees it: the header, then what it can do.
//
// The header is not part of Objectives because the editor previews that in its
// own frame, where a count and team name would be invented.
templ QuestPage(data ObjectivesParams) {
	<div class="flex flex-col gap-5">
		@questHeader(data)
		@Objectives(data)
	</div>
}

// questHeader says whose run this is and, if the author wants it, how far along.
// It scrolls away: a sticky bar costs room on the screen read most.
//
// Rank is not here: a comparison would put standing ahead of place. It lives on
// the You tab.
templ questHeader(data ObjectivesParams) {
	{{ metric := metricFor(data.Run.Quest.Settings, data.View.Progress) }}
	<header class="flex items-start gap-4">
		<div class="min-w-0 grow flex flex-col gap-1">
			<h1 class="font-bold text-lg leading-snug text-pretty">{ data.Run.Quest.Name }</h1>
			<p class="text-sm opacity-70 truncate">
				if data.Run.Name != "" {
					{ data.Run.Name }
				} else {
					No name yet
				}
			</p>
			if data.Run.Quest.Settings.EnablePoints {
				<span class="badge badge-ghost font-semibold tabular-nums self-start">{ fmt.Sprint(data.Run.Points) } pts</span>
			}
		</div>
		if metric.Show {
			<div
				class="shrink-0 text-right leading-none"
				role="img"
				if metric.HasTotal {
					aria-label={ fmt.Sprintf("%d of %d done", metric.Done, metric.Total) }
				} else {
					aria-label={ fmt.Sprintf("%d found", metric.Done) }
				}
			>
				<span class="text-5xl font-extrabold tabular-nums tracking-tight">{ fmt.Sprint(metric.Done) }</span>
				if metric.HasTotal {
					<span class="text-2xl font-bold opacity-50 tabular-nums">/{ fmt.Sprint(metric.Total) }</span>
				}
				<span class="block mt-1 text-sm font-semibold opacity-60">{ metric.Label }</span>
			</div>
		}
	</header>
}
