package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)

// No footer: the header says the quest and score, and the code is on the You tab.
templ Complete(
	team models.Run, pageBlocks blocks.Blocks, blockStates map[string]blocks.PlayerState,
	hidden map[string]bool, preview bool,
) {
	<div class="mt-6 mx-auto w-full max-w-md flex flex-col gap-8">
		<header class="q-finish q-sec">
			<span class="q-finish-ico">
				@icon("trophy", templ.Attributes{})
			</span>
			<div class="min-w-0">
				<h1 class="q-finish-title">
					if team.Quest.Name != "" {
						You finished { team.Quest.Name }.
					} else {
						You finished.
					}
				</h1>
				if team.Quest.Settings.EnablePoints && team.Points > 0 {
					<p class="q-finish-pts">{ fmt.Sprint(team.Points) } points</p>
				}
			</div>
		</header>
		<div class="flex flex-col gap-8 empty:hidden" data-block-list>
			for _, block := range pageBlocks {
				@PlayerBlockSlot(team.Quest.Settings, block, blockStates[block.GetID()], hidden[block.GetID()], preview)
			}
		</div>
		<div id="player-nav">
			<a href="/journal" hx-boost="true" class="q-fin">
				@icon("book-open-check", templ.Attributes{"class": "w-6 h-6"})
				See your journal
			</a>
		</div>
	</div>
}
