package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/models"
)

// Journal lists what the run has completed. Each row reopens its own reveal,
// which is the only place that content survives once its task is behind you.
templ Journal(team models.Run, completed []models.Objective) {
	if len(completed) == 0 {
		<div role="alert" class="alert alert-info alert-soft">
			@icon("book-open", templ.Attributes{"class": "w-5 h-5 shrink-0"})
			<span>
				Nothing here yet.
				<a href="/objectives" hx-boost="true" class="link">Finish your first objective</a>
				and it will show up.
			</span>
		</div>
	} else {
		<ul class="list bg-base-100 rounded-box border border-base-300">
			<li class="p-4 pb-2 text-xs tracking-wide opacity-50">
				{ fmt.Sprintf("%d collected", len(completed)) }
			</li>
			for _, objective := range completed {
				<li class="list-row">
					<div>
						@icon("circle-check-big", templ.Attributes{"class": "w-5 h-5 text-success"})
					</div>
					<div class="list-col-grow">
						<a href={ templ.URL("/objective/" + objective.Slug) } hx-boost="true" class="link link-hover text-sm font-medium text-pretty">
							{ objective.Title }
						</a>
					</div>
					@icon("chevron-right", templ.Attributes{"class": "w-4 h-4 opacity-30"})
				</li>
			}
		</ul>
	}
}

// JournalChrome carries no breadcrumb or progress bar: progress belongs to the
// quest screen.
func JournalChrome(team models.Run) AppChrome {
	return AppChrome{Run: team, Active: "journal"}
}
