package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/game"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
)

// QuestLint reports what is wrong with the quest itself: the start and finish
// pages, the settings, and the shape of the tree. What is wrong with a
// particular objective is marked on that objective, where it can be acted on.
//
// Unlike the import check, which is a decision point, this is a running
// commentary on something being built. It says nothing at all when there is
// nothing to say: a panel that is always there is one nobody reads.
templ QuestLint(lint services.QuestLint) {
	<div id="quest-lint" class="px-5">
		if lint.Unreadable() {
			<div role="alert" class="alert alert-outline alert-warning mb-3 items-start">
				@icon("triangle-alert", templ.Attributes{"class": "w-5 h-5"})
				<div>
					<p class="font-bold">Checks could not run</p>
					<p class="text-sm mt-1">
						Nothing here has been checked, so an empty list is not an all-clear.
						Reload to try again.
					</p>
				</div>
			</div>
		}
		if len(lint.Quest.Errors) > 0 {
			@questLintList("error", "circle-alert", "Needs fixing", lint.Quest.Errors)
		}
		if len(lint.Quest.Warnings) > 0 {
			@questLintList("warning", "triangle-alert", "Worth a look", lint.Quest.Warnings)
		}
	</div>
}

templ questLintList(style, iconName, heading string, diagnostics []game.LintDiag) {
	<div role="alert" class={ "alert alert-outline mb-3 items-start", "alert-" + style }>
		@icon(iconName, templ.Attributes{"class": "w-5 h-5"})
		<div>
			<p class="font-bold">{ heading } ({ fmt.Sprint(len(diagnostics)) })</p>
			<ul class="text-sm mt-1 list-disc list-inside space-y-0.5">
				for _, diagnostic := range diagnostics {
					<li>{ diagnostic.Message }</li>
				}
			</ul>
		</div>
	</div>
}

// objectiveLintBadge marks a row the linter has something to say about, and
// says it on hover.
//
// tabindex because the badge is the only place this text appears in the tree:
// a tooltip nothing can focus is one a keyboard never reads.
templ objectiveLintBadge(result game.LintResult) {
	if len(result.Errors) > 0 || len(result.Warnings) > 0 {
		<span class="tooltip tooltip-left shrink-0" tabindex="0">
			<span class="tooltip-content w-72 p-3 text-left whitespace-normal">
				@lintDiagLines("Needs fixing", result.Errors)
				@lintDiagLines("Worth a look", result.Warnings)
			</span>
			if len(result.Errors) > 0 {
				@icon("circle-alert", templ.Attributes{"class": "w-4 h-4 text-error"})
			} else {
				@icon("triangle-alert", templ.Attributes{"class": "w-4 h-4 text-warning"})
			}
		</span>
	}
}

templ lintDiagLines(heading string, diagnostics []game.LintDiag) {
	if len(diagnostics) > 0 {
		<p class="text-xs font-bold uppercase tracking-wide">{ heading }</p>
		<ul class="text-xs list-disc list-outside pl-4 space-y-1 mb-2">
			for _, diagnostic := range diagnostics {
				<li class="text-pretty">{ diagnostic.Message }</li>
			}
		</ul>
	}
}

// QuestBuilder is the quest page. The panel renders inside the tree rather
// than above it, so one swap refreshes both: what is wrong and the rows it is
// wrong about are answers to the same question.
templ QuestBuilder(lint services.QuestLint, root models.Objective, nodes []*ObjectiveTreeNode, settings models.QuestSettings) {
	@ObjectiveTree(lint, root, nodes, settings)
}

// SystemPageLintOOB re-renders the system page's panel after a block changes.
templ SystemPageLintOOB(lint services.QuestLint, pathPrefix string) {
	<div id="system-page-lint" hx-swap-oob="true">
		@SystemPageLint(lint, pathPrefix)
	</div>
}

// SystemPageLint shows the diagnostics about one system page. NO_START_BUTTON
// is the whole reason: it is about the start page, so no row carries it, and
// the page it is about was the one place it never appeared.
templ SystemPageLint(lint services.QuestLint, pathPrefix string) {
	{{ result := lint.Quest.Filter(pathPrefix) }}
	if lint.Unreadable() {
		<div class="px-5">
			<div role="alert" class="alert alert-outline alert-warning mb-3 items-start">
				@icon("triangle-alert", templ.Attributes{"class": "w-5 h-5"})
				<p class="text-sm">Checks could not run, so nothing on this page has been checked.</p>
			</div>
		</div>
	} else if len(result.Errors) > 0 || len(result.Warnings) > 0 {
		<div class="px-5">
			if len(result.Errors) > 0 {
				@questLintList("error", "circle-alert", "Needs fixing", result.Errors)
			}
			if len(result.Warnings) > 0 {
				@questLintList("warning", "triangle-alert", "Worth a look", result.Warnings)
			}
		</div>
	}
}

// ObjectiveLintPanelOOB re-renders the panel in place after a save. The
// objective form posts with no swap, so without this the panel keeps whatever
// it said when the page loaded: a fixed problem still reads as broken, and a
// newly broken one still reads as clean.
templ ObjectiveLintPanelOOB(lint services.QuestLint, objectiveID string) {
	<div id="objective-lint" hx-swap-oob="true">
		@objectiveLintPanel(lint, objectiveID)
	</div>
}

// objectiveLintPanel says in full what the tree only badges.
//
// The root is the exception the tree cannot cover: it has no row, so its
// diagnostics sit with the quest, and this is the only page carrying the
// controls those diagnostics are about.
templ objectiveLintPanel(lint services.QuestLint, objectiveID string) {
	{{ result := lint.ForEditor(objectiveID) }}
	if lint.Unreadable() {
		<div class="px-5">
			<div role="alert" class="alert alert-outline alert-warning mb-3 items-start">
				@icon("triangle-alert", templ.Attributes{"class": "w-5 h-5"})
				<p class="text-sm">Checks could not run, so nothing below has been checked.</p>
			</div>
		</div>
	} else if len(result.Errors) > 0 || len(result.Warnings) > 0 {
		<div class="px-5">
			if len(result.Errors) > 0 {
				@questLintList("error", "circle-alert", "Needs fixing", result.Errors)
			}
			if len(result.Warnings) > 0 {
				@questLintList("warning", "triangle-alert", "Worth a look", result.Warnings)
			}
		</div>
	}
}
