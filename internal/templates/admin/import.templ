package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/game"
	"github.com/nathanhollows/Rapua/v8/models"
)

// ImportModal is the dialog for importing a game from a JSON file.
// It renders a file picker; on selection, the file is validated server-side before
// the user is offered create/overwrite actions.
templ ImportModal() {
	<dialog id="import_modal" class="modal modal-bottom sm:modal-middle">
		<div class="modal-box">
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" aria-label="Close">✕</button>
			</form>
			<h3 class="text-2xl font-extrabold">Import a game</h3>
			<p class="py-3 text-base-content/70">
				Choose a Rapua game file. It is checked first, and nothing changes until you confirm.
			</p>
			<form
				id="import-form"
				hx-post="/admin/quests/import/check"
				hx-target="#import-result"
				hx-swap="innerHTML"
				hx-encoding="multipart/form-data"
				hx-indicator="#import-spinner"
			>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">Game file (.json)</legend>
					<input
						type="file"
						name="file"
						accept=".json,application/json"
						class="file-input w-full"
						onchange="htmx.trigger('#import-form', 'submit')"
						required
					/>
				</fieldset>
				<span id="import-spinner" class="htmx-indicator loading loading-spinner loading-sm mt-2"></span>
			</form>
			<div id="import-result" class="mt-4"></div>
		</div>
	</dialog>
}

// ImportCheckResult is the HTMX fragment returned after validating an uploaded JSON file.
templ ImportCheckResult(lintResult game.LintResult, matchedInstance *models.Quest, docName string) {
	if !lintResult.IsValid() {
		<div role="alert" class="alert alert-error">
			@icon("circle-x", templ.Attributes{"class": "w-5 h-5"})
			<div>
				<p class="font-extrabold">{ fmt.Sprint(len(lintResult.Errors)) } problem{ plural(len(lintResult.Errors)) }, so this can’t be imported</p>
				@lintList(lintResult.Errors)
			</div>
		</div>
	} else {
		<div class="flex flex-col gap-4">
			if len(lintResult.Warnings) > 0 {
				<div role="alert" class="alert alert-warning">
					@icon("triangle-alert", templ.Attributes{"class": "w-5 h-5"})
					<div>
						<p class="font-extrabold">{ fmt.Sprint(len(lintResult.Warnings)) } thing{ plural(len(lintResult.Warnings)) } to look at</p>
						<p class="text-sm">These won’t stop the import.</p>
						@lintList(lintResult.Warnings)
					</div>
				</div>
			}
			<div>
				<span class="kicker">Ready to import</span>
				<p class="text-xl font-extrabold">{ docName }</p>
			</div>
			<div class="flex flex-col gap-2">
				<button
					class="btn btn-primary w-full"
					onclick="submitImportTo('/admin/quests/import')"
				>
					@icon("plus", templ.Attributes{"class": "w-4 h-4"})
					Import as a new game
				</button>
				if matchedInstance != nil {
					<button
						class="btn btn-warning w-full"
						data-url={ fmt.Sprintf("/admin/quests/%s/import", matchedInstance.ID) }
						onclick="submitImportTo(this.dataset.url)"
					>
						@icon("upload", templ.Attributes{"class": "w-4 h-4"})
						Overwrite “{ matchedInstance.Name }”
					</button>
				}
			</div>
		</div>
	}
}

// lintList is what the checker found, each with where in the file it is.
templ lintList(diags []game.LintDiag) {
	<ul class="text-sm mt-1 flex flex-col gap-1">
		for _, diag := range diags {
			<li>
				<code class="text-xs font-bold">{ diag.Code }</code> { diag.Message }
				<span class="text-base-content/60 text-xs">({ diag.Path })</span>
			</li>
		}
	</ul>
}

// ImportErrorResult is an inline error fragment for failed parse/import operations.
templ ImportErrorResult(message string) {
	<div role="alert" class="alert alert-error">
		@icon("circle-x", templ.Attributes{"class": "w-5 h-5"})
		<span>{ message }</span>
	</div>
}
