package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/game"
	"github.com/nathanhollows/Rapua/v8/models"
)

// ImportModal is the dialog for importing a game from a JSON file.
// It renders a file picker; on selection, the file is validated server-side before
// the user is offered create/overwrite actions.
templ ImportModal() {
	<dialog id="import_modal" class="modal modal-bottom sm:modal-middle">
		<div class="modal-box">
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
			<h3 class="text-lg font-bold">Import game</h3>
			<p class="py-2 text-sm opacity-60">
				Upload a Rapua v7 JSON file. It will be validated before any changes are made.
			</p>
			<form
				id="import-form"
				hx-post="/admin/quests/import/check"
				hx-target="#import-result"
				hx-swap="innerHTML"
				hx-encoding="multipart/form-data"
				hx-indicator="#import-spinner"
			>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">Game file (.json)</legend>
					<input
						type="file"
						name="file"
						accept=".json,application/json"
						class="file-input w-full"
						onchange="htmx.trigger('#import-form', 'submit')"
						required
					/>
				</fieldset>
				<span id="import-spinner" class="htmx-indicator loading loading-spinner loading-sm mt-2"></span>
			</form>
			<div id="import-result" class="mt-3"></div>
		</div>
	</dialog>
}

// ImportCheckResult is the HTMX fragment returned after validating an uploaded JSON file.
templ ImportCheckResult(lintResult game.LintResult, matchedInstance *models.Quest, docName string) {
	if !lintResult.IsValid() {
		<div role="alert" class="alert alert-error">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
			<div>
				<p class="font-bold">{ fmt.Sprint(len(lintResult.Errors)) } error(s) — cannot import</p>
				<ul class="text-sm mt-1 list-disc list-inside space-y-0.5">
					for _, e := range lintResult.Errors {
						<li>
							<code class="text-xs">{ e.Code }</code> { e.Message }
							<span class="opacity-60 text-xs">({ e.Path })</span>
						</li>
					}
				</ul>
			</div>
		</div>
	} else {
		<div>
			if len(lintResult.Warnings) > 0 {
				<div role="alert" class="alert alert-warning mb-3 py-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.538-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
					<div>
						<p class="font-bold">{ fmt.Sprint(len(lintResult.Warnings)) } warning(s) — review recommended</p>
						<ul class="text-sm mt-1 list-disc list-inside space-y-0.5">
							for _, w := range lintResult.Warnings {
								<li>
									<code class="text-xs">{ w.Code }</code> { w.Message }
									<span class="opacity-60 text-xs">({ w.Path })</span>
								</li>
							}
						</ul>
					</div>
				</div>
			}
			<p class="text-sm mb-3">Ready to import: <strong>{ docName }</strong></p>
			<div class="flex flex-col gap-2">
				if matchedInstance != nil {
					<button
						class="btn btn-warning w-full"
						data-url={ fmt.Sprintf("/admin/quests/%s/import", matchedInstance.ID) }
						onclick="submitImportTo(this.dataset.url)"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
						Overwrite "{ matchedInstance.Name }"
					</button>
				}
				<button
					class="btn btn-primary w-full"
					onclick="submitImportTo('/admin/quests/import')"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
					Import as new game
				</button>
			</div>
		</div>
	}
}

// ImportErrorResult is an inline error fragment for failed parse/import operations.
templ ImportErrorResult(message string) {
	<div role="alert" class="alert alert-error">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
		<span>{ message }</span>
	</div>
}
