package templates

import (
	"encoding/json"
	"fmt"
	"strconv"
	"strings"
	"github.com/nathanhollows/Rapua/v8/game"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ SpacesPage(spaces []models.Space) {
	<div class="flex flex-col sm:flex-row gap-3 justify-between items-center w-full p-5">
		<div>
			<h1 class="text-2xl font-bold">Spaces</h1>
			<p class="text-base-content/60">The real-world places and things your objectives point at.</p>
		</div>
		<a href="/admin/spaces/new" class="btn btn-primary">
			@icon("plus", templ.Attributes{"class": "w-4 h-4"})
			Add space
		</a>
	</div>
	<div class="p-5 pt-0">
		if len(spaces) == 0 {
			@spacesEmptyState()
		} else {
			<div class="overflow-x-auto">
				<table class="table">
					<thead>
						<tr>
							<th>Space</th>
							<th>Kind</th>
							<th>Where</th>
							<th>Scan code</th>
							<th>Proof methods</th>
						</tr>
					</thead>
					<tbody>
						for _, space := range spaces {
							@spaceRow(space)
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ spacesEmptyState() {
	<div class="flex flex-col items-center justify-center p-16 text-center">
		@icon("map-pin", templ.Attributes{"class": "w-16 h-16 text-base-content/30 mb-6"})
		<h2 class="text-xl font-bold mb-2">No spaces yet</h2>
		<p class="text-base-content/60 max-w-md mb-6">
			A space is somewhere a player stands, or something they find. Register it once and
			any objective can point at it.
		</p>
		<a href="/admin/spaces/new" class="btn btn-primary">Add your first space</a>
	</div>
}

templ spaceRow(space models.Space) {
	<tr class="hover">
		<td>
			<a href={ templ.SafeURL("/admin/spaces/" + space.ID) } class="font-medium link link-hover">
				{ space.Name }
			</a>
			<div class="text-xs text-base-content/60">{ space.Slug }</div>
		</td>
		<td>
			<span class="badge badge-ghost">{ space.Kind.String() }</span>
			if space.Mobile {
				<span class="badge badge-warning badge-sm ml-1">moves</span>
			}
		</td>
		<td class="text-sm">{ spaceWhere(space) }</td>
		<td>
			if space.Payload != "" {
				<code class="text-sm">{ space.Payload }</code>
			} else {
				<span class="text-base-content/40">—</span>
			}
		</td>
		<td class="text-sm text-base-content/70">{ proofMethodList(space) }</td>
	</tr>
}

templ EditSpace(space models.Space, isNew bool) {
	<div class="flex flex-col sm:flex-row gap-3 justify-between items-center w-full p-5">
		<div>
			<div class="text-sm breadcrumbs text-base-content/60">
				<ul>
					<li><a href="/admin/spaces">Spaces</a></li>
					<li>
						if isNew {
							New space
						} else {
							{ space.Name }
						}
					</li>
				</ul>
			</div>
			<h1 class="text-2xl font-bold">
				if isNew {
					New space
				} else {
					{ space.Name }
				}
			</h1>
		</div>
		<div class="flex gap-3">
			if !isNew {
				<button type="button" class="btn btn-error" onclick="confirm_delete_space_modal.showModal();">
					@icon("trash-2", templ.Attributes{"class": "w-4 h-4"})
					Delete
				</button>
			}
			<button form="edit-space" class="btn btn-primary" type="submit">
				@icon("save", templ.Attributes{"class": "w-4 h-4"})
				Save
			</button>
		</div>
	</div>
	<div class="p-5 pt-0 max-w-3xl">
		<form
			id="edit-space"
			if isNew {
				hx-post="/admin/spaces"
			} else {
				hx-post={ "/admin/spaces/" + space.ID }
			}
			hx-swap="none"
			_="on change from #space-kind
				set kind to #space-kind's value
				if kind is 'object'
					add .hidden to #point-geometry
					add .hidden to #area-geometry
				else if kind is 'area'
					remove .hidden from #point-geometry
					remove .hidden from #area-geometry
				else
					remove .hidden from #point-geometry
					add .hidden to #area-geometry
				end"
		>
			<fieldset class="fieldset">
				<legend class="fieldset-legend">Name</legend>
				<input
					type="text"
					name="name"
					value={ space.Name }
					placeholder="Totara grove"
					class="input input-bordered w-full"
					required
				/>
				<p class="label">What players will see this place called.</p>
			</fieldset>
			<fieldset class="fieldset">
				<legend class="fieldset-legend">Slug</legend>
				<input
					type="text"
					name="slug"
					value={ space.Slug }
					placeholder="derived from the name"
					class="input input-bordered w-full"
				/>
				<p class="label">How objectives refer to this space. Leave blank to derive it from the name.</p>
			</fieldset>
			<fieldset class="fieldset">
				<legend class="fieldset-legend">Kind</legend>
				<select id="space-kind" name="kind" class="select select-bordered w-full">
					for _, kind := range []game.SpaceKind{game.SpaceKindPoint, game.SpaceKindArea, game.SpaceKindObject} {
						<option value={ string(kind) } selected?={ space.Kind == kind }>
							{ kind.String() }
						</option>
					}
				</select>
				<p class="label">{ spaceKindHelp() }</p>
			</fieldset>
			<div
				id="point-geometry"
				if space.Kind == game.SpaceKindObject {
					class="hidden"
				}
			>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Latitude</legend>
						<input
							type="number"
							step="any"
							name="lat"
							value={ coordValue(space, "lat") }
							class="input input-bordered w-full"
						/>
					</fieldset>
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Longitude</legend>
						<input
							type="number"
							step="any"
							name="lng"
							value={ coordValue(space, "lng") }
							class="input input-bordered w-full"
						/>
					</fieldset>
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Radius (m)</legend>
						<input
							type="number"
							step="any"
							min="0"
							name="radius"
							value={ coordValue(space, "radius") }
							class="input input-bordered w-full"
						/>
					</fieldset>
				</div>
			</div>
			<div
				id="area-geometry"
				if space.Kind != game.SpaceKindArea {
					class="hidden"
				}
			>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">Boundary</legend>
					<textarea
						name="boundary"
						rows="6"
						placeholder={ boundaryPlaceholder() }
						class="textarea textarea-bordered w-full font-mono text-sm"
					>{ boundaryText(space) }</textarea>
					<p class="label">
						A GeoJSON geometry, as exported by a map tool. Leave blank to use the
						coordinates and radius above instead.
					</p>
				</fieldset>
			</div>
			<fieldset class="fieldset">
				<legend class="fieldset-legend">Scan code</legend>
				<input
					type="text"
					name="payload"
					value={ space.Payload }
					placeholder="generated automatically"
					class="input input-bordered w-full font-mono"
				/>
				if isNew {
					<p class="label">What a QR code or NFC tag at this space carries. Leave blank to generate one.</p>
				} else {
					<p class="label">
						What a QR code or NFC tag at this space carries. Changing it retires every code
						already printed for this space. Leave blank to keep the current one.
					</p>
				}
			</fieldset>
			<fieldset class="fieldset">
				<label class="label cursor-pointer justify-start gap-3">
					<input type="checkbox" name="mobile" class="checkbox" checked?={ space.Mobile }/>
					<span class="label-text">This space moves</span>
				</label>
				<p class="label">Tick if the space is relocated often, so its coordinates cannot be trusted.</p>
			</fieldset>
		</form>
		if !isNew {
			<div class="alert alert-info mt-6">
				@icon("info", templ.Attributes{"class": "w-5 h-5"})
				<span>
					A { strings.ToLower(space.Kind.String()) } can be proved by { proofMethodList(space) }.
				</span>
			</div>
			<dialog id="confirm_delete_space_modal" class="modal modal-bottom sm:modal-middle">
				<div class="modal-box prose outline-2 outline-offset-1 outline-error">
					<h3 class="text-lg font-bold">Delete this space?</h3>
					<p class="pt-4">
						You are about to delete { space.Name }. Any objective pointing at it will need a new space.
					</p>
					<div class="modal-action">
						<button type="button" class="btn" onclick="confirm_delete_space_modal.close()">Nevermind</button>
						<button
							type="button"
							class="btn btn-error"
							hx-delete={ "/admin/spaces/" + space.ID }
							hx-trigger="click"
							onclick="confirm_delete_space_modal.close()"
						>Delete</button>
					</div>
					<form method="dialog">
						<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
					</form>
				</div>
			</dialog>
		}
	</div>
}

// A raw polygon is unreadable at a glance.
func spaceWhere(space models.Space) string {
	if space.Kind == game.SpaceKindObject {
		return "Moves — no fixed position"
	}
	if space.Geometry == nil {
		return "—"
	}
	if space.Geometry.Type == game.GeometryPolygon {
		return fmt.Sprintf("Boundary of %d points", boundaryPointCount(space.Geometry))
	}
	if !space.Geometry.HasCoordinates() {
		return "—"
	}
	where := fmt.Sprintf("%.5f, %.5f", space.Geometry.Point.Lat(), space.Geometry.Point.Lng())
	if space.Geometry.Radius > 0 {
		where += fmt.Sprintf(" · %gm", space.Geometry.Radius)
	}
	return where
}

func proofMethodList(space models.Space) string {
	methods := space.ProofMethods()
	names := make([]string, 0, len(methods))
	for _, m := range methods {
		names = append(names, m.String())
	}
	if len(names) == 0 {
		return "—"
	}
	return strings.Join(names, ", ")
}

func boundaryPlaceholder() string {
	return `{"type":"Polygon","coordinates":[[[170.5028,-45.8788],` +
		`[170.5040,-45.8790],[170.5030,-45.8800],[170.5028,-45.8788]]]}`
}

// Rendered back as GeoJSON so a map tool can read what the author last saved.
func boundaryText(space models.Space) string {
	if space.Geometry == nil || space.Geometry.Type != game.GeometryPolygon {
		return ""
	}
	data, err := json.Marshal(space.Geometry)
	if err != nil {
		return ""
	}
	return string(data)
}

func spaceKindHelp() string {
	return game.SpaceKindPoint.Description() + " " +
		game.SpaceKindArea.Description() + " " +
		game.SpaceKindObject.Description()
}

// Discounts the closing position, which repeats the first.
func boundaryPointCount(g *game.SpaceGeometry) int {
	if len(g.Rings) == 0 {
		return 0
	}
	outer := g.Rings[0]
	if len(outer) == 0 {
		return 0
	}
	return len(outer) - 1
}

func coordValue(space models.Space, field string) string {
	if space.Geometry == nil || space.Geometry.Type == game.GeometryPolygon {
		return ""
	}
	var v float64
	switch field {
	case "lat":
		v = space.Geometry.Point.Lat()
	case "lng":
		v = space.Geometry.Point.Lng()
	case "radius":
		v = space.Geometry.Radius
	}
	if v == 0 {
		return ""
	}
	return strconv.FormatFloat(v, 'f', -1, 64)
}
