package templates

import (
	"fmt"
	"github.com/SerhiiCho/timeago/v3"
	"github.com/nathanhollows/Rapua/v8/internal/flash"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
	"time"
)

// TeamStatusBadge renders a status badge for a team with optional tooltip and size.
// Complete is filled where Playing is soft: both are green, because both are
// well, but only one of them has stopped.
templ TeamStatusBadge(status services.TeamStatus, withTooltip bool, size string) {
	switch status {
		case services.StatusFinished:
			if withTooltip {
				<span class={ fmt.Sprintf("badge badge-success badge-%s tooltip tooltip-left", size) } data-tip="The run is complete.">Complete</span>
			} else {
				<span class={ fmt.Sprintf("badge badge-success badge-%s", size) }>Complete</span>
			}
		case services.StatusPlaying:
			if withTooltip {
				<span class={ fmt.Sprintf("badge badge-success badge-soft badge-%s tooltip tooltip-left", size) } data-tip="Moving at this run's usual pace.">Playing</span>
			} else {
				<span class={ fmt.Sprintf("badge badge-success badge-soft badge-%s", size) }>Playing</span>
			}
		case services.StatusIdle:
			if withTooltip {
				<span class={ fmt.Sprintf("badge badge-info badge-soft badge-%s tooltip tooltip-left", size) } data-tip="Quieter than usual for a while.">Idle</span>
			} else {
				<span class={ fmt.Sprintf("badge badge-info badge-soft badge-%s", size) }>Idle</span>
			}
		case services.StatusStalled:
			if withTooltip {
				<span class={ fmt.Sprintf("badge badge-warning badge-soft badge-%s tooltip tooltip-left", size) } data-tip="A long quiet spell.">Stalled</span>
			} else {
				<span class={ fmt.Sprintf("badge badge-warning badge-soft badge-%s", size) }>Stalled</span>
			}
		case services.StatusAbandoned:
			if withTooltip {
				<span class={ fmt.Sprintf("badge badge-error badge-soft badge-%s tooltip tooltip-left", size) } data-tip="Quiet so long they may have walked off.">Abandoned</span>
			} else {
				<span class={ fmt.Sprintf("badge badge-error badge-soft badge-%s", size) }>Abandoned</span>
			}
		case services.StatusStarted:
			if withTooltip {
				<span class={ fmt.Sprintf("badge badge-ghost badge-%s tooltip tooltip-left", size) } data-tip="This run has started, and has not shown enough of a pace to read yet.">Started</span>
			} else {
				<span class={ fmt.Sprintf("badge badge-ghost badge-%s", size) }>Started</span>
			}
		default:
			<span class={ fmt.Sprintf("badge badge-ghost badge-%s", size) }>Not started</span>
	}
}

templ ActivityTracker(quest models.Quest, summaries map[string]services.RunSummary) {
	<div class="flex flex-col sm:flex-row gap-3 justify-between items-center w-full p-5">
		<h1 class="text-4xl font-black">Activity</h1>
		<div class="flex gap-3">
			<button
				class="btn tooltip"
				data-tip="Send an announcement to all teams"
				onclick="announcement_modal.showModal()"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-megaphone"><path d="m3 11 18-5v12L3 14v-3z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path></svg>
				Announce
			</button>
			<button
				hx-get="/admin/facilitator/create-link"
				hx-target="#facilitator_link_modal"
				hx-swap="innerHTML"
				class="btn btn-circle tooltip tooltip-left md:tooltip-top"
				data-tip="Share activity overview with Facilitators"
				_="on click facilitator_link_modal.showModal()"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share-2 w-4 h-4 mx-auto"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
			</button>
			<dialog id="facilitator_link_modal" class="modal modal-bottom sm:modal-middle">
				@FacilitatorLinkModal()
			</dialog>
		</div>
	</div>
	<div class="px-5 mb-5">
		@GameControl(quest)
	</div>
	<div class="px-5 mb-5">
		@ActivityStats(quest, summaries)
	</div>
	<div class="split px-5">
		<div class="w-full min-w-0 overflow-x-hidden">
			<!-- No padding below the table, and clipped to the card's corners:
			the rows run edge to edge, so the last one ends the card rather
			than leaving a strip of padding under it. -->
			<div class="card panel overflow-hidden">
				<div class="card-body p-5">
					<div class="flex items-center justify-between mb-2">
						<h2 class="card-title text-2xl font-extrabold flex items-center gap-2">
							if quest.Settings.EnablePoints {
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy w-5 h-5"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
								Leaderboard
							} else {
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-5 h-5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
								Team progress
							}
						</h2>
						<label class="input flex items-center gap-2 w-60">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search w-4 h-4"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
							<input
								id="search-teams-activity"
								type="text"
								class="grow"
								placeholder="Search"
								_="
								init send input to me
								on input or load
									show .team-activity-row
										when its textContent.toLowerCase().normalize('NFD')
										contains my value.toLowerCase().normalize('NFD')
									if my value's length > 0 then
										remove .invisible from #clear-search-activity
									else
										add .invisible to #clear-search-activity
									end
								end
								"
							/>
							<button
								id="clear-search-activity"
								role="button"
								class="btn btn-ghost btn-xs btn-circle invisible -mr-2"
								type="reset"
								_="
									init if #search-teams-activity's value's length > 0 then
										remove .invisible from me
									end
									on click
										set #search-teams-activity's value to ''
										add .invisible to me
										send input to #search-teams-activity
									end
								"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x w-4 h-4 opacity-80 hover:opacity-100"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
							</button>
						</label>
					</div>
					<div class="overflow-x-auto -mx-2 px-2">
						<table
							id="team-activity"
							class="table row-table w-full h-auto self-start"
							hx-get="/admin/activity/runs"
							hx-target="#team-activity"
							hx-swap="outerHTML"
							hx-trigger="load"
						></table>
					</div>
				</div>
			</div>
		</div>
		@JustNowSlot(quest, false)
	</div>
	@announcementModal()
	@teamModal()
}

// JustNowSlot is empty unless the game is live, so the leaderboard keeps the
// row to itself. Start and Stop swap it out-of-band.
templ JustNowSlot(quest models.Quest, oob bool) {
	<div
		id="just-now"
		class="min-w-0"
		if oob {
			hx-swap-oob="true"
		}
	>
		if quest.GetStatus() == models.Active {
			<section class="card panel feed">
				<div class="card-body p-5">
					<h2 class="card-title text-2xl font-extrabold">Just now</h2>
					<div
						hx-get="/admin/activity/recent"
						hx-trigger="load, every 10s"
						hx-swap="innerHTML"
					></div>
				</div>
			</section>
		}
		@agoScript()
	</div>
}

// Outside the live branch: the slot is swapped in when the game starts, and the
// guard stops that stacking timers.
templ agoScript() {
	<script>
		(function () {
			if (window.__tickAgo) return;
			window.__tickAgo = true;
			function ago(from) {
				var s = Math.max(0, Math.floor((Date.now() - new Date(from)) / 1000));
				if (s < 5) return 'just now';
				if (s < 60) return s + ' seconds ago';
				var m = Math.floor(s / 60);
				if (m < 60) return m + (m === 1 ? ' minute ago' : ' minutes ago');
				var h = Math.floor(m / 60);
				if (h < 24) return h + (h === 1 ? ' hour ago' : ' hours ago');
				var d = Math.floor(h / 24);
				return d + (d === 1 ? ' day ago' : ' days ago');
			}
			setInterval(function () {
				document.querySelectorAll('time[data-ago]').forEach(function (el) {
					var text = ago(el.getAttribute('datetime'));
					if (el.textContent !== text) el.textContent = text;
				});
			}, 1000);
		})();
	</script>
}

func feedIcon(kind services.RunLogKind) string {
	switch kind {
	case services.RunLogAnswer:
		return "check"
	case services.RunLogSection:
		return "flag"
	case services.RunLogUpload:
		return "camera"
	case services.RunLogFinish:
		return "trophy"
	case services.RunLogStart:
		return "play"
	}
	return "circle"
}

// Green is points earned, amber is a section closed or the finish, as on the run page.
func feedTone(entry services.ActivityEntry) string {
	switch {
	case entry.Kind == services.RunLogSection || entry.Kind == services.RunLogFinish:
		return "event-gold"
	case entry.Kind == services.RunLogAnswer:
		return "event-ok"
	}
	return ""
}

func feedWho(entry services.ActivityEntry) string {
	if entry.RunName != "" {
		return entry.RunName
	}
	return entry.RunCode
}

func feedWhat(entry services.ActivityEntry) string {
	switch entry.Kind {
	case services.RunLogAnswer:
		if entry.Title != "" {
			return entry.BlockName + " in " + entry.Title
		}
		return entry.BlockName
	case services.RunLogSection:
		if entry.Title != "" {
			return "Closed out " + entry.Title
		}
		return "Closed out a section"
	case services.RunLogUpload:
		return "Added a photo"
	case services.RunLogFinish:
		return "Finished the quest"
	case services.RunLogStart:
		return "Started playing"
	}
	return ""
}

templ RecentActivity(entries []services.ActivityEntry, enablePoints bool) {
	if len(entries) == 0 {
		<p class="empty">Nothing yet. Teams appear here as they play.</p>
	} else {
		<ul class="feed-list" hx-boost="true">
			for _, entry := range entries {
				<li>
					<a href={ templ.URL("/admin/runs/" + entry.RunCode) } class={ "event", feedTone(entry) }>
						<span class="event-ico">
							@icon(feedIcon(entry.Kind), templ.Attributes{"class": "w-4 h-4"})
						</span>
						<span class="min-w-0">
							<b class="block truncate">{ feedWho(entry) }</b>
							<small class="block truncate">{ feedWhat(entry) }</small>
						</span>
						<span class="event-r">
							if enablePoints && entry.Points > 0 {
								<b>+{ fmt.Sprint(entry.Points) }</b>
							}
							<small><time datetime={ entry.Time.UTC().Format(time.RFC3339) } data-ago>{ timeago.Parse(entry.Time) }</time></small>
						</span>
					</a>
				</li>
			}
		</ul>
	}
}

templ teamModal() {
	<dialog id="team_modal" class="modal modal-bottom sm:modal-middle">
		<div class="modal-box">
			<!-- Contents will be replaced by the fetched content -->
		</div>
	</dialog>
	<script>
	document.getElementById("team_modal").addEventListener('htmx:afterSwap', (evt) => {
	  // Open the modal once the content is loaded and swapped
	  document.getElementById("team_modal").showModal();
	});
	</script>
}

// runProgressBar draws how far along a run is: the share of what it owes that
// it has done, never a raw count, because two runs on one quest need not be
// the same length and a count would compare lengths rather than progress.
templ runProgressBar(done, total int) {
	{{ pct := 0 }}
	if total > 0 {
		{{ pct = done * 100 / total }}
	}
	<div class="flex items-center gap-2">
		<progress
			class={ "progress w-24", templ.KV("progress-success", total > 0 && done >= total), templ.KV("progress-primary", total > 0 && done < total) }
			value={ fmt.Sprint(pct) }
			max="100"
		></progress>
		<span class="text-xs tabular-nums">{ fmt.Sprintf("%d%%", pct) }</span>
	</div>
}

templ ActivityTeamsTable(settings models.QuestSettings, objectiveCount int, leaderboardData []services.LeaderBoardTeamData, unusedCodes int, currentSortField string, currentSortOrder string) {
	<div class="overflow-x-auto">
		<table
			id="team-activity"
			class="table row-table w-full mt-5 md:mt-0 h-auto self-start"
			hx-get={ fmt.Sprintf("/admin/activity/runs?sort=%s&order=%s", currentSortField, currentSortOrder) }
			hx-target="#team-activity"
			hx-swap="outerHTML"
			hx-trigger="every 30s"
			_="init send input to #search-teams-activity"
		>
			<!-- head -->
			<thead class="uppercase text-xs font-extrabold tracking-widest">
				<tr>
					<th class="text-center">
						@sortableHeader("rank", "Rank", currentSortField, currentSortOrder, true)
					</th>
					<th>
						@sortableHeader("code", "Code", currentSortField, currentSortOrder, false)
					</th>
					<th>
						@sortableHeader("name", "Name", currentSortField, currentSortOrder, false)
					</th>
					if settings.EnablePoints {
						<th>
							@sortableHeader("points", "Points", currentSortField, currentSortOrder, false)
						</th>
					}
					<th>
						@sortableHeader("last_seen", "Last Seen", currentSortField, currentSortOrder, false)
					</th>
					<th>
						@sortableHeader("progress", "Progress", currentSortField, currentSortOrder, false)
					</th>
					<th>
						@sortableHeader("status", "Status", currentSortField, currentSortOrder, false)
					</th>
				</tr>
			</thead>
			<tbody
				id="contents"
				class="overflow-x-hidden"
				hx-disinherit="*"
			>
				for _, teamData := range leaderboardData {
					<tr
						class="team-activity-row cursor-pointer"
						hx-get={ templ.URL(fmt.Sprintf("/admin/runs/%s", teamData.Code)) }
						hx-target="body"
						hx-swap="outerHTML"
						hx-push-url="true"
					>
						<td class="text-center">
							switch teamData.Rank {
								case 1:
									<span class="text-2xl">🥇</span>
								case 2:
									<span class="text-2xl">🥈</span>
								case 3:
									<span class="text-2xl">🥉</span>
								default:
									<span class="text-xl">{ fmt.Sprint(teamData.Rank) }</span>
							}
						</td>
						<td class="font-mono tracking-wider">
							{ models.FormatRunCode(teamData.Code) }
						</td>
						if teamData.Name != "" {
							<td>{ teamData.Name }</td>
						} else {
							<td><em class="opacity-50">No name set</em></td>
						}
						if settings.EnablePoints {
							<td>{ fmt.Sprint(teamData.Points) }</td>
						}
						<td>
							if !teamData.LastSeen.IsZero() {
								<span class="tooltip" data-tip={ teamData.LastSeen.Local().Format("02 Jan 03:04 PM") }>
									{ timeago.Parse(teamData.LastSeen) }
								</span>
							} else {
								<em class="opacity-50">No activity yet</em>
							}
						</td>
						<td>
							if objectiveCount > 0 {
								@runProgressBar(teamData.Progress, teamData.Total)
							} else {
								<em class="opacity-50">No objectives</em>
							}
						</td>
						<td>
							@TeamStatusBadge(teamData.Status, true, "sm")
						</td>
					</tr>
				}
				if len(leaderboardData) == 0 {
					<tr>
						<td colspan="7" class="text-center py-5">
							@activityEmptyAdvice(unusedCodes)
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// activityEmptyAdvice says what to do about an empty table, which depends on
// whether there is anything to hand out: codes already waiting need sharing,
// and with none there is nothing to share until some are made.
templ activityEmptyAdvice(unusedCodes int) {
	if unusedCodes > 0 {
		<p>
			Nobody has joined yet. 
			if unusedCodes == 1 {
				You have one unused code ready to share.
			} else {
				You have { fmt.Sprint(unusedCodes) } unused codes ready to share.
			}
		</p>
		<a href="/admin/runs" class="link link-primary font-semibold">See your codes</a>
	} else {
		<p>There are no runs yet, and players join with a run code.</p>
		<a href="/admin/runs?add" class="link link-primary font-semibold">Make codes to share</a>
	}
}

const (
	secondsPerMinute = 60
	secondsPerHour   = 3600
	secondsPerDay    = 86400
)

func gameEndScheduled(quest models.Quest) bool {
	return !quest.EndTime.IsZero() && quest.EndTime.After(quest.StartTime.Time)
}

func gameCountdown(quest models.Quest) (time.Time, string) {
	switch quest.GetStatus() {
	case models.Scheduled:
		return quest.StartTime.Time, "Opens in"
	case models.Active:
		if gameEndScheduled(quest) {
			return quest.EndTime.Time, "Closes in"
		}
	case models.Closed:
	}
	return time.Time{}, ""
}

func countdownParts(target time.Time) (days, hours, minutes, seconds int) {
	left := max(int(time.Until(target).Seconds()), 0)
	return left / secondsPerDay, left % secondsPerDay / secondsPerHour, left % secondsPerHour / secondsPerMinute, left % secondsPerMinute
}

// The whole card is swapped on a state change, so every control over the state lives in it.
templ GameControl(quest models.Quest, messages ...flash.Message) {
	for _, msg := range messages {
		@Toast(msg)
	}
	{{ status := quest.GetStatus() }}
	{{ iconName, _, _ := questStatusLook(quest) }}
	{{ endSet := gameEndScheduled(quest) }}
	{{ target, countdownLabel := gameCountdown(quest) }}
	<div
		id="schedule-status"
		class={ "panel game", templ.KV("game-open", status == models.Active), templ.KV("game-scheduled", status == models.Scheduled) }
	>
		<div class="game-main">
			<span class="game-chipw">
				<span class="game-chip">
					@icon(iconName, templ.Attributes{"class": "w-7 h-7"})
				</span>
			</span>
			<div class="game-text">
				switch status {
					case models.Active:
						<h2>The game is open</h2>
						if endSet {
							<p>It closes by itself at <time datetime={ quest.EndTime.Time.UTC().Format(time.RFC3339) } data-local>{ quest.EndTime.Time.Local().Format("Mon 2 Jan, 3:04pm") }</time>.</p>
						} else {
							<p>Teams can start playing. It stays open until you stop it.</p>
						}
					case models.Scheduled:
						<h2>
							<time datetime={ quest.StartTime.Time.UTC().Format(time.RFC3339) } data-starts-at>{ startsAt(quest) }</time>
						</h2>
						if endSet {
							<p>It closes at <time datetime={ quest.EndTime.Time.UTC().Format(time.RFC3339) } data-local>{ quest.EndTime.Time.Local().Format("Mon 2 Jan, 3:04pm") }</time>. Start now to open it early.</p>
						} else {
							<p>Start now to open it early.</p>
						}
					case models.Closed:
						<h2>The game is closed</h2>
						<p>Nobody can start a run. Start it now, or set a time.</p>
				}
			</div>
			if !target.IsZero() {
				{{ days, hours, minutes, seconds := countdownParts(target) }}
				<div class="game-cdw">
					<span class="kicker">{ countdownLabel }</span>
					<div class="game-cd" role="timer" data-countdown={ target.UTC().Format(time.RFC3339) }>
						<span><b data-u="d">{ fmt.Sprint(days) }</b>days</span>
						<span><b data-u="h">{ fmt.Sprint(hours) }</b>hrs</span>
						<span><b data-u="m">{ fmt.Sprint(minutes) }</b>min</span>
						<span><b data-u="s">{ fmt.Sprint(seconds) }</b>sec</span>
					</div>
				</div>
			}
			<div class="game-act">
				switch status {
					case models.Active:
						<button type="button" class="btn btn-error" hx-get="/admin/schedule/stop" hx-target="#schedule-status" hx-swap="outerHTML">
							@icon("square", templ.Attributes{"class": "w-5 h-5"})
							Stop
						</button>
					case models.Scheduled:
						<button type="button" class="btn btn-primary" hx-get="/admin/schedule/start" hx-target="#schedule-status" hx-swap="outerHTML">
							@icon("play", templ.Attributes{"class": "w-5 h-5"})
							Start now
						</button>
					case models.Closed:
						<button type="button" class="btn btn-primary" hx-get="/admin/schedule/start" hx-target="#schedule-status" hx-swap="outerHTML">
							@icon("play", templ.Attributes{"class": "w-5 h-5"})
							Start
						</button>
				}
				<button type="button" class="btn" data-schedule-toggle aria-expanded="false" aria-controls="schedule-form">
					@icon("calendar-clock", templ.Attributes{"class": "w-5 h-5"})
					if status == models.Closed || (status == models.Active && !endSet) {
						Schedule
					} else {
						Edit schedule
					}
				</button>
			</div>
		</div>
		<form
			id="schedule-form"
			class="game-sched hidden"
			hx-post="/admin/schedule/"
			hx-target="#schedule-status"
			hx-swap="outerHTML"
			data-start={ quest.StartTime.Format("2006-01-02 15:04") }
			data-end={ quest.EndTime.Format("2006-01-02 15:04") }
		>
			@scheduleRow("start", "Start", "Opens the game by itself.", !quest.StartTime.IsZero())
			@scheduleRow("end", "End", "Closes it by itself.", endSet)
			<input type="hidden" name="utc_start_date"/>
			<input type="hidden" name="utc_start_time"/>
			<input type="hidden" name="utc_end_date"/>
			<input type="hidden" name="utc_end_time"/>
			<div class="game-foot">
				<small>Times are in your time zone.</small>
				<span class="grow"></span>
				<button type="button" class="btn" data-schedule-toggle>Cancel</button>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
		@gameControlScript()
	</div>
}

templ scheduleRow(key, label, hint string, on bool) {
	<div class="game-row">
		<label class="flex items-center gap-3 font-bold">
			<input type="checkbox" name={ "set_" + key } class="toggle toggle-primary" checked?={ on }/>
			{ label }
		</label>
		<input type="date" name={ key + "_date" } class="input" aria-label={ label + " date" }/>
		<input type="time" name={ key + "_time" } class="input" aria-label={ label + " time" }/>
		<small>{ hint }</small>
	</div>
}

// Swapped in with the card, so listeners install once and each swap only re-runs boot.
templ gameControlScript() {
	<script>
		(function () {
			function boot() {
				document.querySelectorAll('time[data-local]').forEach(function (el) {
					el.textContent = new Date(el.getAttribute('datetime')).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
				});
				tick();
			}
			function tick() {
				document.querySelectorAll('[data-countdown]').forEach(function (box) {
					var left = Math.floor((new Date(box.dataset.countdown) - Date.now()) / 1000);
					if (left <= 0) { window.location.reload(); return; }
					var v = { d: Math.floor(left / 86400), h: Math.floor(left % 86400 / 3600), m: Math.floor(left % 3600 / 60), s: left % 60 };
					Object.keys(v).forEach(function (k) { box.querySelector('[data-u="' + k + '"]').textContent = v[k]; });
				});
			}
			if (window.__gameControl) { window.__gameControl(); return; }
			window.__gameControl = boot;

			function fromUTC(date, time) {
				var u = new Date(date + 'T' + time + ':00Z');
				var iso = new Date(u.getTime() - u.getTimezoneOffset() * 60000).toISOString();
				return { date: iso.slice(0, 10), time: iso.slice(11, 16) };
			}
			function toUTC(date, time) {
				var iso = new Date(date + 'T' + time).toISOString();
				return { date: iso.slice(0, 10), time: iso.slice(11, 16) };
			}
			function populate(form) {
				['start', 'end'].forEach(function (k) {
					var v = (form.dataset[k] || '').split(' ');
					if (v[0] && v[0] !== '0001-01-01') {
						var l = fromUTC(v[0], v[1]);
						form.elements[k + '_date'].value = l.date;
						form.elements[k + '_time'].value = l.time;
					}
				});
			}
			function sync(form) {
				['start', 'end'].forEach(function (k) {
					var on = form.elements['set_' + k].checked;
					var d = form.elements[k + '_date'], t = form.elements[k + '_time'];
					d.disabled = t.disabled = !on;
					var u = on && d.value && t.value ? toUTC(d.value, t.value) : { date: '', time: '' };
					form.elements['utc_' + k + '_date'].value = u.date;
					form.elements['utc_' + k + '_time'].value = u.time;
				});
			}

			document.addEventListener('click', function (e) {
				if (!e.target.closest('[data-schedule-toggle]')) return;
				var form = document.getElementById('schedule-form');
				var open = !form.classList.toggle('hidden');
				document.querySelectorAll('[data-schedule-toggle][aria-expanded]').forEach(function (b) { b.setAttribute('aria-expanded', open); });
				if (open) { populate(form); sync(form); }
			});
			document.addEventListener('change', function (e) {
				var form = e.target.closest('#schedule-form');
				if (form) sync(form);
			});
			document.addEventListener('submit', function (e) {
				if (e.target.id === 'schedule-form') sync(e.target);
			}, true);
			document.addEventListener('htmx:afterSwap', boot);
			setInterval(tick, 1000);
			boot();
		})();
	</script>
}

templ RunActivity(settings models.QuestSettings, team models.Run, notifications []models.Notification, incompleteObjectives []models.Objective, completedObjectives []models.Objective) {
	<h3 class="text-lg font-bold">
		{ models.FormatRunCode(team.Code) }
		if team.Name != "" {
			<span class="opacity-50">∕</span> { team.Name }
		}
		if settings.EnablePoints {
			<span class="badge badge-info badge-sm">{ fmt.Sprint(team.Points) } pts</span>
		}
	</h3>
	<!-- Outstanding objectives -->
	<div class="w-full">
		<p class="py-3 font-bold divider divider-start">Outstanding objectives</p>
		if len(incompleteObjectives) > 0 {
			<div class="prose">
				<ul>
					for _, objective := range incompleteObjectives {
						<li>
							{ objective.Title }
						</li>
					}
				</ul>
			</div>
		} else {
			<p>All done!</p>
		}
	</div>
	<!-- Completed objectives -->
	if len(completedObjectives) > 0 {
		<div class="py-3 font-bold divider divider-start">
			Completed objectives
		</div>
		<div class="prose">
			<ul>
				for _, objective := range completedObjectives {
					<li>
						{ objective.Title }
					</li>
				}
			</ul>
		</div>
	}
	<p class="py-3 font-bold divider divider-start">
		Alerts
	</p>
	if len(notifications) > 0 {
		for _, notification := range notifications {
			<div class="chat chat-start">
				<div class="chat-bubble">{ notification.Content }</div>
				<div class="chat-footer text-xs opacity-50 flex items-center gap-2">
					if notification.Dismissed {
						Read
					} else {
						Unread
					}
					·
					<time>{ fmt.Sprint("Sent ", notification.CreatedAt.Local().Format("02 Jan 03:04 PM")) }</time>
				</div>
			</div>
		}
	}
	<label class="form-control w-full mt-3">
		<form hx-post="/admin/notify/team/" hx-swap="none">
			<input type="hidden" name="runCode" value={ team.Code }/>
			<div class="join w-full">
				<input class="input join-item w-full" name="content" placeholder="Message" autocomplete="off" autofocus="off" required/>
				<button type="submit" class="btn btn-primary join-item rounded-r-full" onclick="announcement_modal.close()">
					Send
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send-horizontal w-5 h-5"><path d="m3 3 3 9-3 9 19-9Z"></path><path d="M6 12h16"></path></svg>
				</button>
			</div>
		</form>
		<div class="label">
			<span class="label-text-alt">This is a read-only message. Teams cannot reply.</span>
		</div>
	</label>
	<div class="modal-action">
		<form method="dialog">
			<!-- if there is a button in form, it will close the modal -->
			<button class="btn">Close</button>
		</form>
	</div>
	<form method="dialog">
		<button
			class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
		>✕</button>
	</form>
}

templ announcementModal() {
	<dialog id="announcement_modal" class="modal modal-bottom sm:modal-middle">
		<div class="modal-box">
			<h3 class="text-lg font-bold">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-megaphone inline-block w-5 h-5 mb-1 mr-2"><path d="m3 11 18-5v12L3 14v-3z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path></svg>
				Announcement
			</h3>
			<p class="py-3">Send an announcement to all teams.</p>
			<form hx-post="/admin/notify/all" hx-swap="none">
				<textarea class="textarea w-full" name="content" placeholder="Announcement"></textarea>
				<p class="text-sm py-3"><em>Note:</em> This will only be sent to teams that have already started playing.</p>
				<div class="modal-action">
					<button class="btn" onclick="event.preventDefault(); announcement_modal.close()">Nevermind</button>
					<button class="btn btn-primary" onclick="announcement_modal.close()">Send</button>
				</div>
			</form>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
		</div>
	</dialog>
}

templ sortableHeader(field string, label string, currentSortField string, currentSortOrder string, center bool) {
	<span
		class={ "cursor-pointer inline-flex gap-1 items-center hover:text-primary transition-colors", templ.KV("justify-center", center) }
		hx-get={ getSortURL(field, currentSortField, currentSortOrder) }
		hx-target="#team-activity"
		hx-swap="outerHTML"
		title={ getSortTooltip(field, currentSortField, currentSortOrder) }
	>
		{ label }
		if currentSortField == field {
			if currentSortOrder == "desc" {
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down-icon lucide-arrow-down w-4 h-4"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
			} else {
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-icon lucide-arrow-up w-4 h-4"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
			}
		} else {
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-down w-4 h-4 opacity-40"><path d="m21 16-4 4-4-4"></path><path d="M17 20V4"></path><path d="m3 8 4-4 4 4"></path><path d="M7 4v16"></path></svg>
		}
	</span>
}

func getSortURL(field string, currentSortField string, currentSortOrder string) string {
	var newOrder string
	if currentSortField == field {
		// Reverse the order if clicking the same field
		if currentSortOrder == "desc" {
			newOrder = "asc"
		} else {
			newOrder = "desc"
		}
	} else {
		// Default order for new field - most fields default to descending except name/code
		if field == "name" || field == "code" {
			newOrder = "asc"
		} else {
			newOrder = "desc"
		}
	}
	return fmt.Sprintf("/admin/activity/runs?sort=%s&order=%s", field, newOrder)
}

func getSortTooltip(field string, currentSortField string, currentSortOrder string) string {
	if currentSortField == field {
		if currentSortOrder == "desc" {
			return fmt.Sprintf("Click to sort %s ascending", field)
		} else {
			return fmt.Sprintf("Click to sort %s descending", field)
		}
	} else {
		if field == "name" || field == "code" {
			return fmt.Sprintf("Click to sort by %s (ascending)", field)
		} else {
			return fmt.Sprintf("Click to sort by %s (descending)", field)
		}
	}
}

templ ActivityStats(quest models.Quest, summaries map[string]services.RunSummary) {
	<div
		id="activity-stats"
		hx-get="/admin/activity/stats"
		hx-target="#activity-stats"
		hx-swap="outerHTML"
		hx-trigger="every 30s"
		class="panel stat-strip"
	>
		<div class="stat-cell">
			<span class="kicker">Running</span>
			<b class="stat-num">{ fmt.Sprint(countRunning(quest.Runs, summaries)) }</b>
			<small>of { fmt.Sprint(len(quest.Runs)) } runs</small>
		</div>
		<div class="stat-cell">
			<span class="kicker">Not started</span>
			<b class="stat-num">{ fmt.Sprint(countNotStarted(quest.Runs)) }</b>
			<small>Codes not yet used</small>
		</div>
		<div class="stat-cell">
			<span class="kicker">Median progress</span>
			<b class="stat-num">{ fmt.Sprint(medianShare(quest.Runs, summaries)) }%</b>
			<small>Of each run's own objectives</small>
		</div>
		<div class="stat-cell">
			<span class="kicker">Finished</span>
			<b class="stat-num">{ fmt.Sprint(countFinished(quest.Runs, summaries)) }</b>
			<small>Reached the end</small>
		</div>
	</div>
}
