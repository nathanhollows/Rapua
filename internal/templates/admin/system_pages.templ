package templates

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
)

type EditPageData struct {
	Settings   models.QuestSettings
	PageBlocks blocks.Blocks
	PageTitle  string
	PageType   string
}

// SystemPageEditor is the Start or Complete page: what the linter says about it,
// then its blocks in the same editor an objective's proof and reveal use.
templ SystemPageEditor(lint services.QuestLint, pathPrefix string, data EditPageData) {
	{{ zone := getContextForPageType(data.PageType) }}
	<div class="obj-page" data-objective-editor data-points-enabled={ fmt.Sprint(data.Settings.EnablePoints) }>
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-5 pb-3">
			<h1 class="text-4xl font-black mr-auto">{ data.PageTitle } page</h1>
			<div class="tooltip tooltip-left" data-tip="System page. It cannot be deleted.">
				<span class="badge badge-ghost gap-1.5">
					@icon("lock", templ.Attributes{"class": "w-3 h-3", "width": "12", "height": "12"})
					System page
				</span>
			</div>
		</div>
		<div id="system-page-lint">
			@SystemPageLint(lint, pathPrefix)
		</div>
		@systemPageHints(data, zone)
		@blockSection(blockSectionData{
			Settings:   data.Settings,
			Zone:       zone,
			Blocks:     data.PageBlocks,
			OwnerID:    data.Settings.QuestID,
			PreviewURL: getPreviewURLForPageType(data.PageType),
		})
		@objectiveEditorAssets()
	</div>
}

// systemPageHints offers the blocks a page usually wants. The editor script
// shows each only while the page has no block of that type, so adding one
// makes its hint go away without asking the server.
templ systemPageHints(data EditPageData, zone blocks.BlockContext) {
	<div class="flex flex-col gap-2" data-hints>
		if data.PageType == "start" {
			@systemPageHint(data, zone, "game_status", "alert-warning", "Recommended: add a Game Status block to show game state to players.")
			@systemPageHint(data, zone, "start_button", "alert-warning", "Recommended: add a Start Button block so players can begin the game.")
		}
	</div>
}

// systemPageHint is only offered for a block the page can hold: a button that
// the server would refuse is worse than no hint.
templ systemPageHint(data EditPageData, zone blocks.BlockContext, blockType, tone, text string) {
	if blocks.CanBlockBeUsedInContext(blockType, zone) {
		@systemPageHintAlert(data, zone, blockType, tone, text)
	}
}

templ systemPageHintAlert(data EditPageData, zone blocks.BlockContext, blockType, tone, text string) {
	<div class={ "alert", tone } data-hint-for={ blockType } hidden>
		@icon("triangle-alert", templ.Attributes{"class": "w-5 h-5"})
		<span class="flex-1">{ text }</span>
		<form hx-post="/admin/blocks/" hx-target={ "#forms-" + zoneWordsFor(zone).Param } hx-swap="beforeend">
			<input type="hidden" name="owner" value={ data.Settings.QuestID }/>
			<input type="hidden" name="context" value={ string(zone) }/>
			<input type="hidden" name="type" value={ blockType }/>
			<button type="submit" class="btn btn-sm">Add block</button>
		</form>
	</div>
}

func getContextForPageType(pageType string) blocks.BlockContext {
	if pageType == "start" {
		return blocks.ContextStart
	}
	return blocks.ContextFinish
}

func getPreviewURLForPageType(pageType string) string {
	if pageType == "start" {
		return "/start"
	}
	return "/complete"
}
