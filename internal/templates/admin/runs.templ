package templates

import (
	"fmt"
	"github.com/SerhiiCho/timeago/v3"
	"github.com/nathanhollows/Rapua/v8/internal/config"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ TeamsTable(teams []models.Run) {
	<div class="card bg-base-200 border border-base-300 mx-5">
		<ul
			id="teams-ul"
			class="list"
			hx-boost="true"
			_="on htmx:afterSwap or htmx:afterSettle
			js(me)
				// Count checked checkboxes
				var checkedCount = document.querySelectorAll('input[name=team-checkbox]:checked').length;
				var allCheckboxes = document.querySelectorAll('input[name=team-checkbox]');

				// Update all selection count elements (including in modals)
				document.querySelectorAll('span').forEach(function(span) {
					var prev = span.previousSibling;
					if (prev && prev.textContent && prev.textContent.includes('Selected:')) {
						span.textContent = checkedCount;
					}
					// Also update counts in modal dialogs
					var parent = span.parentElement;
					if (parent && parent.innerHTML &&
						(parent.innerHTML.includes('reset') || parent.innerHTML.includes('delete'))) {
						var text = span.textContent;
						if (text && !isNaN(text.trim())) {
							span.textContent = checkedCount;
						}
					}
				});

				// Update select-all checkbox state
				var selectAll = document.getElementById('select-all');
				if (selectAll) {
					if (checkedCount === 0) {
						selectAll.checked = false;
						selectAll.indeterminate = false;
					} else if (checkedCount === allCheckboxes.length && allCheckboxes.length > 0) {
						selectAll.checked = true;
						selectAll.indeterminate = false;
					} else {
						selectAll.checked = false;
						selectAll.indeterminate = true;
					}
				}

				// Show/hide actions and filters bars
				var actions = document.getElementById('team-actions');
				var filters = document.getElementById('team-filters');
				if (checkedCount > 0) {
					if (actions) actions.classList.remove('hidden');
					if (filters) filters.classList.add('hidden');
				} else {
					if (actions) actions.classList.add('hidden');
					if (filters) filters.classList.remove('hidden');
				}
			end
		end"
		>
			<div class="flex flex-row items-center gap-3 px-6 py-4 border-b border-base-300">
				<!-- Select all -->
				<input
					id="select-all"
					type="checkbox"
					class="checkbox checkbox-sm checkbox-primary"
					_="on change or load
						set <.team-item:not(.hidden) input[name='team-checkbox']/>'s checked to my checked
						if my checked or my indeterminate
							add .hidden to #team-filters
							remove .hidden from #team-actions
						else
							add .hidden to #team-actions
							remove .hidden from #team-filters
						end
					end
					on change from <input[name='team-checkbox']/>
						if <input[name='team-checkbox']:checked/>'s length is not <input[name='team-checkbox']/>'s length
							set my indeterminate to true
						end
						if <input[name='team-checkbox']:checked/>'s length is 0
							set my indeterminate to false
							set my checked to false
						end
						if <input[name='team-checkbox']:checked/>'s length is <input[name='team-checkbox']/>'s length
							set my indeterminate to false
							set my checked to true
						end
						if my checked or my indeterminate
							add .hidden to #team-filters
							remove .hidden from #team-actions
						else
							add .hidden to #team-actions
							remove .hidden from #team-filters
						end
					end
					on htmx:afterRequest from #delete-confirm
						wait 0.5s
						if me.checked
							set me.checked to false
							set me.indeterminate to false
							remove .hidden from #team-filters
							add .hidden to #team-actions
						end
					end
					"
				/>
				<div id="team-actions" class="hidden flex flex-row flex-grow gap-3 items-center justify-between">
					<span class="font-bold text-base-content text-sm">
						Selected: 
						<span
							class="font-bold text-base-content/60"
							_="on change from <input[type='checkbox']/> or load
							set my textContent to <input[name='team-checkbox']:checked/>'s length"
						></span>
					</span>
					<div class="flex flex-row gap-2">
						<button
							class="btn btn-sm btn-outline"
							_="on click
						set list to []
						repeat for x in <input[name='team-checkbox']:checked/>
							append x's value to list
						end
						writeText(list.join('\n')) on navigator.clipboard
						set copyText to my innerHTML
						set my textContent to 'Copied!'
						wait 1.5s
						set my innerHTML to copyText
					"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-copy w-4 h-4"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path><path d="M16 4h2a2 2 0 0 1 2 2v4"></path><path d="M21 14H11"></path><path d="m15 10-4 4 4 4"></path></svg>
							Copy Codes
						</button>
					</div>
				</div>
				<div id="team-filters" class="flex flex-grow flex-row justify-between">
					<!-- Active/Inactive count -->
					<div class="filter">
						<input
							class="btn btn-sm filter-reset"
							type="radio"
							name="activefilter"
							aria-label="All"
							_="
							on click remove .hidden from <.team-item/>
						"
						/>
						<input
							class="btn btn-sm"
							type="radio"
							name="activefilter"
							aria-label="Active Only"
							_="
						on change
							if my checked
								remove .hidden from <.team-item/>
								add .hidden to <.team-item.inactive/>
							end
						"
						/>
						<input
							class="btn btn-sm"
							type="radio"
							name="activefilter"
							aria-label="Inactive Only"
							_="
						on change
							if my checked
								remove .hidden from <.team-item/>
								add .hidden to <.team-item.active/>
							end
						"
						/>
					</div>
					<div class="flex flex-row gap-2">
						<button
							class="btn btn-sm btn-outline"
							_="on click
						set list to []
						repeat for x in <input[name='team-checkbox']/>
							if x's offsetParent is not null
								append x's value to list
							end
						end
						writeText(list.join('\n')) on navigator.clipboard
						set copyText to my innerHTML
						set my textContent to 'Copied!'
						wait 1.5s
						set my innerHTML to copyText
					"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-copy w-4 h-4"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path><path d="M16 4h2a2 2 0 0 1 2 2v4"></path><path d="M21 14H11"></path><path d="m15 10-4 4 4 4"></path></svg>
							Copy Codes
						</button>
					</div>
				</div>
				<!-- Search -->
				<label class="input input-sm flex items-center gap-2 w-60">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search w-5 h-5"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
					<input
						id="search-teams"
						type="text"
						class="grow"
						placeholder="Search"
						_="
					init send input to me
					on input
						show .team-item
							when its textContent.toLowerCase().normalize('NFD')
							contains my value.toLowerCase().normalize('NFD')
						if my value's length > 0 then
							remove .invisible from #clear-search
						else
							add .invisible to #clear-search
						end
					end
					"
					/>
					<button
						id="clear-search"
						role="button"
						class="btn btn-ghost btn-xs btn-circle invisible -mr-2"
						type="reset"
						_="
						init if #search-teams's value's length > 0 then
							remove .invisible from me
						end
						on click
							set #search-teams's value to ''
							add .invisible to me
							send input to #search-teams
						end
					"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x w-4 h-4 opacity-80 hover:opacity-100"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
					</button>
				</label>
			</div>
			for _, team := range filter(teams, func(team models.Run) bool { return team.HasStarted }) {
				@teamItem(team, "active")
			}
			for _, team := range filter(teams, func(team models.Run) bool { return !team.HasStarted }) {
				@teamItem(team, "inactive")
			}
		</ul>
		<div id="teams-list">
			<div
				if len(teams) == 0 {
					class="no-teams px-6 py-8 text-center border-t border-base-300 rounded-b-box"
				} else {
					class="no-teams px-6 py-8 text-center border-t border-base-300 rounded-b-box hidden"
				}
				_="on htmx:afterSettle from body
				if <.team-item/>'s length == 0
					remove .hidden from me
				else
					add .hidden to me
				end
				on htmx:afterRequest from body
					wait 0.5s
					if <.team-item/>'s length == 0
						remove .hidden from me
					else
						add .hidden to me
					end
				"
			>
				<p class="text-sm opacity-60">
					No runs yet. Do you want to <a href="#" class="link" onclick="add_teams_modal.showModal()">add some</a>?
				</p>
			</div>
		</div>
	</div>
}

templ TeamsList(teams []models.Run) {
	for _, team := range teams {
		@teamItem(team, "inactive")
	}
}

templ teamItem(team models.Run, classes string) {
	<li class={ fmt.Sprint("team-item border-t border-base-300 transition-colors last:rounded-b-box hover:bg-base-300 has-[:checked]:bg-primary/10 has-[:checked]:hover:bg-primary/20 ", classes) }>
		<div class="flex flex-row items-center gap-3 px-6 py-3">
			<input
				name="team-checkbox"
				type="checkbox"
				class="team-checkbox checkbox checkbox-sm checkbox-primary"
				value={ team.Code }
				_="on htmx:afterRequest from #delete-confirm
					if me.checked
						add .bg-danger .text-danger-content to closest .team-item
						transition opacity to 0 then
						remove the closest .team-item
					end
				end
				on change
					js(me)
						var checkedCount = document.querySelectorAll('input[name=team-checkbox]:checked').length;
						var allCheckboxes = document.querySelectorAll('input[name=team-checkbox]');
						var selectAll = document.getElementById('select-all');

						// Update selection counts
						document.querySelectorAll('span').forEach(function(span) {
							var prev = span.previousSibling;
							if (prev && prev.textContent && prev.textContent.includes('Selected:')) {
								span.textContent = checkedCount;
							}
						});

						// Update select-all state
						if (selectAll) {
							if (checkedCount === 0) {
								selectAll.checked = false;
								selectAll.indeterminate = false;
							} else if (checkedCount === allCheckboxes.length && allCheckboxes.length > 0) {
								selectAll.checked = true;
								selectAll.indeterminate = false;
							} else {
								selectAll.checked = false;
								selectAll.indeterminate = true;
							}
						}

						// Show/hide actions and filters
						var actions = document.getElementById('team-actions');
						var filters = document.getElementById('team-filters');
						if (checkedCount > 0) {
							if (actions) actions.classList.remove('hidden');
							if (filters) filters.classList.add('hidden');
						} else {
							if (actions) actions.classList.add('hidden');
							if (filters) filters.classList.remove('hidden');
						}
					end
				end
				"
			/>
			<!-- Location code -->
			<div
				class="tooltip cursor-pointer"
				data-tip="Click to copy"
				_="on click 
					writeText(my textContent) on navigator.clipboard
					set @data-tip to 'Copied!'
					wait 2s
					set @data-tip to 'Click to copy'
					"
			>
				if team.HasStarted {
					<span class="team-code badge badge-success badge-outline font-mono tracking-wider">{ team.Code }</span>
				} else {
					<span class="team-code badge font-mono tracking-wider">{ team.Code }</span>
				}
			</div>
			<!-- Run name -->
			if team.Name == "" {
				<em class="opacity-50 truncate grow">No name set</em>
			} else {
				<span class="truncate grow">{ team.Name }</span>
			}
			<!-- CheckIns are not loaded here, so "finished" is not knowable. -->
			if !team.HasStarted {
				<span class="badge badge-ghost badge-sm shrink-0">Not started</span>
			} else if team.MustCheckOut != "" {
				<span class="badge badge-accent badge-sm shrink-0">Onsite</span>
			} else {
				<span class="badge badge-success badge-soft badge-sm shrink-0">Playing</span>
			}
			// Relative, not elapsed: a stale run otherwise reads "111d 21h".
			if team.HasStarted && !team.StartedAt.IsZero() {
				<span
					class="text-xs whitespace-nowrap shrink-0 tooltip tooltip-left hidden sm:inline"
					data-tip={ team.StartedAt.Local().Format("02 Jan 2006, 3:04 PM") }
				>
					<span class="opacity-50">{ timeago.Parse(team.StartedAt) }</span>
				</span>
			}
			if team.HasStarted {
				<a
					href={ templ.URL(fmt.Sprintf("/admin/runs/%s", team.Code)) }
					class="btn btn-xs shrink-0"
				>
					See activity
				</a>
			}
		</div>
	</li>
}

templ Teams(teams []models.Run, credits int) {
	<span class="hidden bg-danger text-danger-content border-error border-warning"></span>
	<div class="flex gap-3 flex-row justify-between items-center w-full p-5">
		<h1 class="text-2xl font-bold">
			Runs
			<div class="dropdown dropdown-hover">
				<div tabindex="0" role="button" class="btn btn-circle btn-ghost btn-xs text-info"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 lucide lucide-info"><circle cx="12" cy="12" r="10"></circle><path d="m12 16v-4"></path><path d="m12 8h.01"></path></svg></div>
				<div tabindex="0" class="card compact dropdown-content font-normal bg-base-200 rounded-box z-[1] w-72 shadow">
					<div tabindex="0" class="card-body">
						<h2 class="card-title">Runs</h2>
						<p>
							A run is one playthrough. It can be played by an individual or by a group sharing a single device, using a unique run code.
						</p>
						<p>
							Progress is tracked per run, whether played by an individual or a group.
						</p>
						<p>
							Run codes are randomly generated. Players can name their run when they start playing.
						</p>
					</div>
				</div>
			</div>
		</h1>
		<a
			href="/admin/settings/credits"
			if credits <= 0 {
				class="badge badge-error tooltip tooltip-bottom"
				data-tip="No credits remaining! New runs won't be able to start."
			}
			else
			if credits >= 5 {
				class="badge badge-info tooltip tooltip-bottom"
				data-tip="Each run start costs one credit. Credits do not affect how many run codes you can generate."
			} else {
				class="badge badge-warning tooltip tooltip-bottom"
				data-tip="Low on credits! Each run start costs one credit. Credits do not affect how many run codes you can generate."
			}
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info w-4"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
			{ fmt.Sprint(credits) } credits remaining
		</a>
		<div class="flex gap-3">
			<button
				class="btn btn-secondary"
				onclick="add_teams_modal.showModal()"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>
				Add runs
			</button>
		</div>
	</div>
	<div id="teams-table">
		@TeamsTable(teams)
	</div>
	<!-- Modal for adding runs -->
	<dialog
		id="add_teams_modal"
		class="modal modal-bottom sm:modal-middle"
	>
		<div class="modal-box">
			<h3 class="font-bold text-lg">Quick add runs</h3>
			<p class="py-4">How many runs would you like to add?</p>
			<form
				hx-post="/admin/runs/add"
				hx-target="#teams-ul"
				hx-swap="beforeend swap:0.5s"
				class="join flex flex-row w-full"
			>
				<input
					name="count"
					type="number"
					id="count"
					class="input join-item flex-grow"
					placeholder="1+"
					min="1"
					step="1"
					value="10"
				/>
				<button class="btn btn-primary join-item" onclick="add_teams_modal.close()">Add runs</button>
			</form>
			<div class="modal-action">
				<form method="dialog">
					<button class="btn">Nevermind</button>
				</form>
			</div>
			<form method="dialog">
				<button
					class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
				>✕</button>
			</form>
		</div>
	</dialog>
	@teamModal()
}

// TeamOverviewData contains all data needed to render the run overview page.
type TeamOverviewData struct {
	Quest                models.Quest
	Run                  models.Run
	Notifications        []models.Notification
	IncompleteObjectives []models.Objective
	Uploads              []*models.Upload
	TotalObjectives      int
	ObjectiveGroups      map[string]services.ObjectiveGroupInfo
}

templ TeamOverview(data TeamOverviewData) {
	<main class="max-w-7xl m-auto pb-8">
		<!-- Header -->
		<div class="flex flex-col sm:flex-row gap-3 justify-between items-center w-full p-5">
			<div class="mr-auto">
				<h1 class="text-2xl font-bold">Run overview</h1>
				<p class="text-sm text-base-content/60">
					<span class="font-mono tracking-wider">{ data.Run.Code }</span>
					if data.Run.Name != "" {
						<span class="opacity-50 mx-1">∕</span>
						{ data.Run.Name }
					}
				</p>
			</div>
			<div class="flex gap-3">
				<button
					class="btn btn-warning"
					_="on click
							confirm_reset_modal.showModal()
						end
					"
				>
					@icon("history", templ.Attributes{"class": "w-5 h-5"})
					Reset
				</button>
				<button
					class="btn btn-error"
					_="on click
							confirm_delete_modal.showModal()
						end
					"
				>
					@icon("trash-2", templ.Attributes{"class": "w-5 h-5"})
					Delete
				</button>
			</div>
		</div>
		<div class="px-5 mb-5">
			@RunStatsCard(data.Quest.Settings, data.Run, data.TotalObjectives-len(data.IncompleteObjectives), data.TotalObjectives)
		</div>
		<div class="relative flex flex-col-reverse lg:flex-row px-5 gap-5">
			<!-- Sidebar -->
			<div class="w-full lg:w-80 space-y-5 flex-shrink-0">
				@CurrentObjectivesCard(data.IncompleteObjectives, data.ObjectiveGroups, data.Run, data.TotalObjectives)
				@MessagesCard(data.Run, data.Notifications)
			</div>
			<!-- Main -->
			<div class="w-full flex-1 min-w-0 space-y-5">
				@RunTimelineCard(data.Quest.Settings, data.Run)
				if len(data.Uploads) > 0 {
					@UploadedMediaCard(data.Uploads, data.Run.Code)
				}
			</div>
		</div>
	</main>
	@TeamPageModals(data.Run.Code)
}

templ TeamPageModals(teamCode string) {
	<dialog id="confirm_reset_modal" class="modal">
		<div class="modal-box prose outline outline-2 outline-offset-1 outline-warning">
			<h3 class="text-lg font-bold">Reset run</h3>
			<p class="pt-4">
				You are about to reset this run. Doing this will wipe all related data including:
			</p>
			<ul>
				<li>the run name</li>
				<li>all related check-ins, points, activity progress, and media</li>
			</ul>
			<p>Credits are not restored if a run is reset.</p>
			<p>Only the run code will be kept. This action cannot be undone.</p>
			<form
				hx-post={ fmt.Sprintf("/admin/runs/%s/reset", teamCode) }
			>
				<input type="hidden" name="id" value=""/>
				<div class="modal-action">
					<button type="button" class="btn" onclick="confirm_reset_modal.close()">Nevermind</button>
					<button type="submit" class="btn btn-warning" onclick="confirm_reset_modal.close()">Reset</button>
				</div>
			</form>
		</div>
	</dialog>
	<dialog id="confirm_delete_modal" class="modal">
		<div class="modal-box prose outline outline-2 outline-offset-1 outline-error">
			<h3 class="text-lg font-bold">Delete run</h3>
			<p class="pt-4">
				You are about to delete this run. Doing this will wipe all data including:
			</p>
			<ul>
				<li>the run</li>
				<li>check-ins</li>
				<li>activity progress</li>
				<li>any uploaded media</li>
			</ul>
			<p>Credits are not restored if a run is deleted.</p>
			<p>This action cannot be undone.</p>
			<form
				hx-delete={ fmt.Sprintf("/admin/runs/%s", teamCode) }
			>
				<input type="hidden" name="id" value=""/>
				<div class="modal-action">
					<button type="button" class="btn" onclick="confirm_delete_modal.close()">Nevermind</button>
					<button id="delete-confirm" type="submit" class="btn btn-error" onclick="confirm_delete_modal.close()">Delete</button>
				</div>
			</form>
		</div>
	</dialog>
}

templ RunStatsCard(settings models.QuestSettings, run models.Run, completedObjectives int, totalObjectives int) {
	<div class="grid grid-cols-2 md:grid-cols-4 gap-0 shadow rounded-box w-full bg-gradient-to-br from-info/10 to-info/5 border border-info/20 hover:border-info/30 transition-colors overflow-hidden">
		<div class="stat place-items-center border-b md:border-b-0 md:border-r border-info/20">
			<div class="stat-title">Status</div>
			<div class="stat-value">
				@TeamStatusBadge(getTeamStatus(run, completedObjectives, totalObjectives), false, "lg")
			</div>
			<div class="stat-desc">
				if at, ok := runLastSeen(run); ok {
					Last seen { timeago.Parse(at) }
				} else {
					No activity yet
				}
			</div>
		</div>
		<div class="stat place-items-center border-b md:border-b-0 md:border-r border-info/20">
			<div class="stat-title">Objectives</div>
			<div class="stat-value">
				{ fmt.Sprint(completedObjectives) }<span class="text-base opacity-50">∕{ fmt.Sprint(totalObjectives) }</span>
			</div>
			<div class="stat-desc">Completed</div>
		</div>
		if settings.EnablePoints {
			<div class="stat place-items-center md:border-r border-info/20">
				<div class="stat-title">Points</div>
				<div class="stat-value">{ fmt.Sprint(run.Points) }</div>
				<div class="stat-desc">Across all objectives</div>
			</div>
		} else {
			<div class="stat place-items-center md:border-r border-info/20">
				<div class="stat-title">Progress</div>
				<div class="stat-value">
					if totalObjectives > 0 {
						{ fmt.Sprintf("%.0f%%", float64(completedObjectives)/float64(totalObjectives)*100) }
					} else {
						0%
					}
				</div>
				<div class="stat-desc">Towards completion</div>
			</div>
		}
		<div class="stat place-items-center">
			<div class="stat-title">Elapsed</div>
			<div class="stat-value">
				if elapsed := runElapsed(run); elapsed != "" {
					{ elapsed }
				} else {
					—
				}
			</div>
			<div class="stat-desc">
				if !run.StartedAt.IsZero() {
					Started { run.StartedAt.Local().Format("3:04 PM") }
				} else {
					Not started
				}
			</div>
		</div>
	</div>
}

templ CurrentObjectivesCard(incompleteObjectives []models.Objective, objectiveGroups map[string]services.ObjectiveGroupInfo, run models.Run, totalObjectives int) {
	<div class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors overflow-hidden">
		<div class="card-body p-6 pb-4">
			<div class="flex items-center justify-between mb-2">
				<h2 class="card-title text-lg flex items-center gap-2">
					@icon("target", templ.Attributes{"class": "w-5 h-5"})
					Current objectives
				</h2>
				if len(incompleteObjectives) > 0 {
					<span class="badge badge-ghost badge-sm">{ fmt.Sprint(len(incompleteObjectives)) }</span>
				}
			</div>
		</div>
		if len(incompleteObjectives) > 0 {
			<ul class="list">
				for i, objective := range incompleteObjectives {
					<li class={ templ.KV("bg-base-200", i%2 == 0), templ.KV("bg-base-100", i%2 != 0) }>
						<a
							href={ templ.URL(fmt.Sprintf("/admin/objective/%s", objective.Slug)) }
							class="px-6 py-4 flex items-start gap-3 w-full hover:bg-base-300 transition-colors"
						>
							<span class="status mt-1.5 shrink-0"></span>
							<div class="min-w-0">
								<p class="text-sm font-medium truncate">{ objective.Title }</p>
								if groupInfo, ok := objectiveGroups[objective.ID]; ok {
									<p class="text-xs opacity-60">{ groupInfo.GroupName }</p>
								}
							</div>
						</a>
					</li>
				}
			</ul>
		} else {
			<div class="px-6 pb-6">
				// Empty means several things; only the counts can prove completion.
				if totalObjectives == 0 {
					<div class="alert">
						@icon("info", templ.Attributes{"class": "w-5 h-5 shrink-0"})
						<span>This quest has no objectives yet.</span>
					</div>
				} else if !run.HasStarted {
					<div class="alert">
						@icon("info", templ.Attributes{"class": "w-5 h-5 shrink-0"})
						<span>This run hasn't started yet.</span>
					</div>
				} else {
					// incompleteObjectives is empty and totalObjectives > 0: everything's done.
					<div class="alert alert-success">
						@icon("circle-check", templ.Attributes{"class": "w-5 h-5 shrink-0"})
						<span>All objectives completed.</span>
					</div>
				}
			</div>
		}
	</div>
}

templ RunTimelineCard(settings models.QuestSettings, run models.Run) {
	<div class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors overflow-hidden">
		<div class="card-body p-6 pb-4">
			<div class="flex items-center justify-between mb-4">
				<h2 class="card-title text-lg flex items-center gap-2">
					@icon("history", templ.Attributes{"class": "w-5 h-5"})
					Timeline
				</h2>
				<div class="flex items-center gap-4 flex-wrap text-xs opacity-70">
					<span class="flex items-center gap-1.5"><span class="status status-success"></span>Done</span>
					if run.MustCheckOut != "" {
						<span class="flex items-center gap-1.5"><span class="status status-accent"></span>In progress</span>
					}
				</div>
			</div>
		</div>
		if entries := buildRunTimeline(run); len(entries) > 0 {
			<ul class="list">
				for i, entry := range entries {
					<li class={ templ.KV("bg-base-200", i%2 == 0), templ.KV("bg-base-100", i%2 != 0), templ.KV("bg-accent/10", entry.Kind == TimelineCurrent) }>
						@runTimelineRow(settings, entry, i == 0, i == len(entries)-1)
					</li>
				}
			</ul>
			<div class="card-body p-6 pt-3">
				<p class="text-xs opacity-50">
					Oldest first. The duration column is time since the previous objective.
				</p>
			</div>
		} else {
			<div class="px-6 pb-6">
				<div class="alert">
					@icon("info", templ.Attributes{"class": "w-5 h-5 shrink-0"})
					<span>This run hasn't started yet.</span>
				</div>
			</div>
		}
	</div>
}

templ runTimelineRow(settings models.QuestSettings, entry TimelineEntry, first bool, last bool) {
	<div
		class={ "px-6 flex gap-4 items-center",
			templ.KV("py-4", entry.Kind == TimelineCurrent),
			templ.KV("py-3", entry.Kind != TimelineCurrent),
			templ.KV("opacity-60 hover:opacity-100 transition-opacity", entry.Kind == TimelineDone) }
	>
		<div class="relative flex justify-center w-2 shrink-0 self-stretch">
			if first && !last {
				<div class="absolute top-1/2 bottom-0 w-px bg-base-content/15"></div>
			} else if last && !first {
				<div class="absolute top-0 h-1/2 w-px bg-base-content/15"></div>
			} else if !first && !last {
				<div class="absolute inset-y-0 w-px bg-base-content/15"></div>
			}
			switch entry.Kind {
				case TimelineStart:
					<div class="relative my-auto status ring-4 ring-base-200"></div>
				case TimelineCurrent:
					<div class="relative my-auto w-2 h-2">
						<span class="status status-accent absolute inset-0 animate-ping"></span>
						<span class="status status-accent relative block"></span>
					</div>
				default:
					<div class="relative my-auto status status-success ring-4 ring-base-200"></div>
			}
		</div>
		if entry.Kind == TimelineStart {
			<span class="text-sm opacity-50">Run started</span>
		} else {
			<span class={ "text-sm truncate", templ.KV("font-medium", entry.Kind == TimelineCurrent) }>
				{ entry.Label }
			</span>
			if entry.Kind == TimelineCurrent {
				<span class="badge badge-accent badge-sm shrink-0">In progress</span>
			}
			if settings.EnablePoints && entry.Points > 0 {
				<span class="badge badge-ghost badge-sm shrink-0">+{ fmt.Sprint(entry.Points) }</span>
			}
		}
		<span class="text-xs opacity-60 ml-auto whitespace-nowrap">
			if entry.GapBefore > 0 {
				{ formatDuration(entry.GapBefore) }
			}
		</span>
		<span class="text-xs opacity-40 w-16 text-right shrink-0">
			{ entry.At.Local().Format("3:04 PM") }
		</span>
	</div>
}

templ UploadedMediaCard(uploads []*models.Upload, teamCode string) {
	<div class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors">
		<div class="card-body p-6">
			<h2 class="card-title text-lg flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-images-icon lucide-images w-5 h-5"><path d="m22 11-1.296-1.296a2.4 2.4 0 0 0-3.408 0L11 16"></path><path d="M4 8a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2"></path><circle cx="13" cy="7" r="1" fill="currentColor"></circle><rect x="8" y="2" width="14" height="14" rx="2"></rect></svg>
				Uploaded media ({ fmt.Sprint(len(uploads)) })
			</h2>
			<div class="mt-2 columns-1 sm:columns-2 lg:columns-3 gap-3 space-y-3">
				for _, upload := range uploads {
					if upload.Type == models.MediaTypeImage {
						<a
							if config.IsLocalURL(upload.OriginalURL) {
								href={ templ.URL(upload.OriginalURL + "?size=large") }
							} else {
								href={ templ.URL(upload.OriginalURL) }
							}
							target="_blank"
							class="block rounded-box overflow-hidden bg-base-300 transition-opacity duration-200 hover:opacity-80 group break-inside-avoid"
						>
							<img
								if config.IsLocalURL(upload.OriginalURL) {
									src={ upload.OriginalURL + "?size=small" }
								} else {
									src={ upload.OriginalURL }
								}
								alt={ fmt.Sprintf("Upload by team %s on %s", teamCode, upload.Timestamp.Format("Jan 2, 2006")) }
								class="w-full h-auto object-cover"
							/>
						</a>
					} else if upload.Type == models.MediaTypeVideo {
						<a href={ templ.URL(upload.OriginalURL) } target="_blank" class="block rounded-box overflow-hidden bg-base-300 transition-opacity duration-200 hover:opacity-80 relative group break-inside-avoid">
							<video src={ upload.OriginalURL } class="w-full h-auto object-cover"></video>
							<div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/20 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play w-12 h-12 text-white"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
							</div>
						</a>
					}
				}
			</div>
		</div>
	</div>
}

templ MessagesCard(run models.Run, notifications []models.Notification) {
	<div class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors overflow-hidden">
		<div class="card-body p-6 pb-4">
			<div class="flex items-center justify-between mb-2">
				<h2 class="card-title text-lg flex items-center gap-2">
					@icon("megaphone", templ.Attributes{"class": "w-5 h-5"})
					Messages
				</h2>
				if unread := countUnread(notifications); unread > 0 {
					<span class="badge badge-warning badge-soft badge-sm">{ fmt.Sprint(unread) } unread</span>
				}
			</div>
		</div>
		<div id="alerts-list" class="px-6 max-h-80 overflow-y-auto">
			@AlertsList(notifications)
		</div>
		<div class="card-body p-6 pt-4">
			<form hx-post="/admin/notify/team" hx-target="#alerts-list" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful) this.reset()">
				<input type="hidden" name="teamCode" value={ run.Code }/>
				<div class="join w-full">
					<input class="input join-item w-full" name="content" placeholder="Message this run" autocomplete="off" required/>
					<button type="submit" class="btn btn-primary join-item">
						@icon("send-horizontal", templ.Attributes{"class": "w-5 h-5"})
					</button>
				</div>
			</form>
			<p class="text-xs opacity-50">
				Read-only — runs can't reply. To reach every run, announce from
				<a href="/admin/" class="link link-hover">Activity</a>.
			</p>
		</div>
	</div>
}

templ AlertsList(notifications []models.Notification) {
	if len(notifications) > 0 {
		for _, notification := range notifications {
			<div class="chat chat-end">
				<div class="chat-header opacity-70">
					<time class="text-xs opacity-70">
						{ notification.CreatedAt.Local().Format("02 Jan 3:04 PM") }
					</time>
				</div>
				<div class="chat-bubble chat-bubble-info">{ notification.Content }</div>
				<div class="chat-footer text-xs opacity-50 flex items-center gap-2">
					if notification.Dismissed {
						Read
					} else {
						<span class="status status-warning"></span>
						Unread
					}
				</div>
			</div>
		}
	} else {
		<p class="text-sm text-base-content/60 text-center py-4">No messages sent yet</p>
	}
}
