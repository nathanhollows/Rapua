package templates

import (
	"fmt"
	"github.com/SerhiiCho/timeago/v3"
	"github.com/nathanhollows/Rapua/v8/internal/config"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	"github.com/nathanhollows/Rapua/v8/models"
)

templ TeamsTable(teams []models.Run, summaries map[string]services.RunSummary) {
	<div class="card bg-base-200 border border-base-300 mx-5">
		<ul
			id="teams-ul"
			class="list"
			hx-boost="true"
			_="on htmx:afterSwap or htmx:afterSettle
			js(me)
				// Count checked checkboxes
				var checkedCount = document.querySelectorAll('input[name=team-checkbox]:checked').length;
				var allCheckboxes = document.querySelectorAll('input[name=team-checkbox]');

				// Update all selection count elements (including in modals)
				document.querySelectorAll('span').forEach(function(span) {
					var prev = span.previousSibling;
					if (prev && prev.textContent && prev.textContent.includes('Selected:')) {
						span.textContent = checkedCount;
					}
					// Also update counts in modal dialogs
					var parent = span.parentElement;
					if (parent && parent.innerHTML &&
						(parent.innerHTML.includes('reset') || parent.innerHTML.includes('delete'))) {
						var text = span.textContent;
						if (text && !isNaN(text.trim())) {
							span.textContent = checkedCount;
						}
					}
				});

				// Update select-all checkbox state
				var selectAll = document.getElementById('select-all');
				if (selectAll) {
					if (checkedCount === 0) {
						selectAll.checked = false;
						selectAll.indeterminate = false;
					} else if (checkedCount === allCheckboxes.length && allCheckboxes.length > 0) {
						selectAll.checked = true;
						selectAll.indeterminate = false;
					} else {
						selectAll.checked = false;
						selectAll.indeterminate = true;
					}
				}

				// Show/hide actions and filters bars
				var actions = document.getElementById('team-actions');
				var filters = document.getElementById('team-filters');
				if (checkedCount > 0) {
					if (actions) actions.classList.remove('hidden');
					if (filters) filters.classList.add('hidden');
				} else {
					if (actions) actions.classList.add('hidden');
					if (filters) filters.classList.remove('hidden');
				}
			end
		end"
		>
			<div class="flex flex-row items-center gap-3 px-6 py-4 border-b border-base-300">
				<!-- Select all -->
				<input
					id="select-all"
					type="checkbox"
					class="checkbox checkbox-sm checkbox-primary"
					_="on change or load
						set <.team-item:not(.hidden) input[name='team-checkbox']/>'s checked to my checked
						if my checked or my indeterminate
							add .hidden to #team-filters
							remove .hidden from #team-actions
						else
							add .hidden to #team-actions
							remove .hidden from #team-filters
						end
					end
					on change from <input[name='team-checkbox']/>
						if <input[name='team-checkbox']:checked/>'s length is not <input[name='team-checkbox']/>'s length
							set my indeterminate to true
						end
						if <input[name='team-checkbox']:checked/>'s length is 0
							set my indeterminate to false
							set my checked to false
						end
						if <input[name='team-checkbox']:checked/>'s length is <input[name='team-checkbox']/>'s length
							set my indeterminate to false
							set my checked to true
						end
						if my checked or my indeterminate
							add .hidden to #team-filters
							remove .hidden from #team-actions
						else
							add .hidden to #team-actions
							remove .hidden from #team-filters
						end
					end
					on htmx:afterRequest from #delete-confirm
						wait 0.5s
						if me.checked
							set me.checked to false
							set me.indeterminate to false
							remove .hidden from #team-filters
							add .hidden to #team-actions
						end
					end
					"
				/>
				<div id="team-actions" class="hidden flex flex-row flex-grow gap-3 items-center justify-between">
					<span class="font-bold text-base-content text-sm">
						Selected: 
						<span
							class="font-bold text-base-content/60"
							_="on change from <input[type='checkbox']/> or load
							set my textContent to <input[name='team-checkbox']:checked/>'s length"
						></span>
					</span>
					<div class="flex flex-row gap-2">
						<button
							class="btn btn-sm btn-outline"
							_="on click
						set list to []
						repeat for x in <input[name='team-checkbox']:checked/>
							append x's value to list
						end
						writeText(list.join('\n')) on navigator.clipboard
						set copyText to my innerHTML
						set my textContent to 'Copied!'
						wait 1.5s
						set my innerHTML to copyText
					"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-copy w-4 h-4"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path><path d="M16 4h2a2 2 0 0 1 2 2v4"></path><path d="M21 14H11"></path><path d="m15 10-4 4 4 4"></path></svg>
							Copy Codes
						</button>
					</div>
				</div>
				<div id="team-filters" class="flex flex-grow flex-row justify-between">
					<!-- Active/Inactive count -->
					<div class="filter">
						<input
							class="btn btn-sm filter-reset"
							type="radio"
							name="activefilter"
							aria-label="All"
							_="
							on click remove .hidden from <.team-item/>
						"
						/>
						<input
							class="btn btn-sm"
							type="radio"
							name="activefilter"
							aria-label="Active Only"
							_="
						on change
							if my checked
								remove .hidden from <.team-item/>
								add .hidden to <.team-item.inactive/>
							end
						"
						/>
						<input
							class="btn btn-sm"
							type="radio"
							name="activefilter"
							aria-label="Inactive Only"
							_="
						on change
							if my checked
								remove .hidden from <.team-item/>
								add .hidden to <.team-item.active/>
							end
						"
						/>
					</div>
					<div class="flex flex-row gap-2">
						<button
							class="btn btn-sm btn-outline"
							_="on click
						set list to []
						repeat for x in <input[name='team-checkbox']/>
							if x's offsetParent is not null
								append x's value to list
							end
						end
						writeText(list.join('\n')) on navigator.clipboard
						set copyText to my innerHTML
						set my textContent to 'Copied!'
						wait 1.5s
						set my innerHTML to copyText
					"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-copy w-4 h-4"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path><path d="M16 4h2a2 2 0 0 1 2 2v4"></path><path d="M21 14H11"></path><path d="m15 10-4 4 4 4"></path></svg>
							Copy Codes
						</button>
					</div>
				</div>
				<!-- Search -->
				<label class="input input-sm flex items-center gap-2 w-60">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search w-5 h-5"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
					<input
						id="search-teams"
						type="text"
						class="grow"
						placeholder="Search"
						_="
					init send input to me
					on input
						show .team-item
							when its textContent.toLowerCase().normalize('NFD')
							contains my value.toLowerCase().normalize('NFD')
						if my value's length > 0 then
							remove .invisible from #clear-search
						else
							add .invisible to #clear-search
						end
					end
					"
					/>
					<button
						id="clear-search"
						role="button"
						class="btn btn-ghost btn-xs btn-circle invisible -mr-2"
						type="reset"
						_="
						init if #search-teams's value's length > 0 then
							remove .invisible from me
						end
						on click
							set #search-teams's value to ''
							add .invisible to me
							send input to #search-teams
						end
					"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x w-4 h-4 opacity-80 hover:opacity-100"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
					</button>
				</label>
			</div>
			for _, team := range filter(teams, func(team models.Run) bool { return team.HasStarted }) {
				@teamItem(team, "active", summaries)
			}
			for _, team := range filter(teams, func(team models.Run) bool { return !team.HasStarted }) {
				@teamItem(team, "inactive", summaries)
			}
		</ul>
		<div id="teams-list">
			<div
				if len(teams) == 0 {
					class="no-teams px-6 py-8 text-center border-t border-base-300 rounded-b-box"
				} else {
					class="no-teams px-6 py-8 text-center border-t border-base-300 rounded-b-box hidden"
				}
				_="on htmx:afterSettle from body
				if <.team-item/>'s length == 0
					remove .hidden from me
				else
					add .hidden to me
				end
				on htmx:afterRequest from body
					wait 0.5s
					if <.team-item/>'s length == 0
						remove .hidden from me
					else
						add .hidden to me
					end
				"
			>
				<p class="text-sm opacity-60">
					No runs yet. Do you want to <a href="#" class="link" onclick="add_teams_modal.showModal()">add some</a>?
				</p>
			</div>
		</div>
	</div>
}

templ TeamsList(teams []models.Run, summaries map[string]services.RunSummary) {
	for _, team := range teams {
		@teamItem(team, "inactive", summaries)
	}
}

templ teamItem(team models.Run, classes string, summaries map[string]services.RunSummary) {
	<li class={ fmt.Sprint("team-item border-t border-base-300 transition-colors last:rounded-b-box hover:bg-base-300 has-[:checked]:bg-primary/10 has-[:checked]:hover:bg-primary/20 ", classes) }>
		<div class="flex flex-row items-center gap-3 px-6 py-3">
			<input
				name="team-checkbox"
				type="checkbox"
				class="team-checkbox checkbox checkbox-sm checkbox-primary"
				value={ team.Code }
				_="on htmx:afterRequest from #delete-confirm
					if me.checked
						add .bg-danger .text-danger-content to closest .team-item
						transition opacity to 0 then
						remove the closest .team-item
					end
				end
				on change
					js(me)
						var checkedCount = document.querySelectorAll('input[name=team-checkbox]:checked').length;
						var allCheckboxes = document.querySelectorAll('input[name=team-checkbox]');
						var selectAll = document.getElementById('select-all');

						// Update selection counts
						document.querySelectorAll('span').forEach(function(span) {
							var prev = span.previousSibling;
							if (prev && prev.textContent && prev.textContent.includes('Selected:')) {
								span.textContent = checkedCount;
							}
						});

						// Update select-all state
						if (selectAll) {
							if (checkedCount === 0) {
								selectAll.checked = false;
								selectAll.indeterminate = false;
							} else if (checkedCount === allCheckboxes.length && allCheckboxes.length > 0) {
								selectAll.checked = true;
								selectAll.indeterminate = false;
							} else {
								selectAll.checked = false;
								selectAll.indeterminate = true;
							}
						}

						// Show/hide actions and filters
						var actions = document.getElementById('team-actions');
						var filters = document.getElementById('team-filters');
						if (checkedCount > 0) {
							if (actions) actions.classList.remove('hidden');
							if (filters) filters.classList.add('hidden');
						} else {
							if (actions) actions.classList.add('hidden');
							if (filters) filters.classList.remove('hidden');
						}
					end
				end
				"
			/>
			<div
				class="tooltip cursor-pointer"
				data-tip="Click to copy"
				_="on click 
					writeText(my textContent) on navigator.clipboard
					set @data-tip to 'Copied!'
					wait 2s
					set @data-tip to 'Click to copy'
					"
			>
				if team.HasStarted {
					<span class="team-code badge badge-success badge-outline font-mono tracking-wider">{ team.Code }</span>
				} else {
					<span class="team-code badge font-mono tracking-wider">{ team.Code }</span>
				}
			</div>
			<!-- Run name -->
			if team.Name == "" {
				<em class="opacity-50 truncate grow">No name set</em>
			} else {
				<span class="truncate grow">{ team.Name }</span>
			}
			// A run the stream cannot place reads as started rather than as
			// playing: it has begun, and nothing has been read of its pace.
			{{ summary := summaries[team.Code] }}
			{{ status := summary.Status }}
			if status == "" && team.HasStarted {
				{{ status = services.StatusStarted }}
			}
			if summary.Total > 0 {
				<span class="hidden md:flex shrink-0">
					@runProgressBar(summary.Done, summary.Total)
				</span>
			}
			<span class="shrink-0">
				@TeamStatusBadge(status, true, "sm")
			</span>
			// Relative, not elapsed: a stale run otherwise reads "111d 21h".
			if team.HasStarted && !team.StartedAt.IsZero() {
				<span
					class="text-xs whitespace-nowrap shrink-0 tooltip tooltip-left hidden sm:inline"
					data-tip={ team.StartedAt.Local().Format("02 Jan 2006, 3:04 PM") }
				>
					<span class="opacity-50">{ timeago.Parse(team.StartedAt) }</span>
				</span>
			}
			if team.HasStarted {
				<a
					href={ templ.URL(fmt.Sprintf("/admin/runs/%s", team.Code)) }
					class="btn btn-xs shrink-0"
				>
					See activity
				</a>
			}
		</div>
	</li>
}

templ Teams(teams []models.Run, credits int, summaries map[string]services.RunSummary) {
	<span class="hidden bg-danger text-danger-content border-error border-warning"></span>
	<div class="flex gap-3 flex-row justify-between items-center w-full p-5">
		<h1 class="text-2xl font-bold">
			Runs
			<div class="dropdown dropdown-hover">
				<div tabindex="0" role="button" class="btn btn-circle btn-ghost btn-xs text-info"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 lucide lucide-info"><circle cx="12" cy="12" r="10"></circle><path d="m12 16v-4"></path><path d="m12 8h.01"></path></svg></div>
				<div tabindex="0" class="card compact dropdown-content font-normal bg-base-200 rounded-box z-[1] w-72 shadow">
					<div tabindex="0" class="card-body">
						<h2 class="card-title">Runs</h2>
						<p>
							A run is one playthrough. It can be played by an individual or by a group sharing a single device, using a unique run code.
						</p>
						<p>
							Progress is tracked per run, whether played by an individual or a group.
						</p>
						<p>
							Run codes are randomly generated. Players can name their run when they start playing.
						</p>
					</div>
				</div>
			</div>
		</h1>
		<a
			href="/admin/settings/credits"
			if credits <= 0 {
				class="badge badge-error tooltip tooltip-bottom"
				data-tip="No credits remaining! New runs won't be able to start."
			}
			else
			if credits >= 5 {
				class="badge badge-info tooltip tooltip-bottom"
				data-tip="Each run start costs one credit. Credits do not affect how many run codes you can generate."
			} else {
				class="badge badge-warning tooltip tooltip-bottom"
				data-tip="Low on credits! Each run start costs one credit. Credits do not affect how many run codes you can generate."
			}
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info w-4"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
			{ fmt.Sprint(credits) } credits remaining
		</a>
		<div class="flex gap-3">
			<button
				class="btn btn-secondary"
				onclick="add_teams_modal.showModal()"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>
				Add runs
			</button>
		</div>
	</div>
	<div id="teams-table">
		@TeamsTable(teams, summaries)
	</div>
	<!-- Modal for adding runs -->
	<dialog
		id="add_teams_modal"
		class="modal modal-bottom sm:modal-middle"
	>
		<div class="modal-box">
			<h3 class="font-bold text-lg">Quick add runs</h3>
			<p class="py-4">How many runs would you like to add?</p>
			<form
				hx-post="/admin/runs/add"
				hx-target="#teams-ul"
				hx-swap="beforeend swap:0.5s"
				class="join flex flex-row w-full"
			>
				<input
					name="count"
					type="number"
					id="count"
					class="input join-item flex-grow"
					placeholder="1+"
					min="1"
					step="1"
					value="10"
				/>
				<button class="btn btn-primary join-item" onclick="add_teams_modal.close()">Add runs</button>
			</form>
			<div class="modal-action">
				<form method="dialog">
					<button class="btn">Nevermind</button>
				</form>
			</div>
			<form method="dialog">
				<button
					class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
				>✕</button>
			</form>
		</div>
	</dialog>
	@teamModal()
}

// TeamOverviewData contains all data needed to render the run overview page.
type TeamOverviewData struct {
	Quest         models.Quest
	Run           models.Run
	Notifications []models.Notification
	Uploads       []*models.Upload
	Progress      services.RunProgress
	RunLog        services.RunLog
	// Show is the active log filter; empty is everything.
	Show string
}

templ TeamOverview(data TeamOverviewData) {
	<main class="max-w-7xl m-auto pb-8">
		<!-- The header is the run itself: the page is about this run, and the
		     nav already says where in the admin you are. -->
		<div class="flex flex-col sm:flex-row gap-3 justify-between items-center w-full p-5">
			<div class="mr-auto">
				<h1 class="text-2xl font-bold flex flex-wrap items-center gap-x-2">
					<span class="font-mono tracking-wider">{ data.Run.Code }</span>
					if data.Run.Name != "" {
						<span class="text-base-content/50">∕</span>
						{ data.Run.Name }
					}
				</h1>
			</div>
			<div class="flex gap-3">
				<button
					class="btn btn-error"
					_="on click
							confirm_delete_modal.showModal()
						end
					"
				>
					@icon("trash-2", templ.Attributes{"class": "w-5 h-5"})
					Delete
				</button>
			</div>
		</div>
		<div class="px-5 mb-5">
			@RunStatsCard(data.Quest.Settings, data.Run, data.RunLog, data.Progress)
		</div>
		<div class="relative flex flex-col-reverse lg:flex-row px-5 gap-5">
			<!-- Sidebar -->
			<div class="w-full lg:w-80 space-y-5 flex-shrink-0">
				@QuestMapCard(data.Progress)
				@MessagesCard(data.Run, data.Notifications)
			</div>
			<!-- Main -->
			<div class="w-full flex-1 min-w-0 space-y-5">
				@RunLogCard(data.RunLog, data.Show, data.Run.Code)
				if len(data.Uploads) > 0 {
					@UploadedMediaCard(data.Uploads, data.Run.Code)
				}
			</div>
		</div>
	</main>
	@TeamPageModals(data.Run.Code)
	@cadenceScript()
}

templ TeamPageModals(teamCode string) {
	<dialog id="confirm_delete_modal" class="modal">
		<div class="modal-box prose outline outline-2 outline-offset-1 outline-error">
			<h3 class="text-lg font-bold">Delete run</h3>
			<p class="pt-4">
				You are about to delete this run. Doing this will wipe all data including:
			</p>
			<ul>
				<li>the run</li>
				<li>activity progress</li>
				<li>any uploaded media</li>
			</ul>
			<p>Credits are not restored if a run is deleted.</p>
			<p>This action cannot be undone.</p>
			<form
				hx-delete={ fmt.Sprintf("/admin/runs/%s", teamCode) }
			>
				<input type="hidden" name="id" value=""/>
				<div class="modal-action">
					<button type="button" class="btn" onclick="confirm_delete_modal.close()">Nevermind</button>
					<button id="delete-confirm" type="submit" class="btn btn-error" onclick="confirm_delete_modal.close()">Delete</button>
				</div>
			</form>
		</div>
	</dialog>
}

templ RunStatsCard(settings models.QuestSettings, run models.Run, log services.RunLog, progress services.RunProgress) {
	<div class="grid grid-cols-2 md:grid-cols-5 gap-0 shadow rounded-box w-full bg-gradient-to-br from-info/10 to-info/5 border border-info/20 hover:border-info/30 transition-colors overflow-hidden">
		<div class="stat place-items-center border-b md:border-b-0 md:border-r border-info/20">
			<div class="stat-title">Status</div>
			<div class="stat-value">
				@TeamStatusBadge(runStatus(run, log), false, "lg")
			</div>
			<div class="stat-desc">{ runLogQuiet(log) }</div>
		</div>
		<div class="stat place-items-center border-b md:border-b-0 md:border-r border-info/20">
			<div class="stat-title">Objectives</div>
			<div class="stat-value">
				{ fmt.Sprint(progress.Done) }<span class="text-base text-base-content/50">∕{ fmt.Sprint(progress.Total) }</span>
			</div>
			<div class="stat-desc">Completed</div>
		</div>
		if settings.EnablePoints {
			<div class="stat place-items-center border-b md:border-b-0 md:border-r border-info/20">
				<div class="stat-title">Points</div>
				<div class="stat-value">{ fmt.Sprint(run.Points) }</div>
				<div class="stat-desc">Across all objectives</div>
			</div>
		} else {
			<div class="stat place-items-center border-b md:border-b-0 md:border-r border-info/20">
				<div class="stat-title">Progress</div>
				<div class="stat-value">
					if progress.Total > 0 {
						{ fmt.Sprintf("%.0f%%", float64(progress.Done)/float64(progress.Total)*100) }
					} else {
						0%
					}
				</div>
				<div class="stat-desc">Towards completion</div>
			</div>
		}
		<div class="stat place-items-center border-b md:border-b-0 md:border-r border-info/20">
			<div class="stat-title">Pace</div>
			<div class="stat-value">{ runLogPace(log) }</div>
			<div class="stat-desc">{ runLogPaceNote(log) }</div>
		</div>
		<div class="stat place-items-center">
			<div class="stat-title">Elapsed</div>
			<div class="stat-value">
				if elapsed := runElapsed(run); elapsed != "" {
					{ elapsed }
				} else {
					—
				}
			</div>
			<div class="stat-desc">
				if !run.StartedAt.IsZero() {
					Started { run.StartedAt.Local().Format("3:04 PM") }
				} else {
					Not started
				}
			</div>
		</div>
	</div>
}

// QuestMapCard draws the quest as the run met it: the in-play tree, every node
// marked by what the run did to it. Drafts are absent rather than greyed:
// players never meet them, so a run neither owes them nor skipped them.
templ QuestMapCard(progress services.RunProgress) {
	<div class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors">
		<div class="card-body p-6 pb-4">
			<div class="flex items-center justify-between mb-1">
				<h2 class="card-title text-lg">The quest</h2>
				<span class="badge badge-ghost badge-sm">{ fmt.Sprintf("%d ∕ %d", progress.Done, progress.Total) }</span>
			</div>
			<p class="text-xs text-base-content/60">Drafts are not shown: players never meet them.</p>
			if progress.Finished {
				<p class="text-xs text-success">The run is complete.</p>
			}
		</div>
		if len(progress.Nodes) > 0 {
			<div class="map px-4 pb-5">
				for _, node := range progress.Nodes {
					<div
						class="maprow"
						style={ fmt.Sprintf("padding-left: %grem", 0.4+float64(node.Depth)*1.1) }
					>
						@questMapState(node)
						<span class={ "mapname", templ.KV("excluded", node.RuledOut), templ.KV("todo", !node.Done && !node.RuledOut && !node.Started) }>
							{ node.Objective.Title }
						</span>
						if node.Section {
							<span class="maproute">
								@icon(routingIcon(node.Objective.Routing), templ.Attributes{"class": "w-3.5 h-3.5"})
							</span>
						}
						if node.Children > 0 {
							<span class="maprole">{ fmt.Sprintf("%d ∕ %d", node.Found, node.Children) }</span>
						}
					</div>
				}
			</div>
		} else {
			<div class="px-6 pb-6">
				<div class="alert">
					@icon("info", templ.Attributes{"class": "w-5 h-5 shrink-0"})
					<span>This quest has no objectives yet.</span>
				</div>
			</div>
		}
	</div>
}

// questMapState is the leading mark: shape first, colour second, so the states
// survive greyscale. Excluded has a shape of its own rather than a dimmer one:
// the run is no longer owed it, because a band closed over it or the finish
// passed it, and a player's choice is what usually did the closing.
templ questMapState(node services.RunProgressNode) {
	if node.Done {
		<span class="mapstate" data-state="done">
			@icon("circle-check", templ.Attributes{"class": "w-4 h-4"})
		</span>
	} else if node.RuledOut {
		<span class="mapstate tooltip" data-state="todo" data-tip="Excluded: a closed branch left it behind.">
			@icon("circle-slash", templ.Attributes{"class": "w-4 h-4"})
		</span>
	} else if node.Started {
		<span class="mapstate" data-state="started">
			@icon("circle-dot", templ.Attributes{"class": "w-4 h-4"})
		</span>
	} else if node.Locked {
		<span class="mapstate tooltip" data-state="locked" data-tip="Not available yet: the run cannot reach it from here.">
			@icon("lock", templ.Attributes{"class": "w-4 h-4"})
		</span>
	} else {
		<span class="mapstate" data-state="todo">
			@icon("circle", templ.Attributes{"class": "w-4 h-4"})
		</span>
	}
}

templ UploadedMediaCard(uploads []*models.Upload, teamCode string) {
	<div class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors">
		<div class="card-body p-6">
			<h2 class="card-title text-lg flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-images-icon lucide-images w-5 h-5"><path d="m22 11-1.296-1.296a2.4 2.4 0 0 0-3.408 0L11 16"></path><path d="M4 8a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2"></path><circle cx="13" cy="7" r="1" fill="currentColor"></circle><rect x="8" y="2" width="14" height="14" rx="2"></rect></svg>
				Uploaded media ({ fmt.Sprint(len(uploads)) })
			</h2>
			<div class="mt-2 columns-1 sm:columns-2 lg:columns-3 gap-3 space-y-3">
				for _, upload := range uploads {
					if upload.Type == models.MediaTypeImage {
						<a
							if config.IsLocalURL(upload.OriginalURL) {
								href={ templ.URL(upload.OriginalURL + "?size=large") }
							} else {
								href={ templ.URL(upload.OriginalURL) }
							}
							target="_blank"
							class="block rounded-box overflow-hidden bg-base-300 transition-opacity duration-200 hover:opacity-80 group break-inside-avoid"
						>
							<img
								if config.IsLocalURL(upload.OriginalURL) {
									src={ upload.OriginalURL + "?size=small" }
								} else {
									src={ upload.OriginalURL }
								}
								alt={ fmt.Sprintf("Upload by team %s on %s", teamCode, upload.Timestamp.Format("Jan 2, 2006")) }
								class="w-full h-auto object-cover"
							/>
						</a>
					} else if upload.Type == models.MediaTypeVideo {
						<a href={ templ.URL(upload.OriginalURL) } target="_blank" class="block rounded-box overflow-hidden bg-base-300 transition-opacity duration-200 hover:opacity-80 relative group break-inside-avoid">
							<video src={ upload.OriginalURL } class="w-full h-auto object-cover"></video>
							<div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/20 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play w-12 h-12 text-white"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
							</div>
						</a>
					}
				}
			</div>
		</div>
	</div>
}

templ MessagesCard(run models.Run, notifications []models.Notification) {
	<div class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors overflow-hidden">
		<div class="card-body p-6 pb-4">
			<div class="flex items-center justify-between mb-2">
				<h2 class="card-title text-lg flex items-center gap-2">
					@icon("megaphone", templ.Attributes{"class": "w-5 h-5"})
					Messages
				</h2>
				if unread := countUnread(notifications); unread > 0 {
					<span class="badge badge-warning badge-soft badge-sm">{ fmt.Sprint(unread) } unread</span>
				}
			</div>
		</div>
		<div id="alerts-list" class="px-6 max-h-80 overflow-y-auto">
			@AlertsList(notifications)
		</div>
		<div class="card-body p-6 pt-4">
			<form hx-post="/admin/notify/team" hx-target="#alerts-list" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful) this.reset()">
				<input type="hidden" name="teamCode" value={ run.Code }/>
				<div class="join w-full">
					<input class="input join-item w-full" name="content" placeholder="Message this run" autocomplete="off" required/>
					<button type="submit" class="btn btn-primary join-item">
						@icon("send-horizontal", templ.Attributes{"class": "w-5 h-5"})
					</button>
				</div>
			</form>
			<p class="text-xs opacity-50">
				Read-only — runs can't reply. To reach every run, announce from
				<a href="/admin/" class="link link-hover">Activity</a>.
			</p>
		</div>
	</div>
}

templ AlertsList(notifications []models.Notification) {
	if len(notifications) > 0 {
		for _, notification := range notifications {
			<div class="chat chat-end">
				<div class="chat-header opacity-70">
					<time class="text-xs opacity-70">
						{ notification.CreatedAt.Local().Format("02 Jan 3:04 PM") }
					</time>
				</div>
				<div class="chat-bubble chat-bubble-info">{ notification.Content }</div>
				<div class="chat-footer text-xs opacity-50 flex items-center gap-2">
					if notification.Dismissed {
						Read
					} else {
						<span class="status status-warning"></span>
						Unread
					}
				</div>
			</div>
		}
	} else {
		<p class="text-sm text-base-content/60 text-center py-4">No messages sent yet</p>
	}
}

// cadenceScript keeps the window tied to the log's scroll. It goes at the end
// of the page, after both the strip and the log exist.
templ cadenceScript() {
	<script>
	/* The window is the span of time the visible entries cover, not a fixed
	   slice sliding along the strip. Rows carry the interval they cover, so
	   the marker is the union of what is on screen: it narrows through busy
	   play, where a screenful is a couple of minutes, and widens across a
	   quiet spell, where one entry can be half an hour.

	   The filter tabs swap the whole card, strip and log with it, so the
	   wiring below runs again on the elements that arrive in their place.
	   bound marks the nodes already listening; the body-level hooks re-run
	   the wiring after every swap on the page, the ones with nothing to do
	   with the card included, and with the mark in place that costs a
	   lookup and nothing else. */
	(function () {
		var latest = null;

		function init() {
			var log = document.getElementById('run-log');
			var marker = document.getElementById('run-window');
			var strip = document.getElementById('run-heat');
			if (!log || !marker || !strip) {
				/* A filter can swap in a card with nothing to draw, and the
				   elements the last one left behind are gone with it. */
				latest = null;
				return;
			}
			if (log.dataset.cadenceBound) return;
			log.dataset.cadenceBound = '1';

			var rows = Array.prototype.slice.call(log.querySelectorAll('[data-t0]'));
			if (!rows.length) {
				latest = null;
				return;
			}
			/* The axis runs to now, past the last row, so the scale comes from
			   data-total rather than from the last row's end. */
			var TOTAL = +(strip.dataset.total || 0) ||
				rows.reduce(function (m, el) {
					return Math.max(m, +el.dataset.t1);
				}, 0) || 1;
			var MIN = 1.2; /* so an empty stretch still shows a sliver */

			function sync() {
				var top = log.scrollTop, bottom = top + log.clientHeight;
				var t0 = Infinity, t1 = -Infinity;
				for (var i = 0; i < rows.length; i++) {
					var el = rows[i], a = el.offsetTop, b = a + el.offsetHeight;
					if (b <= top || a >= bottom) continue;
					var s0 = +el.dataset.t0, s1 = +el.dataset.t1;
					if (s0 < t0) t0 = s0;
					if (s1 > t1) t1 = s1;
				}
				if (t0 > t1) return;
				marker.style.left = (t0 / TOTAL * 100) + '%';
				marker.style.width = Math.max(MIN, (t1 - t0) / TOTAL * 100) + '%';
			}

			/* Anchors let a scroll land between rows: each entry gives a time and
			   the scrollTop that puts its foot at the foot of the viewport.
			   Interpolating between them keeps a drag smooth where snapping to
			   rows would step. */
			var anchors = [];

			function measure() {
				anchors = rows.map(function (el) {
					return [+el.dataset.t0, el.offsetTop + el.offsetHeight - log.clientHeight];
				}).sort(function (a, b) {
					return a[0] - b[0];
				});
				sync();
			}

			function scrollToTime(t) {
				var n = anchors.length;
				if (t <= anchors[0][0]) {
					log.scrollTop = anchors[0][1];
					return;
				}
				if (t >= anchors[n - 1][0]) {
					log.scrollTop = anchors[n - 1][1];
					return;
				}
				for (var i = 1; i < n; i++) {
					if (anchors[i][0] >= t) {
						var a = anchors[i - 1], b = anchors[i];
						var f = (t - a[0]) / ((b[0] - a[0]) || 1);
						log.scrollTop = a[1] + (b[1] - a[1]) * f;
						return;
					}
				}
			}

			function frac(e) {
				var r = strip.getBoundingClientRect();
				return Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
			}

			var dragging = false, grab = 0;

			/* Dragging scrubs the log rather than moving the window by hand: the
			   drag names a time, the log scrolls to it, and the window is
			   recomputed from what that put on screen. Moving the window directly
			   would let it drift away from the entries it claims to cover. */
			marker.addEventListener('pointerdown', function (e) {
				grab = frac(e) - (parseFloat(marker.style.left) / 100 || 0);
				dragging = true;
				marker.classList.add('dragging');
				if (marker.setPointerCapture) marker.setPointerCapture(e.pointerId);
				e.preventDefault();
			});

			marker.addEventListener('pointermove', function (e) {
				if (!dragging) return;
				var w = parseFloat(marker.style.width) / 100 || 0.1;
				scrollToTime(Math.min(1 - w, Math.max(0, frac(e) - grab)) * TOTAL);
			});

			function stopDrag() {
				if (!dragging) return;
				dragging = false;
				marker.classList.remove('dragging');
			}
			marker.addEventListener('pointerup', stopDrag);
			marker.addEventListener('pointercancel', stopDrag);

			var queued = false;
			log.addEventListener('scroll', function () {
				if (queued) return;
				queued = true;
				requestAnimationFrame(function () {
					queued = false;
					sync();
				});
			});

			/* The first frames can land before the log has its final height (styles
			   settling, an htmx swap, anything that reflows), and a window measured
			   against a taller log claims the whole strip. Measuring again for a
			   few frames costs nothing and leaves the window where it belongs. */
			var settles = 0;
			function settle() {
				measure();
				settles++;
				if (settles < 5) requestAnimationFrame(settle);
			}
			latest = measure;
			settle();
		}

		/* One listener per window event rather than one per card: the elements
		   the wiring holds are replaced on a swap, and re-adding here would
		   leave the old ones listening to nodes nobody can see. */
		window.addEventListener('resize', function () {
			if (latest) latest();
		});
		window.addEventListener('load', function () {
			if (latest) latest();
		});

		init();
		document.body.addEventListener('htmx:load', init);
		document.body.addEventListener('htmx:afterSettle', init);
	})();
	</script>
}

templ RunLogCard(log services.RunLog, show, runCode string) {
	{{ shown := runLogFilter(log.Entries, show) }}
	<div id={ RunLogCardTarget } class="card bg-gradient-to-br from-base-200/70 to-base-200/50 border border-base-content/20 hover:border-base-content/30 transition-colors overflow-hidden">
		<div class="card-body p-6 pb-4">
			<div class="flex flex-wrap items-center justify-between gap-3 mb-1">
				<h2 class="card-title text-lg">Timeline</h2>
				<div class="join">
					<a
						href={ templ.URL(runLogHref(runCode, "")) }
						hx-get={ templ.URL(runLogHref(runCode, "")) }
						hx-target={ "#" + RunLogCardTarget }
						hx-swap="outerHTML"
						hx-push-url="false"
						class={ "btn btn-xs join-item", templ.KV("btn-active", show == "") }
					>All</a>
					<a
						href={ templ.URL(runLogHref(runCode, "progress")) }
						hx-get={ templ.URL(runLogHref(runCode, "progress")) }
						hx-target={ "#" + RunLogCardTarget }
						hx-swap="outerHTML"
						hx-push-url="false"
						class={ "btn btn-xs join-item", templ.KV("btn-active", show == "progress") }
					>Progress</a>
					<a
						href={ templ.URL(runLogHref(runCode, "messages")) }
						hx-get={ templ.URL(runLogHref(runCode, "messages")) }
						hx-target={ "#" + RunLogCardTarget }
						hx-swap="outerHTML"
						hx-push-url="false"
						class={ "btn btn-xs join-item", templ.KV("btn-active", show == "messages") }
					>Messages</a>
					<a
						href={ templ.URL(runLogHref(runCode, "navigation")) }
						hx-get={ templ.URL(runLogHref(runCode, "navigation")) }
						hx-target={ "#" + RunLogCardTarget }
						hx-swap="outerHTML"
						hx-push-url="false"
						class={ "btn btn-xs join-item", templ.KV("btn-active", show == "navigation") }
					>Navigation</a>
				</div>
			</div>
			<p class="text-xs text-base-content/60">
				Newest first. The right-hand figure is the wait before that entry.
			</p>
		</div>
		if len(log.Segments) > 0 {
			<div class="px-6 pb-4">
				<div class="flex flex-wrap items-center gap-3 text-xs text-base-content/70 mb-2">
					<span class="flex items-center gap-1.5">
						<span class="inline-block w-3 h-2 rounded-sm h-playing"></span>Playing
					</span>
					<span class="flex items-center gap-1.5">
						<span class="inline-block w-3 h-2 rounded-sm h-idle"></span>Idle
					</span>
					<span class="flex items-center gap-1.5">
						<span class="inline-block w-3 h-2 rounded-sm h-stalled"></span>Stalled
					</span>
					<span class="flex items-center gap-1.5">
						<span class="inline-block w-3 h-2 rounded-sm h-abandoned"></span>Abandoned
					</span>
				</div>
				<div class="heat" id="run-heat" data-total={ fmt.Sprint(runLogAxis(log)) }>
					for _, segment := range log.Segments {
						<div
							class={ "hseg h-" + string(segment.Class) }
							style={ fmt.Sprintf("flex: 0 0 %.4f%%", runLogSegmentPercent(segment, log)) }
							title={ runLogSegmentTitle(segment) }
						></div>
					}
					<div
						class="strip-window"
						id="run-window"
						title="Drag to scrub the log"
						style="left: 0; width: 100%"
					></div>
				</div>
				<div class="flex text-xs text-base-content/60 mt-1">
					<span>{ runLogTime(log.From, log) }</span>
					<span class="ml-auto">{ runLogTime(log.To, log) }</span>
				</div>
			</div>
		}
		if len(shown) > 0 {
			<div class="runlog" id="run-log">
				<ul class="list">
					for i, entry := range shown {
						@runLogRow(entry, i, log)
					}
				</ul>
			</div>
		} else {
			<div class="px-6 pb-6">
				<div class="alert">
					@icon("info", templ.Attributes{"class": "w-5 h-5 shrink-0"})
					<span>
						if len(log.Entries) == 0 {
							Nothing recorded yet.
						} else {
							Nothing in this filter.
						}
					</span>
				</div>
			</div>
		}
		<div class="card-body p-6 pt-3 border-t border-base-content/10">
			<p class="text-xs text-base-content/60">{ runLogFooter(len(shown), len(log.Entries)) }</p>
		</div>
	</div>
}

// runLogRow draws one entry. A quiet line is a stretch of nothing between the
// events around it.
templ runLogRow(entry services.RunLogEntry, index int, log services.RunLog) {
	if entry.Kind == services.RunLogQuiet {
		{{ t0, t1 := runLogSpan(entry, log) }}
		<li
			class="flex items-center gap-3 px-6 py-2 text-xs"
			data-t0={ fmt.Sprint(t0) }
			data-t1={ fmt.Sprint(t1) }
		>
			<span class="grow border-t border-dashed border-base-content/40"></span>
			<span class={ runLogQuietTint(entry.Cadence) }>{ runLogQuietLine(entry) }</span>
			<span class="grow border-t border-dashed border-base-content/40"></span>
		</li>
	} else {
		{{ t0, t1 := runLogSpan(entry, log) }}
		{{ multiline := entry.Kind == services.RunLogMessage || entry.Kind == services.RunLogUpload }}
		<li
			class={ templ.KV("bg-base-200", index%2 == 0), templ.KV("bg-base-100", index%2 != 0) }
			data-t0={ fmt.Sprint(t0) }
			data-t1={ fmt.Sprint(t1) }
		>
			<div class={ "px-6 py-3 flex gap-4", templ.KV("items-start", multiline), templ.KV("items-center", !multiline) }>
				<span class={ templ.KV("mt-0.5", multiline) }>@runLogIcon(entry)</span>
				@runLogBody(entry)
				<span class="text-xs text-base-content/70 ml-auto whitespace-nowrap">{ runLogWait(entry.Gap) }</span>
				<span class="text-xs text-base-content/60 text-right shrink-0 whitespace-nowrap tabular-nums">{ runLogTime(entry.Time, log) }</span>
			</div>
		</li>
	}
}

templ runLogIcon(entry services.RunLogEntry) {
	switch entry.Kind {
		case services.RunLogStart:
			<span class="text-base-content/60 shrink-0">@icon("play", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogNamed:
			<span class="text-base-content/60 shrink-0">@icon("pen-line", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogListed:
			<span class="text-base-content/60 shrink-0">@icon("list", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogViewed:
			<span class="text-base-content/60 shrink-0">@icon("eye", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogAnswer:
			if entry.Completed {
				<span class="text-success shrink-0">@icon("check", templ.Attributes{"class": "w-4 h-4"})</span>
			} else {
				<span class="text-warning shrink-0">@icon("circle-x", templ.Attributes{"class": "w-4 h-4"})</span>
			}
		case services.RunLogComplete:
			<span class="text-success shrink-0">@icon("circle-check", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogSection:
			<span class="text-success shrink-0">@icon("flag", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogUpload:
			<span class="text-base-content/60 shrink-0">@icon("image", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogMessage:
			<span class="text-info shrink-0">@icon("megaphone", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogRead:
			<span class="text-base-content/60 shrink-0">@icon("check-check", templ.Attributes{"class": "w-4 h-4"})</span>
		case services.RunLogFinish:
			<span class="text-success shrink-0">@icon("trophy", templ.Attributes{"class": "w-4 h-4"})</span>
	}
}

templ runLogBody(entry services.RunLogEntry) {
	switch entry.Kind {
		case services.RunLogStart:
			<span class="text-sm truncate">Run started</span>
		case services.RunLogNamed:
			<span class="text-sm truncate">Named the run <span class="font-medium">{ entry.Title }</span></span>
		case services.RunLogListed:
			<span class="text-sm truncate">Opened the objectives list</span>
		case services.RunLogViewed:
			@runLogObjectiveLine("Opened", entry)
		case services.RunLogComplete:
			@runLogObjectiveLine("Completed", entry)
		case services.RunLogSection:
			@runLogObjectiveLine("Finished section", entry)
		case services.RunLogAnswer:
			@runLogAnswer(entry)
		case services.RunLogUpload:
			@runLogUpload(entry)
		case services.RunLogMessage:
			<div class="min-w-0">
				<span class="text-sm truncate">Message received</span>
				if entry.Message != "" {
					<span class="text-xs text-base-content/70 block truncate">{ entry.Message }</span>
				}
			</div>
		case services.RunLogRead:
			<span class="text-sm truncate">Message read</span>
		case services.RunLogFinish:
			<span class="text-sm font-medium truncate">Finished the run</span>
	}
}

templ runLogObjectiveLine(verb string, entry services.RunLogEntry) {
	<span class="text-sm truncate">
		{ verb + " " }
		if entry.Slug != "" {
			<a href={ templ.URL("/admin/objective/" + entry.Slug) } class="link">{ entry.Title }</a>
		} else if entry.Title != "" {
			{ entry.Title }
		} else {
			<span class="text-base-content/60">something the quest no longer names</span>
		}
	</span>
}

// runLogAnswer is one submission. It says completed or not, never right or
// wrong: the log records completion and worth, and only the block knows what
// right means.
templ runLogAnswer(entry services.RunLogEntry) {
	<span class="text-sm truncate">
		{ entry.BlockName }
		if entry.Title != "" {
			<span class="text-base-content/70"> on </span>
			if entry.Slug != "" {
				<a href={ templ.URL("/admin/objective/" + entry.Slug) } class="link">{ entry.Title }</a>
			} else {
				{ entry.Title }
			}
		}
		if !entry.Completed {
			<span class="text-base-content/60">— not completed</span>
		}
	</span>
	if entry.Points != 0 {
		<span class={ "badge badge-sm shrink-0 font-semibold", templ.KV("badge-primary", entry.Points > 0), templ.KV("badge-error", entry.Points < 0) }>
			{ fmt.Sprintf("%+d", entry.Points) }
		</span>
	}
	if entry.Tries > 1 {
		<span class="badge badge-ghost badge-sm shrink-0">{ fmt.Sprintf("attempt %d", entry.Tries) }</span>
	}
}

templ runLogUpload(entry services.RunLogEntry) {
	<div class="min-w-0 flex-1">
		<span class="text-sm truncate block">{ runLogUploadLabel(entry.MediaType) }</span>
		if entry.MediaURL != "" && runLogIsImage(entry.MediaType) {
			<a
				if config.IsLocalURL(entry.MediaURL) {
					href={ templ.URL(entry.MediaURL + "?size=large") }
				} else {
					href={ templ.URL(entry.MediaURL) }
				}
				target="_blank"
				class="inline-block mt-2"
			>
				<img
					if config.IsLocalURL(entry.MediaURL) {
						src={ entry.MediaURL + "?size=small" }
					} else {
						src={ entry.MediaURL }
					}
					alt=""
					class="h-28 w-40 rounded-box object-cover border border-base-content/10"
				/>
			</a>
		}
	</div>
}
