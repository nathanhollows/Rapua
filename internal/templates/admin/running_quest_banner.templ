package templates

import "github.com/nathanhollows/Rapua/v8/models"

// LockedEditor prefixes the lock onto the pages the route middleware guards.
// Elsewhere the warning would only teach people to ignore it.
templ LockedEditor(quest models.Quest, contents templ.Component) {
	@questLock(quest)
	@contents
	// After the contents: an inline script runs as the parser reaches it, and
	// there is nothing to lock until the page it locks exists.
	@questLockScript(quest)
}

// questLock is one button and a confirmation.
templ questLock(quest models.Quest) {
	if quest.GetStatus() == models.Active {
		<button
			type="button"
			id="quest-unlock"
			class="btn btn-sm btn-outline btn-info"
			onclick="confirm_unlock_modal.showModal()"
		>
			@icon("lock", templ.Attributes{"class": "w-4 h-4"})
			Unlock editing
		</button>
		<dialog id="confirm_unlock_modal" class="modal modal-bottom sm:modal-middle">
			<div class="modal-box prose outline-2 outline-offset-1 outline-warning">
				<h3 class="text-lg font-bold">Edit a game that is running?</h3>
				<p class="pt-4">
					Players are in this game now. Changes reach them straight away and cannot be
					taken back: an objective you remove disappears from under whoever is standing
					at it.
				</p>
				<p>The safe alternative is to duplicate the game and edit the copy.</p>
				<div class="modal-action">
					<button type="button" class="btn" onclick="confirm_unlock_modal.close()">
						Leave it locked
					</button>
					<button type="button" id="quest-unlock-confirm" class="btn btn-warning">
						Unlock editing
					</button>
				</div>
				<form method="dialog">
					<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
				</form>
			</div>
		</dialog>
	}
}

// questLockScript relocates the button into the page's own nav and disables the
// editing controls until the unlock is confirmed.
//
// Both are done here rather than per page: there are four of these pages with
// four different headers. A reload drops the header, so the unlock cannot
// outlive the page that warned them.
templ questLockScript(quest models.Quest) {
	<script>
	// The lock publishes one fact and broadcasts when it changes: whether this
	// page may be edited, on document.body as data-quest-locked.
	//
	// Earlier versions held references to the drag surfaces they had to
	// disable. Those surfaces are destroyed and rebuilt by htmx swaps and by a
	// MutationObserver, on their own schedule, so every reference went stale
	// and the lock kept missing one. Reading a fact at creation time cannot go
	// stale: whoever builds last reads what is true then, and a change reaches
	// anything already built through the event.
	window.questLock = window.questLock || (() => {
		const state = { locked: false, unlocked: false };

		const publish = () => {
			document.body.dataset.questLocked = state.locked ? 'true' : 'false';
			document.body.dispatchEvent(new CustomEvent('quest-lock-change', {
				detail: { locked: state.locked },
			}));
		};

		return {
			isLocked: () => state.locked,
			// Re-apply what is already true, for markup that arrived without
			// it. Distinct from set(): a swap is not a statement about
			// whether this quest is running, and treating it as one revoked
			// an unlock the author had confirmed on this very page.
			reapply: publish,
			// Called by the page: a quest that is not running unlocks and stays
			// that way, so navigating between quests cannot leave an earlier
			// page's state behind.
			set(locked) {
				state.locked = locked;
				if (!locked) state.unlocked = false;
				publish();
			},
			// The author confirmed they mean it. Separate from set() because
			// this is what authorises the bypass header, and only a dialog the
			// author accepted on this page may do that.
			release() {
				state.unlocked = true;
				state.locked = false;
				publish();
			},
			bypasses: () => state.unlocked,
		};
	})();

	if (!window.__questLockBound) {
		window.__questLockBound = true;

		// One listener, not one per render: the script re-runs on every
		// hx-boost navigation, and stacked listeners kept an earlier page's
		// closure deciding what this one may do.
		document.body.addEventListener('htmx:configRequest', (event) => {
			if (window.questLock.bypasses()) event.detail.headers['X-Quest-Unlock'] = 'true';
		});

		// htmx swaps in markup carrying no lock state, so a refreshed tree
		// renders unlocked-looking and hidden controls come back.
		document.body.addEventListener('htmx:afterSwap', () => {
			window.questLock.reapply();
		});

		// Form controls and links are the lock's own business; drag surfaces
		// belong to whoever built them and are reached by the event.
		document.body.addEventListener('quest-lock-change', (event) => {
			const on = event.detail.locked;
			const main = document.querySelector('main');
			if (!main) return;

			main.querySelectorAll(
				'input:not([data-ignore-lock]), textarea, select, button:not([data-ignore-lock])'
			).forEach((el) => {
				if (el.closest('#quest-unlock, #confirm_unlock_modal')) return;
				el.disabled = on;
				// The cursor says "locked," not "broken": a disabled control
				// that still invites a click reads as a bug.
				el.classList.toggle('cursor-not-allowed', on);
			});
			// Links and <summary> are neither form controls nor disableable.
			// Hidden rather than dimmed for the add-child control, which only
			// appears on hover: a disabled-looking one would still invite the
			// hover that reveals it.
			main.querySelectorAll('[data-lock-hide]').forEach((el) => {
				el.classList.toggle('hidden', on);
			});
			main.querySelectorAll('details.settings-picker').forEach((el) => {
				if (on) el.open = false;
				el.classList.toggle('pointer-events-none', on);
			});
			main.querySelectorAll('.objective-drag-handle').forEach((el) => {
				el.classList.toggle('cursor-not-allowed', on);
				el.classList.toggle('cursor-move', !on);
			});
		});
	}
	</script>
	if quest.GetStatus() == models.Active {
	<script>
		(() => {
			const main = document.querySelector('main');
			const button = document.getElementById('quest-unlock');
			if (!main || !button) return;

			// The page nav is the row holding the page title.
			const header = main.querySelector('h1')?.parentElement;
			if (header) header.appendChild(button);

			window.questLock.set(true);

			document.getElementById('quest-unlock-confirm')?.addEventListener('click', () => {
				window.questLock.release();
				confirm_unlock_modal.close();
				// Not disabled: daisyUI drops the colour modifier on a
				// disabled button, and the warning is the point.
				button.classList.remove('btn-outline', 'btn-info');
				button.classList.add('btn-warning', 'pointer-events-none');
				button.setAttribute('aria-disabled', 'true');
				// The button is its own label: an earlier version wrote to a
				// separate element no template renders, so every unlock threw
				// here and the warning state never appeared.
				button.textContent = 'Editing a running game';
			});
		})();
	</script>
	} else {
		<script>
			// A quest that is not running is editable, and says so rather than
			// inheriting whatever the last page decided.
			window.questLock.set(false);
		</script>
	}
}
