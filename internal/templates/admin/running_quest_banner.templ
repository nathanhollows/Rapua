package templates

import "github.com/nathanhollows/Rapua/v8/models"

// LockedEditor prefixes the lock onto the pages the route middleware guards.
// Elsewhere the warning would only teach people to ignore it.
//
// The scope marker lets the lock tell editor pages apart after an hx-boost
// navigation, which keeps the lock's state and listeners alive across pages.
templ LockedEditor(quest models.Quest, contents templ.Component) {
	<div data-quest-lock-scope class="contents">
		@questLock(quest)
		@contents
	</div>
	// After the contents: the script runs as the parser reaches it, and needs
	// the page it locks to exist.
	@questLockScript(quest)
}

// questLock is the unlock control and its confirmation.
templ questLock(quest models.Quest) {
	if quest.GetStatus() == models.Active {
		<!-- Both states are rendered and the script toggles them. Restyling one
		button in script left it with neither state's classes. -->
		<span id="quest-unlock" class="inline-flex items-center shrink-0">
			<span
				data-lock-state="locked"
				class="tooltip tooltip-bottom"
				data-tip="Editing is locked while the game is running. Click to unlock."
			>
				<button type="button" class="btn btn-sm btn-warning btn-outline gap-1.5" onclick="confirm_unlock_modal.showModal()">
					@icon("lock", templ.Attributes{"class": "w-4 h-4 shrink-0"})
					<span class="hidden sm:inline">Unlock</span>
				</button>
			</span>
			<span
				data-lock-state="unlocked"
				class="tooltip tooltip-bottom hidden"
				data-tip="You are editing a running game. Click to lock it again."
			>
				<button type="button" id="quest-relock" class="btn btn-sm btn-warning gap-1.5">
					@icon("lock-open", templ.Attributes{"class": "w-4 h-4 shrink-0"})
					<span class="hidden sm:inline">Editing</span>
				</button>
			</span>
		</span>
		<dialog id="confirm_unlock_modal" class="modal modal-bottom sm:modal-middle">
			<div class="modal-box prose outline-2 outline-offset-1 outline-warning">
				<h3 class="text-lg font-bold">Edit a game that is running?</h3>
				<p class="pt-4">
					Players are in this game now. Changes reach them straight away and cannot be
					taken back: an objective you remove disappears from under whoever is standing
					at it.
				</p>
				<p>The safe alternative is to duplicate the game and edit the copy.</p>
				<div class="modal-action">
					<button type="button" class="btn" onclick="confirm_unlock_modal.close()">
						Leave it locked
					</button>
					<button type="button" id="quest-unlock-confirm" class="btn btn-warning">
						Unlock editing
					</button>
				</div>
				<form method="dialog">
					<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
				</form>
			</div>
		</dialog>
	}
}

// questLockScript moves the unlock button into the nav and disables the editing
// controls until the unlock is confirmed.
templ questLockScript(quest models.Quest) {
	<!-- Passed as data so a value that decides what may be edited is never
	spliced into script source. -->
	<span id="quest-lock-meta" class="hidden" data-quest-id={ quest.ID }></span>
	<script>
	// The lock publishes whether the page may be edited as data-quest-locked on
	// body and a quest-lock-change event. Holding references to the drag
	// surfaces went stale as htmx swaps rebuilt them; reading the fact when a
	// surface is built cannot.
	window.questLock = window.questLock || (() => {
		const state = { locked: false, unlocked: false, questID: '' };

		// sessionStorage, not localStorage: an unlock must not survive to a
		// later day. Keyed by quest so one unlock does not cover another.
		const key = (id) => 'rapua.unlock.' + id;
		const remember = (id) => {
			// Failing to store only means confirming again, the safe direction.
			try { sessionStorage.setItem(key(id), '1'); } catch {}
		};
		const forget = (id) => {
			try { sessionStorage.removeItem(key(id)); } catch {}
		};
		const remembered = (id) => {
			try { return !!id && sessionStorage.getItem(key(id)) === '1'; } catch { return false; }
		};

		const publish = () => {
			document.body.dataset.questLocked = state.locked ? 'true' : 'false';
			document.body.dispatchEvent(new CustomEvent('quest-lock-change', {
				detail: { locked: state.locked },
			}));
		};

		return {
			isLocked: () => state.locked,
			// Not set(): a swap says nothing about whether the quest is
			// running, and set() revoked unlocks confirmed on this page.
			reapply: publish,
			// A stopped quest forgets its unlock so restarting it asks again.
			set(locked, questID) {
				if (questID) state.questID = questID;
				state.locked = locked;
				if (!locked) {
					state.unlocked = false;
					// Only when the page names a quest: leaving for a page
					// without one must not erase the unlock it left behind.
					if (questID) forget(questID);
				} else if (remembered(state.questID)) {
					state.locked = false;
					state.unlocked = true;
				}
				publish();
			},
			// Separate from set() because this authorises the bypass header,
			// which only an accepted dialog may do.
			release() {
				state.unlocked = true;
				state.locked = false;
				remember(state.questID);
				publish();
			},
			relock() {
				state.unlocked = false;
				state.locked = true;
				forget(state.questID);
				publish();
			},
			bypasses: () => state.unlocked,
		};
	})();

	if (!window.__questLockBound) {
		window.__questLockBound = true;

		// Bound once: the script re-runs on every hx-boost navigation, and
		// stacked listeners kept an earlier page's closure in charge.
		document.body.addEventListener('htmx:configRequest', (event) => {
			if (window.questLock.bypasses()) event.detail.headers['X-Quest-Unlock'] = 'true';
		});

		// Swapped-in markup carries no lock state. Off the editor pages the
		// lock is released instead, so it does not disable unrelated controls.
		document.body.addEventListener('htmx:afterSwap', () => {
			if (!document.querySelector('[data-quest-lock-scope]')) {
				window.questLock.set(false);
				return;
			}
			window.questLock.reapply();
		});

		// Drag surfaces belong to whoever built them and react to the event.
		document.body.addEventListener('quest-lock-change', (event) => {
			const on = event.detail.locked;
			const main = document.querySelector('main');
			if (!main) return;

			main.querySelectorAll(
				'input:not([data-ignore-lock]), textarea, select, button:not([data-ignore-lock])'
			).forEach((el) => {
				if (el.closest('#quest-unlock, #confirm_unlock_modal')) return;
				el.disabled = on;
				el.classList.toggle('cursor-not-allowed', on);
			});
			// Links and <summary> cannot be disabled. Hidden rather than dimmed,
			// since a dimmed hover-only control still invites the hover.
			main.querySelectorAll('[data-lock-hide]').forEach((el) => {
				el.classList.toggle('hidden', on);
			});
			// Dimmed as well: inert outlined buttons look broken.
			main.querySelectorAll('details.settings-picker').forEach((el) => {
				if (on) el.open = false;
				el.classList.toggle('pointer-events-none', on);
				el.classList.toggle('opacity-50', on);
			});
			main.querySelectorAll('.objective-drag-handle').forEach((el) => {
				el.classList.toggle('cursor-not-allowed', on);
				el.classList.toggle('cursor-move', !on);
			});
		});
	}
	</script>
	if quest.GetStatus() == models.Active {
	<script>
		(() => {
			const main = document.querySelector('main');
			const button = document.getElementById('quest-unlock');
			if (!main || !button) return;

			// Lives in the nav beside the status: it is about the quest, not
			// the page.
			const slot = document.getElementById('quest-unlock-slot');
			if (slot) slot.appendChild(button);

			const questID = document.getElementById('quest-lock-meta')?.dataset.questId;

			const locked = button.querySelector('[data-lock-state="locked"]');
			const unlocked = button.querySelector('[data-lock-state="unlocked"]');
			const show = (which) => {
				locked?.classList.toggle('hidden', which !== 'locked');
				unlocked?.classList.toggle('hidden', which !== 'unlocked');
			};
			const showUnlocked = () => show('unlocked');

			window.questLock.set(true, questID);
			// An unlock restored from an earlier page must show as unlocked, or
			// the page looks locked while edits save.
			if (window.questLock.bypasses()) showUnlocked();

			document.getElementById('quest-unlock-confirm')?.addEventListener('click', () => {
				window.questLock.release();
				confirm_unlock_modal.close();
				showUnlocked();
			});

			// No confirmation: relocking is the safe direction.
			document.getElementById('quest-relock')?.addEventListener('click', () => {
				window.questLock.relock();
				show('locked');
			});
		})();
	</script>
	} else {
		<script>
			// The id lets set() drop a remembered unlock once the game stops.
			window.questLock.set(
				false,
				document.getElementById('quest-lock-meta')?.dataset.questId,
			);
		</script>
	}
}
