package templates

import "github.com/nathanhollows/Rapua/v8/models"

// LockedEditor prefixes the lock onto the pages the route middleware guards.
// Elsewhere the warning would only teach people to ignore it.
templ LockedEditor(quest models.Quest, contents templ.Component) {
	@questLock(quest)
	@contents
	// After the contents: an inline script runs as the parser reaches it, and
	// there is nothing to lock until the page it locks exists.
	@questLockScript(quest)
}

// questLock is one button and a confirmation.
templ questLock(quest models.Quest) {
	if quest.GetStatus() == models.Active {
		<button
			type="button"
			id="quest-unlock"
			class="btn btn-sm btn-outline btn-info"
			onclick="confirm_unlock_modal.showModal()"
		>
			@icon("lock", templ.Attributes{"class": "w-4 h-4"})
			Unlock editing
		</button>
		<dialog id="confirm_unlock_modal" class="modal modal-bottom sm:modal-middle">
			<div class="modal-box prose outline-2 outline-offset-1 outline-warning">
				<h3 class="text-lg font-bold">Edit a game that is running?</h3>
				<p class="pt-4">
					Players are in this game now. Changes reach them straight away and cannot be
					taken back: an objective you remove disappears from under whoever is standing
					at it.
				</p>
				<p>The safe alternative is to duplicate the game and edit the copy.</p>
				<div class="modal-action">
					<button type="button" class="btn" onclick="confirm_unlock_modal.close()">
						Leave it locked
					</button>
					<button type="button" id="quest-unlock-confirm" class="btn btn-warning">
						Unlock editing
					</button>
				</div>
				<form method="dialog">
					<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
				</form>
			</div>
		</dialog>
	}
}

// questLockScript relocates the button into the page's own nav and disables the
// editing controls until the unlock is confirmed.
//
// Both are done here rather than per page: there are four of these pages with
// four different headers. A reload drops the header, so the unlock cannot
// outlive the page that warned them.
templ questLockScript(quest models.Quest) {
	if quest.GetStatus() == models.Active {
	<script>
		(() => {
			const main = document.querySelector('main');
			const button = document.getElementById('quest-unlock');
			if (!main || !button) return;

			// The page nav is the row holding the page title.
			const header = main.querySelector('h1')?.parentElement;
			if (header) header.appendChild(button);

			const lock = (on) => {
				main.querySelectorAll(
					'input, textarea, select, button:not([data-ignore-lock])'
				).forEach((el) => {
					if (el.closest('#quest-unlock, #confirm_unlock_modal')) return;
					el.disabled = on;
				});
				// Drag handles are icons, not form controls, so the loop above
				// misses them and a locked tree would still accept a drag. The
				// server refuses the POST, but the card would sit where the
				// database does not have it.
				document.querySelectorAll('#objective-tree .objective-children').forEach((list) => {
					if (list._objectiveSortable) list._objectiveSortable.option('disabled', on);
				});
			};

			let unlocked = false;
			document.body.addEventListener('htmx:configRequest', (event) => {
				if (unlocked) event.detail.headers['X-Quest-Unlock'] = 'true';
			});

			lock(true);
			document.getElementById('quest-unlock-confirm')?.addEventListener('click', () => {
				unlocked = true;
				lock(false);
				confirm_unlock_modal.close();
				// Not disabled: daisyUI drops the colour modifier on a
				// disabled button, and the warning is the point.
				button.classList.remove('btn-outline', 'btn-info');
				button.classList.add('btn-warning', 'pointer-events-none');
				button.setAttribute('aria-disabled', 'true');
				document.getElementById('quest-unlock-label').textContent = 'Editing a running game';
			});
		})();
	</script>
	}
}
