package templates

import "github.com/nathanhollows/Rapua/v8/internal/templates/brand"

// NotFound is an unknown address inside the admin: the site's own 404, framed by the
// admin's bar.
templ NotFound() {
	<div class="flex flex-col justify-center px-6 py-12 lg:px-8">
		@brand.NotFound()
	</div>
}
