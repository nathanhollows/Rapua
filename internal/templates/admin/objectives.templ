package templates

import (
	"fmt"
	"strings"

	"github.com/nathanhollows/Rapua/v8/blocks"
	bTemplates "github.com/nathanhollows/Rapua/v8/internal/templates/blocks"
	"github.com/nathanhollows/Rapua/v8/models"
)


type EditObjectiveData struct {
	Settings     models.QuestSettings
	Objective    models.Objective
	ProofBlocks  blocks.Blocks
	RevealBlocks blocks.Blocks
	// ChildCount: routing/band/max_next mean nothing without children, but a
	// leaf can gain them later, so they're shown regardless.
	ChildCount int
	// DependsOptions lists valid depends values: other objective slugs plus sets vars.
	DependsOptions []string
}

// TotalPoints is the objective's point value: the sum of its proof and reveal
// blocks' points, not a field of its own.
func (data EditObjectiveData) TotalPoints() int {
	total := 0
	for _, b := range data.ProofBlocks {
		total += b.GetPoints()
	}
	for _, b := range data.RevealBlocks {
		total += b.GetPoints()
	}
	return total
}

// visibilityBtnTip names what a click on the visibility button does.
func visibilityBtnTip(draft bool) string {
	if draft {
		return "Draft: click to publish"
	}
	return "Published: click to park"
}

// bandValueStr renders nil as blank, so the input's own placeholder shows
// through instead of a literal "0".
func bandValueStr(bound *int) string {
	if bound == nil {
		return ""
	}
	return fmt.Sprint(*bound)
}

// MaxNextBound renders 0 as nil: 0 means no limit, not an explicit cap.
func (data EditObjectiveData) MaxNextBound() *int {
	if data.Objective.MaxNext == 0 {
		return nil
	}
	v := data.Objective.MaxNext
	return &v
}

// objectiveColors matches the [data-group-color=...] rules in main.css.
var objectiveColors = []string{"primary", "secondary", "accent", "warning", "error", "info", "success", "base-content"}

// EditObjective mirrors EditLocation's two-zone layout. The zones keep the
// literal #nav-blocks/#content-blocks/#nav-tab/#content-tab ids so
// previewSortableScript() works unmodified: #content-tab/#content-blocks is
// the default-active pairing (here: Proof, matching Location's default-active
// Content zone), #nav-tab/#nav-blocks is the secondary pairing (here: Reveal).
templ EditObjective(data EditObjectiveData) {
	<!-- Header -->
	<div class="flex flex-col sm:flex-row gap-3 justify-between items-center w-full p-5">
		<div class="flex items-center gap-3">
			<h1 id="objective-title" class="text-2xl font-bold">{ data.Objective.Title }</h1>
			if data.Settings.EnablePoints && data.TotalPoints() != 0 {
				<span class="badge badge-ghost tooltip tooltip-right" data-tip="Sum of this objective's proof and reveal block points">
					{ fmt.Sprintf("%d pts", data.TotalPoints()) }
				</span>
			}
		</div>
		<div class="flex gap-3">
			<button
				id="visibility-btn"
				type="button"
				class="btn btn-ghost tooltip"
				data-tip={ visibilityBtnTip(data.Objective.Draft) }
				_="on click
					set cb to #published-checkbox
					set cb.checked to not cb.checked
					send change to cb
					if cb.checked
						add .hidden to #visibility-eye-off
						remove .hidden from #visibility-eye
						set #visibility-label's textContent to 'Published'
					else
						add .hidden to #visibility-eye
						remove .hidden from #visibility-eye-off
						set #visibility-label's textContent to 'Draft'
					end"
			>
				<span id="visibility-eye" class={ templ.KV("hidden", data.Objective.Draft) }>
					@icon("eye", templ.Attributes{"class": "w-4 h-4"})
				</span>
				<span id="visibility-eye-off" class={ templ.KV("hidden", !data.Objective.Draft) }>
					@icon("eye-closed", templ.Attributes{"class": "w-4 h-4 text-warning"})
				</span>
				<span id="visibility-label">
					if data.Objective.Draft {
						Draft
					} else {
						Published
					}
				</span>
			</button>
			<input
				type="checkbox"
				id="published-checkbox"
				name="published"
				value="true"
				form="edit-objective"
				class="hidden"
				checked?={ !data.Objective.Draft }
			/>
			<button type="button" class="btn btn-error" onclick="confirm_delete_modal.showModal();">
				@icon("trash-2", templ.Attributes{"class": "w-4 h-4"})
				Delete
			</button>
			<form
				id="edit-objective"
				hx-post={ fmt.Sprint("/admin/objective/", data.Objective.Slug) }
				hx-trigger="click, saveobjective delay:500ms, keyup from:[form=edit-objective] delay:500ms, change from:[form=edit-objective] delay:500ms"
				hx-swap="none"
			>
				<button
					id="edit-objective-btn"
					class="btn btn-primary"
					type="submit"
				>
					@icon("save", templ.Attributes{"class": "w-4 h-4"})
					Save
				</button>
			</form>
		</div>
	</div>
	<div
		class="flex flex-col lg:flex-row w-full gap-8 p-5 pt-0"
		_="on click in #nav-blocks
			if #nav-tab does not match .tab-active
				send click to #nav-tab
			end
		on click in #content-blocks
			if #content-tab does not match .tab-active
				send click to #content-tab
			end
		on htmx:afterSwap from #nav-blocks
			call _hyperscript.processNode(event.detail.target)
		on htmx:afterSwap from #content-blocks
			call _hyperscript.processNode(event.detail.target)
		"
	>
		<div class="flex flex-col flex-grow min-w-0">
			<div class="flex flex-col sm:flex-row gap-5 mb-5">
				<fieldset class="fieldset w-full">
					<legend class="fieldset-legend">Objective Title</legend>
					<input
						type="text"
						id="title"
						name="title"
						form="edit-objective"
						class="input w-full"
						value={ data.Objective.Title }
						placeholder="Objective title"
						_="
						on input
						set #objective-title's textContent to my value"
					/>
				</fieldset>
			</div>
			<!-- Structural settings -->
			<section class="mb-5">
				<h2 class="font-bold mb-3">Settings</h2>
				<div class="grid sm:grid-cols-2 gap-5">
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Routing</legend>
						<select name="routing" form="edit-objective" class="select w-full">
							<!-- The zero value plays as free roam, and without
							this entry any unrelated save would submit the first
							listed strategy instead of what is stored. -->
							<option value="" selected?={ data.Objective.Routing == "" }>Default (free roam)</option>
							for _, rs := range models.GetRouteStrategies() {
								<option value={ string(rs) } selected?={ data.Objective.Routing == rs }>{ rs.String() }</option>
							}
						</select>
						<p class="label">
							if data.ChildCount == 0 {
								Order children are offered in. This objective has none yet.
							} else {
								{ fmt.Sprintf("Order %d children are offered in.", data.ChildCount) }
							}
						</p>
					</fieldset>
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Color</legend>
						<select name="color" form="edit-objective" class="select w-full">
							<option value="" selected?={ data.Objective.Color == "" }>Default</option>
							for _, c := range objectiveColors {
								<option value={ c } selected?={ data.Objective.Color == c }>{ c }</option>
							}
						</select>
						<p class="label">A display hint only.</p>
					</fieldset>
					<fieldset class="fieldset sm:col-span-2" id="band-inputs" data-child-count={ fmt.Sprint(data.ChildCount) }>
						<legend class="fieldset-legend">Completion band</legend>
						<div class="flex items-center gap-3 flex-wrap">
							<input
								type="number"
								name="children_min"
								form="edit-objective"
								min="0"
								class="input w-24"
								value={ bandValueStr(data.Objective.ChildrenMin) }
								placeholder="0"
							/>
							<span class="opacity-60">to</span>
							<input
								type="number"
								name="children_max"
								form="edit-objective"
								min="0"
								class="input w-24"
								value={ bandValueStr(data.Objective.ChildrenMax) }
								placeholder={ fmt.Sprint(data.ChildCount) }
							/>
							<span id="band-explainer" class="text-sm opacity-70"></span>
						</div>
						<p class="label">
							{ fmt.Sprintf("Leave both blank to require all %d children.", data.ChildCount) }
						</p>
					</fieldset>
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Randomised window</legend>
						<input
							type="number"
							name="max_next"
							form="edit-objective"
							min="0"
							class="input w-full"
							value={ bandValueStr(data.MaxNextBound()) }
							placeholder="No limit"
						/>
						<p class="label">Children offered at once, when routing is Randomised.</p>
					</fieldset>
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Finish button label</legend>
						<input
							type="text"
							name="finish_label"
							form="edit-objective"
							class="input w-full"
							value={ data.Objective.FinishLabel }
							placeholder="Finish"
						/>
						<p class="label">Shown only when the band lets a player finish early.</p>
					</fieldset>
					<fieldset class="fieldset sm:col-span-2">
						<legend class="fieldset-legend">Depends on</legend>
						<input
							type="text"
							name="depends"
							form="edit-objective"
							list="depends-options"
							class="input w-full"
							value={ strings.Join(data.Objective.Depends, ", ") }
							placeholder="top-notes, not heart-notes"
						/>
						<datalist id="depends-options">
							for _, opt := range data.DependsOptions {
								<option value={ opt }></option>
							}
						</datalist>
						<p class="label">
							Comma-separated. An objective slug or a sets var; prefix an entry with "not " to negate it.
							All must hold for this objective to be reachable.
						</p>
					</fieldset>
				</div>
			</section>
			@bandExplainerScript()
		@deleteBlockModal()
			<!-- Proof -->
			<section>
				@blockAddButton(data.Objective.ID, blocks.ContextObjectiveProof, ".blocks")
				<div
					id="content-blocks"
					class="blocks flex flex-col gap-5"
				>
					for _, block := range data.ProofBlocks {
						@bTemplates.RenderAdminBlock(data.Settings, block, len(data.ProofBlocks) < 4)
					}
				</div>
			</section>
			<!-- Reveal -->
			@blockAddButton(data.Objective.ID, blocks.ContextObjectiveReveal, ".blocks")
			<div
				id="nav-blocks"
				class="blocks flex flex-col gap-5"
			>
				for _, block := range data.RevealBlocks {
					@bTemplates.RenderAdminBlock(data.Settings, block, len(data.RevealBlocks) < 4)
				}
			</div>
		</div>
		<!-- Preview -->
		<div class="h-min sticky top-3">
			<div id="preview-nav" role="tablist" class="tabs tabs-box tabs-sm font-bold m-auto mb-3">
				<a
					id="content-tab"
					role="tab"
					data-url={ fmt.Sprint("/objective/", data.Objective.Slug, "?zone=proof") }
					class="tab transition-colors grow tab-active"
					_="on click
					remove .tab-active from <#preview-nav a.tab-active />
					add .tab-active to me
					trigger changePreviewPage
				"
				>
					Proof
				</a>
				<a
					id="nav-tab"
					role="tab"
					class="tab transition-colors grow"
					data-url={ fmt.Sprint("/objective/", data.Objective.Slug, "?zone=reveal") }
					_="on click
					remove .tab-active from <#preview-nav a.tab-active />
					add .tab-active to me
					trigger changePreviewPage
				"
				>
					Reveal
				</a>
			</div>
			<div class="mockup-phone bg-black h-min shadow-2xl">
				<div class="mockup-phone-display overflow-y-scroll overflow-x-hidden bg-base-100 w-96">
					<div
						id="mobile-preview-container"
						class="sm:mx-auto sm:w-full sm:max-w-sm block overflow-y-scroll p-5 py-12 bg-base-200/50 min-h-full"
						hx-get={ fmt.Sprint("/objective/", data.Objective.Slug, "?zone=proof") }
						hx-trigger={ fmt.Sprintf("load, %s", "htmx:afterRequest from:.blocks, htmx:afterRequest from:#edit-objective-btn, htmx:afterRequest from:#delete-block-btn") }
						hx-vals={ fmt.Sprint(`{"questID": "`, data.Settings.QuestID, `"}`) }
						hx-swap="innerHTML"
						_="on changePreviewPage from <body/>
					set @hx-get to event.detail.sender.dataset.url
					then call htmx.process(me)
					then trigger load"
					></div>
				</div>
			</div>
		</div>
	</div>
	<!-- Hidden form for block reordering via HTMX -->
	@blockReorderForm()
	<dialog id="confirm_delete_modal" class="modal modal-bottom sm:modal-middle">
		<div class="modal-box prose outline-2 outline-offset-1 outline-error">
			<h3 class="text-lg font-bold">Delete this objective?</h3>
			<p class="pt-4">You are about to delete this objective. Are you sure?</p>
			<div class="modal-action">
				<button
					type="button"
					class="btn"
					onclick="confirm_delete_modal.close()"
				>Nevermind</button>
				<button
					type="button"
					class="btn btn-error"
					hx-delete={ fmt.Sprint("/admin/objective/", data.Objective.Slug) }
					hx-trigger="click"
					onclick="confirm_delete_modal.close()"
				>Delete</button>
			</div>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
		</div>
	</dialog>
	@previewSortableScript()
	@blockMoveScript()
	@sortableStyles()
}

// bandExplainerScript shows the band's plain-language meaning live: min==max
// vs min<max is easy to misread from raw numbers alone.
templ bandExplainerScript() {
	<script>
	(function() {
		var wrap = document.getElementById('band-inputs');
		if (!wrap) return;
		var min = wrap.querySelector('[name="children_min"]');
		var max = wrap.querySelector('[name="children_max"]');
		var explainer = document.getElementById('band-explainer');
		var n = parseInt(wrap.dataset.childCount, 10) || 0;

		function update() {
			var minV = min.value === '' ? null : parseInt(min.value, 10);
			var maxV = max.value === '' ? null : parseInt(max.value, 10);
			var text;
			if (minV === null && maxV === null) {
				text = 'Requires all ' + n + ' children.';
			} else {
				var lo = minV === null ? 0 : minV;
				var hi = maxV === null ? n : maxV;
				if (lo >= hi) {
					text = 'Completes automatically once ' + hi + ' of ' + n + ' are done.';
				} else {
					text = 'Finish button from ' + lo + '; completes automatically at ' + hi + ' of ' + n + '.';
				}
			}
			explainer.textContent = text;
		}

		min.addEventListener('input', update);
		max.addEventListener('input', update);
		update();
	})();
	</script>
}
