package templates

import (
	"fmt"

	"github.com/nathanhollows/Rapua/v8/blocks"
	"github.com/nathanhollows/Rapua/v8/internal/services"
	bTemplates "github.com/nathanhollows/Rapua/v8/internal/templates/blocks"
	pTemplates "github.com/nathanhollows/Rapua/v8/internal/templates/players"
	"github.com/nathanhollows/Rapua/v8/models"
)


type EditObjectiveData struct {
	Settings     models.QuestSettings
	Objective    models.Objective
	ProofBlocks  blocks.Blocks
	RevealBlocks blocks.Blocks
	// ChildCount: routing/band/max_next mean nothing without children, but a
	// leaf can gain them later, so they're shown regardless.
	ChildCount int
	// QuestName labels the preview's chrome, which shows the player's view.
	QuestName string
	// ParentTitle and ParentRule describe the containing section, drawn around
	// the preview row. Empty when the parent is the root.
	ParentTitle string
	ParentRule  string
	// Lint is the whole quest's run, not this objective's slice of it: the
	// root's diagnostics live with the quest and this is the only page that
	// can act on them.
	Lint services.QuestLint
}

// TotalPoints is the objective's point value: the sum of its proof and reveal
// blocks' points, not a field of its own.
func (data EditObjectiveData) TotalPoints() int {
	total := 0
	for _, b := range data.ProofBlocks {
		total += b.GetPoints()
	}
	for _, b := range data.RevealBlocks {
		total += b.GetPoints()
	}
	return total
}

// FirstProofIcon is the icon of the first proof block that asks the player for
// something, matching the player's own row. Empty when none does.
func (data EditObjectiveData) FirstProofIcon() string {
	for _, block := range data.ProofBlocks {
		if block.RequiresValidation() {
			return block.GetIconSVG()
		}
	}
	return ""
}

// zoneWords holds a zone's labels and element ids. The ids are written back
// into by the preview's drag mirror: renaming them silently breaks reordering.
type zoneWords struct {
	Name      string
	Why       string
	AddLabel  string
	Param     string
	ListID    string
	PreviewID string
	proof     bool
}

func zoneWordsFor(zone blocks.BlockContext) zoneWords {
	if zone == blocks.ContextObjectiveReveal {
		return zoneWords{
			Name:      "Reveal",
			Why:       "what they get once the proof is cleared",
			AddLabel:  "Add to Reveal",
			Param:     "reveal",
			ListID:    "nav-blocks",
			PreviewID: "preview-reveal",
		}
	}
	return zoneWords{
		Name:      "Proof",
		Why:       "what they do here to complete it",
		AddLabel:  "Add to Proof",
		Param:     "proof",
		ListID:    "content-blocks",
		PreviewID: "preview-proof",
		proof:     true,
	}
}

func (z zoneWords) Blocks(data EditObjectiveData) blocks.Blocks {
	if z.proof {
		return data.ProofBlocks
	}
	return data.RevealBlocks
}

// visibilityBtnTip names what a click on the visibility button does.
func visibilityBtnTip(draft bool) string {
	if draft {
		return "Draft: click to publish"
	}
	return "Published: click to park"
}

// bandValueStr renders nil as blank, so the input's own placeholder shows
// through instead of a literal "0".
func bandValueStr(bound *int) string {
	if bound == nil {
		return ""
	}
	return fmt.Sprint(*bound)
}

// MaxNextBound renders 0 as nil: 0 means no limit, not an explicit cap.
func (data EditObjectiveData) MaxNextBound() *int {
	if data.Objective.MaxNext == 0 {
		return nil
	}
	v := data.Objective.MaxNext
	return &v
}

// objectivePreview is the one preview phone, switched by scroll position. The
// pills name the loaded view so the automatic switch does not read as a glitch,
// and scroll the form to a zone when clicked.
templ objectivePreview(data EditObjectiveData) {
	<div class="hidden lg:block">
		<div class="sticky top-3 flex flex-col gap-2">
			<!-- The active pill carries the primary colour: it is the one piece of
			state on this page that changes without being asked, so it has to be
			unmissable rather than merely different. -->
			<div id="preview-pills" role="tablist" class="tabs tabs-box tabs-sm w-full">
				<a role="tab" data-pill="card" class="tab grow tab-active">In the list</a>
				<a role="tab" data-pill="proof" class="tab grow">Proof</a>
				<a role="tab" data-pill="reveal" class="tab grow">Reveal</a>
			</div>
			<div class="mockup-phone bg-black shadow-2xl">
				<div class="mockup-phone-display overflow-hidden bg-base-200 w-96">
					@pTemplates.PreviewChrome(data.QuestName) {
						<!-- Stacked rather than swapped, so one can fade out while
						the next fades in. display:none cannot be transitioned, so
						the panes are always rendered and always in place. -->
						<div class="relative h-full">
						<div data-preview="card" class="absolute inset-0 p-4 flex flex-col justify-center transition-opacity duration-200 motion-reduce:transition-none">
							if data.ParentTitle != "" {
								@pTemplates.PreviewSection(data.ParentTitle, data.ParentRule) {
									@objectiveCardRow(data)
								}
							} else {
								@objectiveCardRow(data)
							}
						</div>
						<!-- Refetched when blocks change, not on view change, so
						scrolling does not flicker. -->
						<div
							data-preview="proof"
							data-blocks-target="content-blocks"
							class="absolute inset-0 p-4 overflow-y-auto overflow-x-hidden opacity-0 pointer-events-none transition-opacity duration-200 motion-reduce:transition-none"
							hx-get={ fmt.Sprint("/objective/", data.Objective.Slug, "?zone=proof") }
							hx-trigger="load, htmx:afterRequest from:.blocks, htmx:afterRequest from:#edit-objective, htmx:afterRequest from:#delete-block-btn"
							hx-vals={ fmt.Sprint(`{"questID": "`, data.Settings.QuestID, `"}`) }
							hx-swap="innerHTML"
						></div>
						<div
							data-preview="reveal"
							data-blocks-target="nav-blocks"
							class="absolute inset-0 p-4 overflow-y-auto overflow-x-hidden opacity-0 pointer-events-none transition-opacity duration-200 motion-reduce:transition-none"
							hx-get={ fmt.Sprint("/objective/", data.Objective.Slug, "?zone=reveal") }
							hx-trigger="load, htmx:afterRequest from:.blocks, htmx:afterRequest from:#edit-objective, htmx:afterRequest from:#delete-block-btn"
							hx-vals={ fmt.Sprint(`{"questID": "`, data.Settings.QuestID, `"}`) }
							hx-swap="innerHTML"
						></div>
						</div>
					}
				</div>
			</div>
			if data.FirstProofIcon() == "" {
				<p class="text-xs opacity-40 text-center">No proof yet, so this opens straight to its reveal.</p>
			}
		</div>
	</div>
	@objectivePreviewScript()
	@previewHoverScript()
	@previewSortableScript()
}

// objectiveCardRow is the row itself, drawn the same whether or not it sits
// inside a container.
templ objectiveCardRow(data EditObjectiveData) {
	<div id="objective-card" class="flex items-start gap-3 rounded-box border border-base-300 bg-base-100 px-4 py-3">
			if proofIcon := data.FirstProofIcon(); proofIcon != "" {
				<span class="shrink-0 mt-0.5 text-primary [&>svg]:w-5 [&>svg]:h-5">
					@templ.Raw(proofIcon)
				</span>
			} else {
				@icon("book-open", templ.Attributes{"class": "w-5 h-5 shrink-0 mt-0.5 opacity-40"})
			}
			<span class="grow min-w-0 flex flex-col gap-0.5">
				<span id="objective-card-title" class="text-sm font-medium text-pretty">
					{ data.Objective.Title }
				</span>
				<span
					id="objective-card-description"
					class={ "text-xs opacity-60 text-pretty", templ.KV("hidden", data.Objective.Description == "") }
				>
					{ data.Objective.Description }
				</span>
			</span>
			if data.Settings.EnablePoints && data.TotalPoints() != 0 {
				<span class="badge badge-ghost badge-sm shrink-0">{ fmt.Sprintf("%d pts", data.TotalPoints()) }</span>
			}
	</div>
}

// objectiveDescription is the second half of the task: the detail a player
// needs once they are there. Called description rather than context, this
// codebase's word for proof and reveal, and rather than instruction, which is
// what the title is.
templ objectiveDescription(data EditObjectiveData) {
	<fieldset class="fieldset w-full">
		<legend class="fieldset-legend">Description</legend>
		<textarea
			id="description"
			name="description"
			form="edit-objective"
			rows="2"
			maxlength="280"
			class="textarea w-full"
			placeholder="Second bed on the left, past the glasshouse. The label is on a metal stake."
			_="on input
				set #objective-card-description's textContent to my value
				then if my value is '' then
					add .hidden to #objective-card-description
				else
					remove .hidden from #objective-card-description
				end"
		>{ data.Objective.Description }</textarea>
		<p class="label text-xs">Shown under the task when they open it, and on the quest list.</p>
	</fieldset>
}

// objectiveLinkRow shows the objective's URL and makes changing it explicit.
// The slug is visible to players, and a title that names the task would give
// the answer away in the address bar. Scan codes belong to the scan block, so
// printed QRs survive a slug change.
templ objectiveLinkRow(data EditObjectiveData) {
	<div class="flex flex-col gap-1">
		<div class="flex items-center gap-2 text-sm">
			@icon("link", templ.Attributes{"class": "w-3.5 h-3.5 opacity-40 shrink-0"})
			<code class="font-mono text-xs opacity-70">
				{ fmt.Sprint("/objective/", data.Objective.Slug) }
			</code>
		</div>
		<p class="label text-xs">
			Players can see this. Keep it vague if the task name would give the answer away.
		</p>
	</div>
}

// objectivePreviewScript shows the preview for the zone in view. The topmost
// intersecting section wins, so the handover happens as a zone reaches the top
// rather than when it covers the most pixels.
templ objectivePreviewScript() {
	<script>
	(() => {
		const sections = [...document.querySelectorAll('[data-zone]')];
		const panes = [...document.querySelectorAll('[data-preview]')];
		const pills = [...document.querySelectorAll('[data-pill]')];
		if (!sections.length || !panes.length) return;

		let current = null;
		const show = (zone) => {
			if (zone === current) return;
			current = zone;
			panes.forEach((p) => {
				const off = p.dataset.preview !== zone;
				p.classList.toggle('opacity-0', off);
				p.classList.toggle('pointer-events-none', off);
			});
			pills.forEach((p) => p.classList.toggle('tab-active', p.dataset.pill === zone));
		};

		pills.forEach((pill) => {
			pill.addEventListener('click', () => {
				const target = document.getElementById('zone-' + pill.dataset.pill);
				if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		});

		const seen = new Set();
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				entry.isIntersecting ? seen.add(entry.target) : seen.delete(entry.target);
			});
			// Document order keeps the handover the same in both directions.
			const top = sections.find((section) => seen.has(section));
			if (top) show(top.dataset.zone);
		}, { rootMargin: '-10% 0px -60% 0px' });

		sections.forEach((section) => observer.observe(section));
		show('card');
	})();
	</script>
}

// objectiveSaveState confirms an autosave landed, since there is no save button.
templ objectiveSaveState() {
	<span
		id="save-state"
		class="text-xs opacity-0 transition-opacity flex items-center gap-1.5"
		_="on htmx:beforeRequest from #edit-objective
			set my textContent to 'Saving'
			then remove .opacity-0 from me
		on htmx:afterRequest from #edit-objective
			set my textContent to 'Saved'
			then wait 2s
			then add .opacity-0 to me"
	></span>
}

templ objectiveZone(data EditObjectiveData, zone blocks.BlockContext) {
	{{ z := zoneWordsFor(zone) }}
	<section id={ "zone-" + z.Param } data-zone={ z.Param } class="min-w-0 scroll-mt-4">
		<!-- Not sticky: a pinned bar cut off the hover outline of blocks
		scrolling under it. -->
		<h2 class="pb-3 flex items-baseline gap-3">
			<span class="font-bold">{ z.Name }</span>
			<span class="text-xs opacity-60">{ z.Why }</span>
		</h2>
		<div id={ z.ListID } class="blocks flex flex-col gap-5">
			for _, block := range z.Blocks(data) {
				@bTemplates.RenderAdminBlock(data.Settings, block, len(z.Blocks(data)) < 4)
			}
		</div>
		@blockAddButton(data.Objective.ID, zone, ".blocks", z.AddLabel)
	</section>
}

// EditObjective autosaves: there is no save button.
templ EditObjective(data EditObjectiveData) {
	<!-- Typing waits a second because every save re-lints the whole quest.
	Discrete changes fire sooner. -->
	<form
		id="edit-objective"
		hx-post={ fmt.Sprint("/admin/objective/", data.Objective.Slug) }
		hx-trigger="keyup from:[form=edit-objective] delay:1s, change from:[form=edit-objective] delay:500ms"
		hx-swap="none"
	></form>
	<!-- Matches the quest page's header so the lock badge, appended into
	#quest-title-group at runtime, lands in the same place on both. -->
	<div class="flex flex-col gap-3 md:flex-row justify-between items-center w-full px-6 pt-5 pb-3">
		<div id="quest-title-group" class="flex items-center gap-3 min-w-0">
			<h1 class="text-2xl font-bold">Objective</h1>
			if data.ParentTitle != "" {
				<span class="text-sm opacity-50 truncate hidden sm:inline">in { data.ParentTitle }</span>
			}
		</div>
		<div class="flex items-center gap-2">
		@objectiveSaveState()
		<div id="visibility-control" class="contents">
			@objectiveVisibilityControl(data.Objective.Draft)
		</div>
		<!-- In a menu so an irreversible action is not at primary weight. -->
		<details class="dropdown dropdown-end">
			<summary class="btn btn-sm btn-ghost btn-circle" aria-label="More actions">
				@icon("ellipsis", templ.Attributes{"class": "w-4 h-4"})
			</summary>
			<ul class="dropdown-content menu bg-base-100 rounded-box z-20 w-56 p-2 shadow-lg border border-base-300">
				<li>
					<button type="button" class="text-error" onclick="confirm_delete_modal.showModal();">
						@icon("trash-2", templ.Attributes{"class": "w-4 h-4"})
						Delete objective
					</button>
				</li>
			</ul>
		</details>
		</div>
	</div>
	<div id="objective-lint">
		@objectiveLintPanel(data.Lint, data.Objective.ID)
	</div>
	<!-- No items-start: the sticky preview needs a column as tall as the form. -->
	<div class="w-full px-6 pb-5 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-8">
		<!-- Wide gaps so expanded zones read as separate. -->
		<div class="flex flex-col gap-50 pb-50 min-w-0">
			<section id="zone-card" data-zone="card" class="flex flex-col gap-1 scroll-mt-4">
				<fieldset class="fieldset w-full">
					<legend class="fieldset-legend">The task &mdash; what the player is asked to do</legend>
					<input
						type="text"
						id="title"
						name="title"
						form="edit-objective"
						class="input input-lg w-full font-semibold"
						value={ data.Objective.Title }
						placeholder="Find the plan chest in the Architecture Library"
						_="on input set #objective-card-title's textContent to my value"
					/>
					<p class="label text-xs">Say what they have to do, not where it is. The place can go in the words.</p>
				</fieldset>
				@objectiveDescription(data)
				@objectiveLinkRow(data)
			</section>
			@deleteBlockModal()
			@objectiveZone(data, blocks.ContextObjectiveProof)
			@objectiveZone(data, blocks.ContextObjectiveReveal)
		</div>
		@objectivePreview(data)
	</div>
	<!-- Hidden form for block reordering via HTMX -->
	@blockReorderForm()
	<dialog id="confirm_delete_modal" class="modal modal-bottom sm:modal-middle">
		<div class="modal-box prose outline-2 outline-offset-1 outline-error">
			<h3 class="text-lg font-bold">Delete this objective?</h3>
			<p class="pt-4">You are about to delete this objective. Are you sure?</p>
			<div class="modal-action">
				<button
					type="button"
					class="btn"
					onclick="confirm_delete_modal.close()"
				>Nevermind</button>
				<button
					type="button"
					class="btn btn-error"
					hx-delete={ fmt.Sprint("/admin/objective/", data.Objective.Slug) }
					hx-trigger="click"
					onclick="confirm_delete_modal.close()"
				>Delete</button>
			</div>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
		</div>
	</dialog>
	@blockMoveScript()
	@sortableStyles()
}



// objectiveVisibilityControl is the eye toggle and the checkbox the form
// actually submits. Factored out so the server can send it back when it
// refuses a change: the button flips optimistically, and a refused park would
// otherwise leave the form describing a state the database rejected, with
// every later autosave resubmitting that same refusal.
templ objectiveVisibilityControl(draft bool) {
	<button
		id="visibility-btn"
		type="button"
		class="btn btn-ghost tooltip"
		data-tip={ visibilityBtnTip(draft) }
		_="on click
			set cb to #published-checkbox
			set cb.checked to not cb.checked
			send change to cb
			if cb.checked
				add .hidden to #visibility-eye-off
				remove .hidden from #visibility-eye
				set #visibility-label's textContent to 'Published'
			else
				add .hidden to #visibility-eye
				remove .hidden from #visibility-eye-off
				set #visibility-label's textContent to 'Draft'
			end"
	>
		<span id="visibility-eye" class={ templ.KV("hidden", draft) }>
			@icon("eye", templ.Attributes{"class": "w-4 h-4"})
		</span>
		<span id="visibility-eye-off" class={ templ.KV("hidden", !draft) }>
			@icon("eye-closed", templ.Attributes{"class": "w-4 h-4 text-warning"})
		</span>
		<span id="visibility-label">
			if draft {
				Draft
			} else {
				Published
			}
		</span>
	</button>
	<input
		type="checkbox"
		id="published-checkbox"
		name="published"
		value="true"
		form="edit-objective"
		class="hidden"
		checked?={ !draft }
	/>
}

// ObjectiveVisibilityOOB puts the stored visibility back on screen after a
// refusal, so the form stops offering a state the database will not take.
templ ObjectiveVisibilityOOB(draft bool) {
	<div id="visibility-control" class="contents" hx-swap-oob="true">
		@objectiveVisibilityControl(draft)
	</div>
}
