package templates

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/internal/config"
	"github.com/nathanhollows/Rapua/v8/internal/services"
)

func priceLabel(cents int) string {
	if cents%100 == 0 {
		return fmt.Sprintf("$%d", cents/100)
	}
	return fmt.Sprintf("$%.2f", float64(cents)/100)
}

templ PricingPage(authed bool) {
	@siteDocument("Pricing", nil) {
		@siteHeader(authed, "/pricing")
		<main id="main" class="relative isolate flex-1">
			<div class="site-ground">
				<svg class="site-topo pricing-topo" data-topo aria-hidden="true"></svg>
				<section class="pt-18 px-5 text-center">
					<h1 class="site-h1">Pay per team.<br/><span class="text-accent">That's it.</span></h1>
					<p class="mt-6 text-[clamp(1.25rem,4vw,1.6rem)] font-black tracking-[-0.02em]">1 credit = 1 team.</p>
					<p class="mt-2 text-lg font-medium text-base-content/78">No tiers. Nothing locked.</p>
				</section>
				<ul class="max-w-[56rem] mx-auto mt-14 px-5 grid gap-9 md:grid-cols-3 md:gap-5">
					@pricingNumber("secondary", -6, "calendar", fmt.Sprint(config.RegularUserFreeCredits()), "free teams a month") {
						For every account.
					}
					@pricingNumber("info", 5, "graduation-cap", fmt.Sprint(config.EducatorFreeCredits()), "free teams a month for educators") {
						Schools, universities, museums, zoos and galleries.
					}
					@pricingNumber("accent", -4, "coins", priceLabel(config.CreditPriceCents()), "per team after that") {
						NZD. Bought credits never expire.
					}
				</ul>
			</div>
			<section class="pt-18 pb-20 px-5">
				<h2 class="site-h2 text-center">Good to know.</h2>
				<div class="max-w-[40rem] mx-auto mt-10 grid gap-2.5">
					@pricingQuestion("What counts as a team?", true) {
						<p>Whoever plays under one game code. However many players share the phone, and however long they play, it's one credit, spent when the first of them starts.</p>
					}
					@pricingQuestion("Do test runs cost a credit?", false) {
						<p>Yes. A test run starts a team like any other, so it uses a credit. Your free ones cover it.</p>
					}
					@pricingQuestion("Do free credits pile up?", false) {
						<p>No. On the first of each month, New Zealand time, you're topped back up to your full allowance.</p>
						<p>Bought credits are different: they stay in your account until you use them, and free ones are always used first.</p>
					}
					@pricingQuestion("How do I get educator credits?", false) {
						<p>Create your account with your work email and Rapua will usually spot that you're at an educational institution. If it doesn't, <a href="/contact">get in touch</a> and I'll sort it.</p>
					}
					@pricingQuestion("Why do educators get more?", false) {
						<p>They do incredible work with very little time or money. And I'm hoping to do a PhD in informal game-based learning, so this is my way of backing the field.</p>
					}
					@pricingQuestion("What if I run out mid-event?", false) {
						<p>Teams that have already started keep playing. New teams can't start until you have credits again: they'll see a friendly message, and you'll get a heads-up when you log in.</p>
					}
					@pricingQuestion("Is there a minimum, or a bulk discount?", false) {
						<p>The minimum purchase is { fmt.Sprint(services.MinCreditsPerPurchase) } credits ({ priceLabel(config.CreditPriceCents() * services.MinCreditsPerPurchase) } NZD), so transaction fees don't eat it. There's no bulk discount: every team is { priceLabel(config.CreditPriceCents()) }, however many you run.</p>
					}
					@pricingQuestion("Where do I see my balance?", false) {
						<p>Your balance is on the <a href="/admin/runs">Runs</a> page, and the full history, free and paid, is under <a href="/admin/settings/credits">Settings, Credits</a>.</p>
					}
				</div>
			</section>
		</main>
		@siteFooter(false)
	}
}

templ pricingNumber(color string, tilt int, iconName, figure, label string) {
	<li class="pricing-num" style={ stickerStyle(color, tilt) }>
		<span class="site-st">
			@icon(iconName, templ.Attributes{"aria-hidden": "true"})
		</span>
		<strong class="block text-[3.25rem] leading-none font-black tracking-[-0.04em] text-[var(--c)]">{ figure }</strong>
		<b class="block mt-2 text-[1.0625rem] font-extrabold">{ label }</b>
		<p class="mt-2 text-[.9375rem] leading-normal text-base-content/72 text-balance">{ children... }</p>
	</li>
}

templ pricingQuestion(question string, open bool) {
	<details class="pricing-q" open?={ open }>
		<summary>{ question }</summary>
		<div>
			{ children... }
		</div>
	</details>
}
