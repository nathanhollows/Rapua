package templates

import (
	"fmt"
	"github.com/nathanhollows/Rapua/v8/internal/flash"
)

templ ResetPassword(token string) {
	<main id="main" class="flex flex-col justify-center flex-1 px-3 lg:px-8">
		<div class="mx-auto w-full max-w-sm">
			<div class="flex flex-col gap-5 outline dark:outline-base-200 rounded-box sm:shadow-2xl p-6 text-center" hx-ext="response-targets">
				<h1 class="text-2xl font-bold">Reset your password</h1>
				<form
					hx-post={ fmt.Sprintf("/reset/%s", token) }
					hx-trigger="submit"
					hx-target="#reset-message"
					class="text-center space-y-3"
				>
					<div id="reset-message"></div>
					<fieldset class="fieldset">
						<legend class="fieldset-legend">New password</legend>
						<input type="password" name="password" class="input" autocomplete="new-password" required minlength="8"/>
					</fieldset>
					<fieldset class="fieldset">
						<legend class="fieldset-legend">Confirm password</legend>
						<input type="password" name="password_confirm" class="input" autocomplete="new-password" required minlength="8"/>
					</fieldset>
					<button class="btn btn-primary w-full">Set new password</button>
				</form>
			</div>
		</div>
	</main>
}

templ ResetPasswordExpired() {
	<main id="main" class="flex flex-col justify-center flex-1 px-3 lg:px-8">
		<div class="mx-auto w-full max-w-sm">
			<div class="flex flex-col gap-5 outline dark:outline-base-200 rounded-box sm:shadow-2xl p-6 text-center">
				<h1 class="text-2xl font-bold">Link expired</h1>
				<p>This password reset link has expired or is invalid.</p>
				<a href="/forgot" class="btn btn-primary w-full">Request a new link</a>
			</div>
		</div>
	</main>
}

templ ResetPasswordSuccess() {
	<main id="main" class="flex flex-col justify-center flex-1 px-3 lg:px-8">
		<div class="mx-auto w-full max-w-sm">
			<div class="flex flex-col gap-5 outline dark:outline-base-200 rounded-box sm:shadow-2xl p-6 text-center">
				<h1 class="text-2xl font-bold">Password reset</h1>
				<p>Your password has been successfully reset.</p>
				<a href="/login" class="btn btn-primary w-full">Log in</a>
			</div>
		</div>
	</main>
}

templ ResetPasswordError(message flash.Message) {
	<div role="alert" class={ fmt.Sprintf("alert alert-%s alert-soft", message.Style) }>
		<div class="flex-1">
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
		</div>
		<div class="flex-1">
			<p>
				{ message.Message }
			</p>
		</div>
	</div>
}
