package templates

templ AboutPage(authed bool) {
	@siteDocument("About", nil) {
		@siteHeader(authed, "/about")
		<main id="main" class="relative isolate flex-1">
			<section class="site-ground py-16">
				<svg class="site-topo" data-topo aria-hidden="true"></svg>
				<div class="site-wrap grid gap-10 items-center justify-items-center md:grid-cols-[1.2fr_1fr] md:justify-items-start md:gap-14">
					<div class="text-center md:text-left">
						<h1 class="site-h1"><span class="contact-gloss" lang="mi" title="Te reo Māori for hello. Literally, be well.">Kia ora</span>! I'm <span class="text-accent">Nathan.</span></h1>
						<p class="mt-5 max-w-[30rem] mx-auto md:mx-0 text-lg font-medium leading-relaxed text-base-content/78 text-pretty">Rapua started in Ōtepoti, Dunedin, and these days I make it in Wellington. It began as a question I couldn't shake: what if the places we walk past every day were the game?</p>
					</div>
					<div class="about-portrait">
						<img src="/static/images/nathan.svg" alt="Portrait of Nathan" class="rotate-y-180 w-full h-full"/>
						<span class="about-tag">Hi there</span>
					</div>
				</div>
			</section>
			<section class="py-18 bg-base-200 border-y-[3px] border-dotted border-base-content/12 [--site-st-edge:var(--color-base-200)]">
				<div class="site-wrap">
					<h2 class="site-h2 text-center">How it got here.</h2>
					<p class="mt-3 max-w-[32rem] mx-auto text-center text-[1.0625rem] text-base-content/75 text-balance">A short walk from dial-up to four university campuses.</p>
					<ol class="about-walk" data-trail>
						@aboutStop("primary", -6, "gamepad-2", "Growing up", "Neopets and RuneScape") {
							Up before my siblings to get the computer, and before Mum needed the phone line. Those games taught me trivia, puzzles and, eventually, programming.
						}
						@aboutStop("info", 5, "graduation-cap", "University of Otago", "Code, then science communication") {
							Computer science first, then a thesis on making place-based learning games that don't cost a fortune to build.
						}
						@aboutStop("accent", -4, "map-pin", "The thesis", "The Amazing Trace") {
							A student orientation game built to show the <a href="https://ourarchive.otago.ac.nz/esploro/outputs/9926546072901891" class="font-bold text-base-content underline">thesis framework</a> working in practice.
						}
						@aboutStop("secondary", 6, "scale", "Faculty of Law", "Te Rapu Hamu") {
							The Faculty of Law wanted students exploring legal ideas across campus. We built it together, and they gave the combined platform its name.
						}
						@aboutStop("warning", -5, "map", "Since then", "Four campuses and counting") {
							Played at Victoria University of Wellington, the University of Otago in Dunedin and Wellington, and the University of Sussex in Brighton.
						}
						@aboutStop("info", 6, "map-pin", "Wellington", "Version 8") {
							I moved north, and the last few versions were made here. v8 is the biggest of them: a rebuild of how Rapua works, from the ground up.
						}
						@aboutStop("primary", 5, "flag", "Next", "A PhD, and more quests") {
							Rapua is a passion project and the base for future research into games that teach a place. It keeps growing either way.
						}
					</ol>
				</div>
			</section>
			<section class="site-ground py-20 text-center">
				<svg class="site-topo" data-topo aria-hidden="true"></svg>
				<div class="site-wrap">
					<h2 class="text-[clamp(3rem,12vw,6rem)] leading-none font-black tracking-[-0.04em] text-accent">Rapua</h2>
					<p class="mt-4 text-[clamp(1.25rem,4vw,1.75rem)] font-extrabold">to seek <span class="text-base-content/45" aria-hidden="true">·</span> to search <span class="text-base-content/45" aria-hidden="true">·</span> to find</p>
					<p class="mt-4 max-w-[32rem] mx-auto text-[1.0625rem] leading-relaxed text-base-content/75 text-balance">Bespoke place-based games are expensive to make, especially for small schools, museums and community groups. Rapua is my go at fixing that.</p>
					<ul class="mt-12 max-w-4xl mx-auto grid gap-8 md:grid-cols-3">
						@aboutWay("accent", -6, "coins", "Back it") {
							Make an account and run quests. Paid credits keep the lights on. <a href="/pricing" class="font-bold text-base-content underline">Pricing</a>
						}
						@aboutWay("info", 5, "code", "Build it") {
							It's all open source. Issues and pull requests are welcome on <a href="https://github.com/nathanhollows/Rapua" class="font-bold text-base-content underline">GitHub</a>.
						}
						@aboutWay("primary", -4, "message-circle", "Tell me about it") {
							I love hearing how people use Rapua, and what they wish it did. <a href="/contact" class="font-bold text-base-content underline">Get in touch</a>
						}
					</ul>
					<p class="mt-14 text-xl font-extrabold">Have fun!<span class="block mt-1 text-base font-semibold text-base-content/75">Nathan</span></p>
				</div>
			</section>
		</main>
		@siteFooter(false)
	}
}

templ aboutStop(color string, tilt int, iconName, label, title string) {
	<li style={ stickerStyle(color, tilt) }>
		<span class="site-st">
			@icon(iconName, templ.Attributes{"aria-hidden": "true"})
		</span>
		<div class="about-say">
			<span class="text-xs font-extrabold tracking-widest uppercase text-[var(--c)]">{ label }</span>
			<h3 class="mt-0.5 text-xl font-black leading-snug">{ title }</h3>
			<p class="mt-1.5 leading-relaxed text-base-content/80 text-pretty">{ children... }</p>
		</div>
	</li>
}

templ aboutWay(color string, tilt int, iconName, title string) {
	<li style={ stickerStyle(color, tilt) }>
		<span class="site-st">
			@icon(iconName, templ.Attributes{"aria-hidden": "true"})
		</span>
		<h3 class="mt-4 text-lg font-black">{ title }</h3>
		<p class="mt-1.5 text-[.9375rem] leading-relaxed text-base-content/78 text-balance">{ children... }</p>
	</li>
}
