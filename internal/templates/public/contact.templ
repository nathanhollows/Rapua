package templates

import "os"

type contactTopic struct {
	Label string
	Color string
	Tilt  int
	Start string
}

var contactTopics = []contactTopic{
	{Label: "Just saying hi", Color: "secondary", Tilt: -2},
	{Label: "Educator credits", Color: "info", Tilt: 2, Start: "I'd like educator credits. I work at "},
	{Label: "A bug", Color: "accent", Tilt: -2, Start: "Something's not working. Here's what happened: "},
	{Label: "An idea", Color: "primary", Tilt: 2, Start: "I've got an idea: "},
}

templ ContactPage(authed bool) {
	@siteDocument("Contact", nil) {
		@siteHeader(authed, "/contact")
		<main id="main" class="relative isolate flex-1">
			<div class="site-ground">
				<svg class="site-topo" data-topo aria-hidden="true"></svg>
				<section class="site-wrap pt-18 pb-20 grid gap-12 items-start md:grid-cols-[1fr_1.1fr] md:gap-16 md:pt-22 md:items-center">
					<div>
						<h1 class="site-h1">Say <span class="text-accent"><span class="contact-gloss" lang="mi" title="Te reo Māori for hello. Literally, be well.">kia ora</span>.</span></h1>
						<p class="mt-5 max-w-[26rem] text-lg font-medium leading-relaxed text-base-content/78 text-pretty">Questions, ideas, bugs, or a quest you'd like a hand with. It all comes straight to me.</p>
						<ul class="mt-9 grid gap-4">
							if os.Getenv("CONTACT_EMAIL") != "" {
								@contactWay("accent", -6, "mail", "mailto:"+os.Getenv("CONTACT_EMAIL"), "Email", os.Getenv("CONTACT_EMAIL"))
							}
							@contactWay("info", 5, "github", "https://github.com/nathanhollows/Rapua", "GitHub", "For developers: issues and code, out in the open.")
							@contactWay("primary", -4, "linkedin", "https://linkedin.com/in/nathanhollows", "LinkedIn", "For the work side of things.")
						</ul>
					</div>
					<div id="contact-card" class="contact-card">
						<form id="contact-form" hx-post="/contact" hx-swap="none">
							<h2 class="text-2xl font-black tracking-[-0.02em]">Send a message</h2>
							<p class="mt-1 text-[.9375rem] text-base-content/68">What's it about?</p>
							<div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Topic" id="contact-topics">
								<!-- Pairs, so a row that runs out of room breaks in the middle first. -->
								for i := 0; i < len(contactTopics); i += 2 {
									<span class="flex flex-wrap gap-2">
										for _, t := range contactTopics[i:min(i+2, len(contactTopics))] {
											<button type="button" class="contact-topic" style={ stickerStyle(t.Color, t.Tilt) } data-start={ t.Start } aria-pressed="false">{ t.Label }</button>
										}
									</span>
								}
							</div>
							<div class="mt-5 grid gap-4">
								<div class="grid gap-4 sm:grid-cols-2">
									<div class="contact-field">
										<label for="contact-name">Your name</label>
										<input id="contact-name" name="name" autocomplete="name" required/>
									</div>
									<div class="contact-field">
										<label for="contact-email">Your email</label>
										<input id="contact-email" name="email" type="email" autocomplete="email" required/>
									</div>
								</div>
								<div class="contact-field">
									<label for="contact-message">Message</label>
									<textarea id="contact-message" name="message" required></textarea>
								</div>
							</div>
							<div class="mt-5 flex justify-end">
								<button class="contact-send" type="submit">
									Send
									@icon("send-horizontal", templ.Attributes{"aria-hidden": "true", "class": "w-[1.15rem] h-[1.15rem]", "stroke-width": "2.6"})
								</button>
							</div>
						</form>
					</div>
				</section>
			</div>
		</main>
		@siteFooter(false)
		@contactTopicScript()
	}
}

templ contactWay(color string, tilt int, iconName, href, title, note string) {
	<li>
		<a href={ templ.SafeURL(href) } class="contact-way" style={ stickerStyle(color, tilt) }>
			<span class="site-st">
				@icon(iconName, templ.Attributes{"aria-hidden": "true"})
			</span>
			<b>{ title }</b>
			<small>{ note }</small>
		</a>
	</li>
}

// Out of band because the form posts with hx-swap="none".
templ ContactSuccess() {
	<div id="contact-card" class="contact-card" hx-swap-oob="true">
		<div class="py-10 text-center" role="status">
			<span class="site-st [--s:4.4rem]" style={ stickerStyle("success", -6) }>
				@icon("check", templ.Attributes{"aria-hidden": "true"})
			</span>
			<h2 class="mt-5 text-2xl font-black tracking-[-0.02em]">Sent!</h2>
			<p class="mt-2 max-w-[22rem] mx-auto leading-relaxed text-base-content/75">Thanks for getting in touch. I'll write back to the email you gave.</p>
		</div>
	</div>
}

templ contactTopicScript() {
	<script>
		// Never overwrite text the person typed themselves.
		(() => {
			const msg = document.getElementById('contact-message');
			const topics = [...document.querySelectorAll('#contact-topics button')];
			let opener = '';
			topics.forEach(b => b.addEventListener('click', () => {
				const on = b.getAttribute('aria-pressed') !== 'true';
				topics.forEach(x => x.setAttribute('aria-pressed', on && x === b));
				if (msg.value === '' || msg.value === opener) {
					opener = on ? b.dataset.start : '';
					msg.value = opener;
				}
				msg.focus();
				msg.setSelectionRange(msg.value.length, msg.value.length);
			}));
		})();
	</script>
}
