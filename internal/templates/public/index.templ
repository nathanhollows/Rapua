package templates

import (
	"github.com/nathanhollows/Rapua/v8/internal/assets"
	"context"
	"fmt"
	"strings"

	"github.com/nathanhollows/Rapua/v8/models"
)

// Asserted to a string so a missing token prints empty, not "<nil>".
func csrfToken(ctx context.Context) string {
	t, _ := ctx.Value("gorilla.csrf.Token").(string)
	return t
}

func codeWord(n int) string {
	words := map[int]string{4: "four", 5: "five", 6: "six", 7: "seven", 8: "eight"}
	if w, ok := words[n]; ok {
		return w
	}
	return fmt.Sprint(n)
}

// The break is display only and is never typed.
func codeSplit(n int) int {
	if n >= 6 {
		return n / 2
	}
	return 0
}

func tileColumns(n int) string {
	if s := codeSplit(n); s > 0 {
		return fmt.Sprintf("grid-template-columns: repeat(%d, 1fr) .9rem repeat(%d, 1fr); max-width: %.2frem", s, n-s, float64(n)*4.25+.9)
	}
	return fmt.Sprintf("grid-template-columns: repeat(%d, 1fr); max-width: %.2frem", n, float64(n)*4.25)
}

func prettyCode(code string) string {
	code = strings.ToUpper(code)
	if s := codeSplit(len(code)); s > 0 {
		return code[:s] + "-" + code[s:]
	}
	return code
}

func resumeHref(run *models.Run) string {
	if run.HasStarted {
		return "/objectives"
	}
	return "/start"
}

func homeState(run *models.Run) string {
	if run != nil {
		return "returning"
	}
	return "new"
}

templ Home(run *models.Run, codeLength int, authed bool) {
	@siteDocument("Play", nil) {
		<a href="#code" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:btn focus:btn-primary">Skip to the game code</a>
		@siteHeader(authed, "/")
		<main id="main" class="home flex-1" data-state={ homeState(run) }>
			@homeHero(run, codeLength)
			@homeQuest()
		</main>
		@siteFooter(true)
		<script src={ assets.URL("/static/js/home.js") }></script>
	}
}

templ homeHero(run *models.Run, codeLength int) {
	<section class="home-hero" id="hero">
		<svg class="home-map" id="map" viewBox="350 -100 1100 920" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
			<g>
				<path class="home-water" id="m-water"></path>
				<path class="home-river" id="m-river"></path>
				<path class="home-coast" id="m-coast"></path>
				<path class="home-street" id="m-street"></path>
				<path class="home-major" id="m-major"></path>
			</g>
			<g class="home-wash">
				<ellipse cx="900" cy="330" rx="390" ry="265"></ellipse>
				<ellipse cx="900" cy="330" rx="330" ry="220"></ellipse>
				<ellipse cx="900" cy="330" rx="270" ry="180"></ellipse>
				<ellipse cx="900" cy="330" rx="215" ry="140"></ellipse>
			</g>
		</svg>
		<svg class="home-trail" id="trail" aria-hidden="true"></svg>
		<div class="home-stickers" id="stickers"></div>
		<div class="home-tip" id="tip" role="tooltip"><strong></strong><span></span></div>
		<div class="site-wrap">
			<div class="relative z-[2] w-full max-w-[25rem] mx-auto">
				if run != nil {
					<article class="home-resume p-5 rounded-[1.25rem] bg-base-200" aria-labelledby="resume-title">
						<span class="home-kicker text-xs font-bold uppercase tracking-[.08em] text-primary">You're mid-quest</span>
						<h1 id="resume-title" class="mt-1.5 text-2xl leading-tight font-extrabold tracking-[-0.02em]">{ run.Quest.Name }</h1>
						<p class="mt-1 text-[.9375rem] text-base-content/70">
							if run.Name != "" {
								Playing as { run.Name }, game code
							} else {
								Your game code is
							}
							<b class="font-mono tracking-[.08em] text-base-content">{ prettyCode(run.Code) }</b>
						</p>
						<p class="mt-2.5 text-sm text-base-content/70">Your progress is saved on this phone.</p>
						<a href={ templ.SafeURL(resumeHref(run)) } class="home-btn mt-[1.1rem]">
							Carry on
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
						</a>
						if run.HasStarted {
							<a href="/journal" class="block mt-3 text-center text-[.9375rem] font-bold">Read your journal</a>
						}
					</article>
					<p class="home-or mt-9 flex items-center gap-[.8rem] text-sm font-bold text-base-content/75">Joining a different quest?</p>
				} else {
					<h1 class="text-center font-black leading-none tracking-[-0.035em] text-balance text-[clamp(2.6rem,10vw,4rem)]">Your quest starts <span class="text-primary">here.</span></h1>
					<p class="mt-[1.1rem] text-center text-[1.0625rem] font-medium text-base-content/72 text-balance">Type the { codeWord(codeLength) }-letter game code your facilitator gave you.</p>
				}
				<form class="home-form" id="join" action="/play" method="post" novalidate data-length={ fmt.Sprint(codeLength) }>
					<input type="hidden" name="csrf" value={ csrfToken(ctx) }/>
					<div class="home-tiles" id="tiles" style={ templ.SafeCSS(tileColumns(codeLength)) }>
						for i := 0; i < codeLength; i++ {
							if i > 0 && i == codeSplit(codeLength) {
								<div class="home-dash" aria-hidden="true"></div>
							}
							<div class="home-tile" aria-hidden="true"><span></span></div>
						}
						<input
							class="home-input"
							id="code"
							name="run"
							type="text"
							maxlength={ fmt.Sprint(codeLength + 1) }
							inputmode="text"
							autocapitalize="characters"
							autocomplete="off"
							autocorrect="off"
							spellcheck="false"
							enterkeyhint="go"
							aria-label={ fmt.Sprintf("Game code, %s letters", codeWord(codeLength)) }
							aria-describedby="err"
						/>
					</div>
					<p class="mt-3 min-h-[1.4rem] whitespace-nowrap text-center text-[.9375rem] font-semibold text-error" id="err" role="alert"></p>
					<button class="home-btn" id="go" type="submit" aria-disabled="true">Start playing</button>
					<p class="sr-only" id="code-status" role="status"></p>
				</form>
			</div>
		</div>
	</section>
}

templ homeQuest() {
	<section class="home-below" id="below">
		<svg class="home-trail" id="trail2" aria-hidden="true"></svg>
		<div class="site-wrap">
			<div class="max-w-[34rem] mx-auto text-center">
				<h2 class="site-h2">Rapua puts quests in the real world.</h2>
				<p class="mt-4 text-[.8125rem] font-extrabold uppercase tracking-[.08em] text-base-content/75">Example quest</p>
			</div>
			<ol class="home-quest" aria-label="An example quest">
				@homeNode("a", "qr", "primary", -6, "Track down the grumpy statue", "Scan the code on his boot.", "He's been keeping a secret for 120 years.")
				@homeNode("b", "quiz", "accent", 5, "What's he glaring at?", "Name it. Not the café.", "Half a map.")
				@homeNode("c", "camera", "secondary", -4, "Find his missing hat", "Photograph it. Yes, really.", "The other half.")
				@homeNode("d", "keypad", "secondary", 6, "Crack his time capsule", "Put the map together.", "Why he's so grumpy.")
			</ol>
			<div class="max-w-[52rem] mx-auto mt-20 pt-10 grid gap-8 sm:grid-cols-2 sm:gap-14 border-t-[3px] border-dotted border-base-content/12 text-center sm:text-left">
				<div>
					<h3 class="text-xl font-black">Want to play?</h3>
					<p class="mt-1.5 max-w-[30rem] mx-auto sm:mx-0 text-[.9375rem] leading-relaxed text-base-content/80">All you need is a game code. Nothing to install, one phone per team. No code? Your facilitator has one.</p>
					<a href="#hero" class="home-endbtn" style="--c: var(--color-primary); --cc: var(--color-primary-content)">
						Enter your game code
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
					</a>
				</div>
				<div>
					<h3 class="text-xl font-black">Want to run a quest?</h3>
					<p class="mt-1.5 max-w-[30rem] mx-auto sm:mx-0 text-[.9375rem] leading-relaxed text-base-content/80">Build quests like this for your museum, class or campus. Open source, every feature included, and free credits every month.</p>
					<a href="/creators" class="home-endbtn" style="--c: var(--color-accent); --cc: var(--color-accent-content)">
						See how it works
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
					</a>
				</div>
			</div>
		</div>
	</section>
}

templ homeNode(id, ic, color string, tilt int, title, proof, uncover string) {
	<li class="home-node" data-node={ id }>
		<span class="home-mark" data-ic={ ic } style={ stickerStyle(color, tilt) }></span>
		<h3 class="text-lg font-extrabold leading-tight text-balance">{ title }</h3>
		<p class="mt-1 text-[.9375rem] leading-snug text-base-content/80 text-balance">{ proof }</p>
		<p class="home-reveal mt-3 pt-3 text-[.9375rem] leading-snug text-base-content/80 text-balance"><b class="block mb-0.5 text-[.6875rem] font-extrabold uppercase tracking-[.08em] text-primary">Uncover</b>{ uncover }</p>
	</li>
}
