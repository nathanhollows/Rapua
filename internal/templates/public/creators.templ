package templates

import (
	"github.com/nathanhollows/Rapua/v8/internal/assets"
)

// Off because the editor has no undo to back the card.
const showEditHistory = false

templ CreatorsPage(authed bool) {
	@siteDocument("For creators", nil) {
		@siteHeader(authed, "/creators")
		<main id="main" class="cr relative isolate flex-1">
			<div class="site-ground">
				<svg class="site-topo" data-topo aria-hidden="true"></svg>
				<section class="cr-hero site-wrap">
					<h1 class="site-h1 mx-auto max-w-[42rem]">Turn your place into a <span class="text-accent">quest.</span></h1>
					<p class="cr-lede">Write the challenges, choose how players move between them, and lock the good bits behind what they've done.</p>
					<div class="cr-ctas">
						@creatorsStart()
					</div>
				</section>
				<section class="campus site-wrap">
					<p class="kick">Already played at</p>
					<ul class="pins">
						<li><span class="st" data-ic="pin" data-r="ordered" style="--r:5deg"></span><span><b>Victoria University</b><small>of Wellington</small></span></li>
						<li><span class="st" data-ic="pin" data-r="free_roam" style="--r:-4deg"></span><span><b>University of Otago</b><small>Dunedin</small></span></li>
						<li><span class="st" data-ic="pin" data-r="randomised" style="--r:6deg"></span><span><b>University of Otago</b><small>Wellington campus</small></span></li>
						<li><span class="st" data-ic="pin" data-r="story" style="--r:-5deg"></span><span><b>University of Sussex</b><small>Brighton</small></span></li>
					</ul>
				</section>
			</div>
			<section class="kit" id="kit">
				<div class="site-wrap">
					<div class="sec-h">
						<h2 class="site-h2">Go beyond a scavenger hunt.</h2>
						<p>Every part of a quest picks its own rules, and they combine. Here's each one on its own, and what you might use it for.</p>
					</div>
					<div class="tabs" role="tablist" aria-label="Quest rules" id="tabs"></div>
					<div class="panel" id="panel" role="tabpanel" tabindex="0">
						<div class="about" id="about"></div>
						<div class="stage-col">
							<div class="stage" id="stage" aria-hidden="true"></div>
						</div>
					</div>
				</div>
			</section>
			<section class="build">
				<svg class="streets" viewBox="350 -100 1100 920" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path class="s-water" id="s-water"></path><path class="s-river" id="s-river"></path><path class="s-coast" id="s-coast"></path><path class="s-street" id="s-street"></path><path class="s-major" id="s-major"></path></svg>
				<div class="site-wrap">
					<div class="sec-h">
						<h2 class="site-h2">Build each stop from blocks.</h2>
						<p>Pick what players read and what they have to do, in any order. A block that proves something can hand out a key, and any block can wait for one.</p>
					</div>
					<div class="builder">
						<div class="palette">
							<div class="bgroup" data-r="ordered">
								<h3>To prove it</h3>
								<ul class="chips" id="prove"></ul>
							</div>
							<div class="bgroup" data-r="story">
								<h3>To tell the story</h3>
								<ul class="chips" id="tell"></ul>
							</div>
						</div>
						<div class="stopcol">
						<div class="stopcard" aria-hidden="true">
							<div class="sc-head"><span class="sic" data-r="ordered" data-ic="qr" style="--r:-6deg"></span><span><b>The grumpy statue</b><small>Guided path · stop 1 of 5</small></span></div>
							<ol class="stack" id="stack"></ol>
						</div>
						</div>
					</div>
				</div>
			</section>
			<section class="kit">
				<div class="site-wrap">
					<div class="sec-h">
						<h2 class="site-h2">See how it went.</h2>
						if showEditHistory {
							<p>Every team leaves a trail, and every edit you make is kept.</p>
						} else {
							<p>Every team leaves a trail.</p>
						}
					</div>
					<div class={ "cards", templ.KV("cards-one", !showEditHistory) }>
						<div class="wcol">
							<h3>See where players get stuck</h3>
							<p>Each team gets a timeline: what they opened, what they answered, the photos they took, and where they stalled. Players get a journal of their day too.</p>
							<div class="shot" aria-hidden="true">
								<div class="tl-head">The Otters</div>
								<div class="strip"><i data-c="play" style="--w:16"></i><i data-c="idle" style="--w:7"></i><i data-c="play" style="--w:13"></i><i data-c="stall" style="--w:20"></i><i data-c="play" style="--w:26"></i></div>
								<ol class="rows">
									<li class="row"><span class="sic" data-r="free_roam" data-ic="flag" style="--r:-5deg"></span><span>Finished the quest</span><time>2:41 PM</time></li>
									<li class="row"><span class="sic" data-r="ordered" data-ic="camera" style="--r:4deg"></span><span>Photo for <b>Find his missing hat</b></span><time>2:33 PM</time></li>
									<li class="quiet">Stalled for 28m</li>
									<li class="row"><span class="sic" data-r="ordered" data-ic="quiz" style="--r:-4deg"></span><span>Answered <b>What's he glaring at?</b></span><time>1:58 PM</time></li>
									<li class="row"><span class="sic" data-r="ordered" data-ic="qr" style="--r:5deg"></span><span>Scanned <b>Track down the grumpy statue</b></span><time>1:52 PM</time></li>
								</ol>
							</div>
						</div>
						if showEditHistory {
						<div class="wcol">
							<h3>Undo any edit</h3>
							<p>Every change to a quest is kept. Undo one from an hour ago and everything you've done since stays put. Changed your mind again? Undo the undo.</p>
							<div class="shot" aria-hidden="true">
								<div class="tl-head">History</div>
								<ol class="hist" id="hist">
									<li><span class="what">Renamed <b>Lions at the library</b></span><time>Just now</time></li>
									<li><span class="what">Moved <b>The fossil drawer</b> into Gallery</span><time>4 min ago</time></li>
									<li data-target><span class="what">Changed the quiz answer on <b>The gargoyle</b></span><time>11 min ago</time><span class="undo">Undo</span></li>
									<li><span class="what">Added <b>The old pier</b></span><time>26 min ago</time></li>
								</ol>
							</div>
						</div>
						}
					</div>
				</div>
			</section>
			<section class="cr-end">
				<div class="site-wrap">
					<span class="st" data-ic="flag" data-r="randomised" style="--r:-6deg;--s:4.2rem"></span>
					<h2 class="site-h2">Build yours.</h2>
					<p>Free to start, with every feature in every account, and all of it <a href="https://github.com/nathanhollows/Rapua">open source</a>. <a href="/pricing">See pricing</a>.</p>
					@creatorsStart()
				</div>
			</section>
		</main>
		@siteFooter(true)
		<script src={ assets.URL("/static/js/creators.js") }></script>
	}
}

templ creatorsStart() {
	<a href="/register" class="cr-btn">
		Start building
		@icon("arrow-right", templ.Attributes{"aria-hidden": "true", "stroke-width": "2.8"})
	</a>
}
