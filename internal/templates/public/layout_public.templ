package templates

import "os"

templ PublicLayout(contents templ.Component, title string, authed bool) {
	@publicPage(contents, title, authed, false)
}

templ DocsLayout(contents templ.Component, title string, authed bool) {
	@publicPage(contents, title, authed, true)
}

templ publicPage(contents templ.Component, title string, authed, docs bool) {
	@siteDocument(title, publicHeadExtras()) {
		@publicNav(authed, docs)
		@contents
		@publicFooter()
	}
}

// Only the older pages need these; the redesigned ones ship their own script.
templ publicHeadExtras() {
	<link href="https://api.mapbox.com/mapbox-gl-js/v2.10.0/mapbox-gl.css" rel="stylesheet"/>
	<span id="mapbox_key" class="hidden" data-key={ os.Getenv("MAPBOX_KEY") }></span>
	<script src="https://api.mapbox.com/mapbox-gl-js/v2.10.0/mapbox-gl.js"></script>
	<script src="/static/js/htmx-response-targets.js"></script>
	<script src="https://unpkg.com/hyperscript.org@0.9.13"></script>
	<script src="/static/js/mapbox-satellite-view.js"></script>
}

// Inline so the theme is set before first paint.
templ themeScript() {
	<script>
		(function() {
			const theme = localStorage.getItem('theme') || 'system';
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

			if (theme === 'system') {
				document.documentElement.setAttribute('data-theme', prefersDark ? 'dracula' : 'cupcake');
			} else {
				document.documentElement.setAttribute('data-theme', theme);
			}

			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
				const currentTheme = localStorage.getItem('theme');
				if (!currentTheme || currentTheme === 'system') {
					document.documentElement.setAttribute('data-theme', e.matches ? 'dracula' : 'cupcake');
				}
			});
		})();
	</script>
}

// Links are not boosted: a boosted swap into a redesigned page would keep the
// old body and skip the new page's scripts.
templ publicFooter() {
	@siteFooter(false)
}

templ publicNav(authed, docs bool) {
	if docs {
		@siteHeader(authed, "/docs") {
			<label for="my-drawer" class="btn btn-ghost btn-sm btn-square drawer-button lg:hidden" aria-label="Menu">
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"></path></svg>
			</label>
		}
	} else {
		@siteHeader(authed, "")
	}
}
